{
  "name": "hulla",
  "version": "0.0.0",
  "private": true,
  "description": "Hulla: rules engines, protocol, server runtime, web client and tooling",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "lint": "pnpm typecheck && eslint . --max-warnings 0 && prettier --check . && pnpm depcruise",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages tools server",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest",
    "vectors": "pnpm -r --if-present run vectors",
    "codegen": "pnpm -r --if-present run codegen",
    "content:validate": "pnpm -r --if-present run content:validate",
    "content:manifest": "pnpm -r --if-present run content:manifest",
    "equivalence": "pnpm -r --if-present run equivalence",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "prettier": "^3.9.10",
    "quicktype-core": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
