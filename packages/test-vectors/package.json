{
  "name": "@hulla/test-vectors",
  "version": "0.1.0",
  "private": true,
  "description": "Shared rules test vectors every engine must pass, their schema, the TypeScript runner and the traceability matrix",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "types": "./runner-ts/index.ts",
  "exports": {
    ".": "./runner-ts/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "vectors": "vitest run && tsx scripts/traceability.ts --check",
    "traceability": "tsx scripts/traceability.ts"
  },
  "dependencies": {
    "@hulla/rules-engine": "workspace:*",
    "@hulla/shared-ts": "workspace:*"
  }
}
