{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/protocol/shell/chat.json",
  "title": "Quick chat and emotes as match data; text chat rides Nakama channels (ADR-0018)",
  "definitions": {
    "chat_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 140 } }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "text"],
      "properties": {
        "seat": { "$ref": "../common.json#/definitions/seatIndexOrNull" },
        "text": { "type": "string", "maxLength": 140 },
        "filtered": { "type": "boolean" }
      }
    },
    "quick_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phraseId"],
      "properties": {
        "phraseId": { "type": "string", "pattern": "^[A-Z][0-9]{2}$" },
        "pack": { "type": "string" }
      }
    },
    "quick_chat_sent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "phraseId"],
      "properties": {
        "seat": { "$ref": "../common.json#/definitions/seatIndex" },
        "phraseId": { "type": "string" },
        "pack": { "type": "string" }
      }
    },
    "emote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emoteId"],
      "properties": {
        "emoteId": { "type": "string", "minLength": 1, "maxLength": 32 },
        "targetSeat": { "$ref": "../common.json#/definitions/seatIndex" }
      }
    },
    "emote_sent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "emoteId"],
      "properties": {
        "seat": { "$ref": "../common.json#/definitions/seatIndex" },
        "emoteId": { "type": "string" },
        "targetSeat": { "$ref": "../common.json#/definitions/seatIndex" }
      }
    }
  }
}
