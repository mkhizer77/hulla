{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/protocol/shell/table.json",
  "title": "Table lifecycle messages",
  "definitions": {
    "tableStatus": {
      "type": "string",
      "enum": ["open", "locked", "inRound", "closed"]
    },
    "tableMode": {
      "type": "string",
      "enum": ["private", "public", "ranked"]
    },
    "rulesSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameId"],
      "properties": {
        "gameId": {
          "$ref": "../common.json#/definitions/gameId"
        },
        "preset": {
          "type": "string",
          "enum": ["standard", "family", "hardcore", "classicPagat"]
        },
        "overrides": {
          "type": "object",
          "description": "Validated against the game's rules schema"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "description": "Table settings that are not engine rules (GDD 6.13)",
          "properties": {
            "turnTimerSeconds": {
              "type": ["integer", "null"],
              "enum": [10, 15, 20, 30, 60, null]
            },
            "showCardCounts": {
              "type": "boolean"
            },
            "cardMemoryAssist": {
              "type": "boolean"
            },
            "loserTitle": {
              "type": "string",
              "enum": ["bhabhi", "donkey", "thullad"]
            },
            "spectators": {
              "type": "boolean"
            },
            "voiceDefault": {
              "type": "string",
              "enum": ["openMic", "pushToTalk", "off"]
            },
            "direction": {
              "type": "string",
              "enum": ["cw", "ccw"]
            }
          }
        }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "playerId", "displayName", "ready", "connected", "autoPlay"],
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        },
        "playerId": {
          "oneOf": [
            {
              "$ref": "../common.json#/definitions/playerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "type": ["string", "null"]
        },
        "ready": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "autoPlay": {
          "type": "boolean",
          "description": "The auto-play policy holds this seat (R45, R46)"
        },
        "bot": {
          "type": "boolean"
        },
        "party": {
          "type": ["string", "null"],
          "description": "Players who queued together share a party id (GDD 7.2); shown as a link icon"
        }
      }
    },
    "spectator": {
      "type": "object",
      "additionalProperties": false,
      "description": "A friend watching the table; seatNext when they take a seat at the next round",
      "required": ["userId", "displayName", "seatNext"],
      "properties": {
        "userId": {
          "$ref": "../common.json#/definitions/playerId"
        },
        "displayName": {
          "type": ["string", "null"]
        },
        "seatNext": {
          "type": "boolean"
        }
      }
    },
    "join_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "../common.json#/definitions/roomCode"
        },
        "resumeToken": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "asSpectator": {
          "type": "boolean"
        },
        "clientVersion": {
          "type": "string"
        }
      }
    },
    "leave_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": {
        "ready": {
          "type": "boolean"
        }
      }
    },
    "set_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "$ref": "#/definitions/rulesSelection"
        }
      }
    },
    "add_bot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reserved for the optional bot milestone (D7)",
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        },
        "tier": {
          "type": "string",
          "enum": ["learner", "regular", "ustad"]
        }
      }
    },
    "remove_bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat"],
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        }
      }
    },
    "kick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat"],
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        }
      }
    },
    "transfer_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat"],
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        }
      }
    },
    "seat_spectator": {
      "type": "object",
      "additionalProperties": false,
      "description": "Host only: seats a spectator now, or for the next round while one is in progress (GDD 9.10)",
      "required": ["userId"],
      "properties": {
        "userId": {
          "$ref": "../common.json#/definitions/playerId"
        }
      }
    },
    "start_round": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "vote_rematch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yes"],
      "properties": {
        "yes": {
          "type": "boolean"
        }
      }
    },
    "request_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sinceSeq"],
      "properties": {
        "sinceSeq": {
          "$ref": "../common.json#/definitions/sequence"
        }
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentTs"],
      "properties": {
        "sentTs": {
          "$ref": "../common.json#/definitions/timestamp"
        }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentTs", "serverTs"],
      "properties": {
        "sentTs": {
          "$ref": "../common.json#/definitions/timestamp"
        },
        "serverTs": {
          "$ref": "../common.json#/definitions/timestamp"
        }
      }
    },
    "table_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "The full table as the recipient may see it; the round view is redacted per recipient",
      "required": [
        "code",
        "gameId",
        "mode",
        "status",
        "hostSeat",
        "rules",
        "seats",
        "spectatorCount",
        "spectators",
        "series",
        "round",
        "lastSeq",
        "resumeToken"
      ],
      "properties": {
        "code": {
          "$ref": "../common.json#/definitions/roomCode"
        },
        "gameId": {
          "$ref": "../common.json#/definitions/gameId"
        },
        "mode": {
          "$ref": "#/definitions/tableMode"
        },
        "status": {
          "$ref": "#/definitions/tableStatus"
        },
        "hostSeat": {
          "$ref": "../common.json#/definitions/seatIndexOrNull"
        },
        "rules": {
          "$ref": "#/definitions/rulesSelection"
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/seat"
          }
        },
        "spectatorCount": {
          "type": "integer",
          "minimum": 0
        },
        "spectators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/spectator"
          }
        },
        "series": {
          "$ref": "../common.json#/definitions/seriesState"
        },
        "round": {
          "oneOf": [
            {
              "$ref": "../games/thulla/views.json#/definitions/view"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastSeq": {
          "$ref": "../common.json#/definitions/sequence"
        },
        "resumeToken": {
          "type": ["string", "null"]
        },
        "rematch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deadlineTs": {
              "$ref": "../common.json#/definitions/timestamp"
            },
            "votes": {
              "$ref": "../common.json#/definitions/seatList"
            }
          }
        },
        "autoStart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startsAtTs"],
          "description": "A public table counting down to its first deal (GDD 9.5)",
          "properties": {
            "startsAtTs": {
              "$ref": "../common.json#/definitions/timestamp"
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "A table_state plus the events after sinceSeq, each a full envelope (ARCHITECTURE 8.6)",
      "required": ["state", "events"],
      "properties": {
        "state": {
          "$ref": "#/definitions/table_state"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "../envelope.json"
          }
        }
      }
    },
    "rules_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "changedBy"],
      "properties": {
        "rules": {
          "$ref": "#/definitions/rulesSelection"
        },
        "changedBy": {
          "$ref": "../common.json#/definitions/seatIndex"
        },
        "changedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For the diff banner (E19)"
        }
      }
    },
    "host_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat"],
      "properties": {
        "seat": {
          "$ref": "../common.json#/definitions/seatIndex"
        },
        "reason": {
          "type": "string",
          "enum": ["transfer", "host_left"]
        }
      }
    },
    "table_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["host_closed", "empty", "dissolved", "server"]
        }
      }
    }
  }
}
