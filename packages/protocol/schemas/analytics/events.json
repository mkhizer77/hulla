{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/analytics/events.json",
  "title": "Analytics events (GDD 23.3, docs/design/analytics-events.md)",
  "description": "Every analytics event and its parameters. Pseudonymous: no names, chat or voice content, hands or card lists (GDD 23.6, ARCHITECTURE 12.4). Codegen emits the C# builders and the TypeScript types from this file. An event marked x-high-volume happens many times a round: it goes to Firebase and the server log but not to Amplitude, which gets the round's totals on round_end instead.",
  "definitions": {
    "app_open": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cold": {
          "type": "boolean"
        },
        "deep_link_type": {
          "type": "string",
          "enum": ["none", "invite", "referral"]
        }
      },
      "required": ["cold"]
    },
    "ftue_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": ["clean", "hinted", "coached", "skipped"]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["step", "outcome", "duration"]
    },
    "table_create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["private", "public", "ranked"]
        },
        "preset": {
          "type": "string"
        },
        "seats": {
          "type": "integer",
          "minimum": 3
        },
        "voice_mode": {
          "type": "string",
          "enum": ["openMic", "pushToTalk", "off"]
        }
      },
      "required": ["mode"]
    },
    "invite_sent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "in_app", "copy", "qr", "share"]
        }
      },
      "required": ["channel"]
    },
    "invite_opened": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "invite_seated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "match_search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seats": {
          "type": "integer",
          "minimum": 3
        },
        "wait_time": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": ["humans", "backfilled", "abandoned"]
        }
      },
      "required": ["seats", "wait_time", "outcome"]
    },
    "round_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["private", "public", "ranked"]
        },
        "seats": {
          "type": "integer",
          "minimum": 2
        },
        "humans": {
          "type": "integer",
          "minimum": 0
        },
        "bots": {
          "type": "integer",
          "minimum": 0
        },
        "preset_hash": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "friends": {
          "type": "integer",
          "minimum": 0
        },
        "rematch": {
          "type": "boolean"
        }
      },
      "required": ["mode", "seats"]
    },
    "move_played": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "legal_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_ms": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "boolean"
        },
        "auto": {
          "type": "boolean"
        }
      },
      "required": ["legal_count", "decision_ms"]
    },
    "thulla": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "pile_size": {
          "type": "integer",
          "minimum": 0
        },
        "giver": {
          "type": "integer",
          "minimum": 0
        },
        "picker": {
          "type": "integer",
          "minimum": 0
        },
        "trick_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["pile_size"]
    },
    "pickup": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "cards": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["cards"]
    },
    "hand_taken": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "cards": {
          "type": "integer",
          "minimum": 0
        },
        "players_active": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["cards"]
    },
    "empty_hand_draw": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["discard", "next_player", "opponent"]
        }
      },
      "required": ["source"]
    },
    "endgame_draw": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["discard", "next_player", "opponent"]
        }
      },
      "required": ["source"]
    },
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "cards_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "fast_forwarded": {
          "type": "boolean"
        }
      }
    },
    "escape": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "trick_index": {
          "type": "integer",
          "minimum": 0
        },
        "cards_picked_total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["rank"]
    },
    "round_end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "bhabhi_cards": {
          "type": "integer",
          "minimum": 0
        },
        "rematch_vote": {
          "type": "boolean"
        },
        "seats": {
          "type": "integer",
          "minimum": 2
        },
        "humans": {
          "type": "integer",
          "minimum": 0
        },
        "bots": {
          "type": "integer",
          "minimum": 0
        },
        "friends": {
          "type": "integer",
          "minimum": 0
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "lost": {
          "type": "boolean"
        },
        "court": {
          "type": "boolean"
        },
        "moves": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "thullas_given": {
          "type": "integer",
          "minimum": 0
        },
        "thullas_taken": {
          "type": "integer",
          "minimum": 0
        },
        "cards_picked": {
          "type": "integer",
          "minimum": 0
        },
        "chats": {
          "type": "integer",
          "minimum": 0
        },
        "voice": {
          "type": "boolean"
        }
      },
      "required": ["duration"]
    },
    "quick_chat": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "pack": {
          "type": "string"
        },
        "phrase_id": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "target": {
          "type": "boolean"
        }
      },
      "required": ["phrase_id"]
    },
    "emote": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "pack": {
          "type": "string"
        },
        "phrase_id": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "target": {
          "type": "boolean"
        }
      },
      "required": ["phrase_id"]
    },
    "chat_text": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "context": {
          "type": "string"
        }
      }
    },
    "voice_join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["openMic", "pushToTalk"]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "voice_speak": {
      "type": "object",
      "additionalProperties": false,
      "x-high-volume": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["openMic", "pushToTalk"]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "friend_add": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["code", "recent", "results", "request", "qr", "referral", "contacts", "facebook"]
        }
      },
      "required": ["source"]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["table", "friends", "results"]
        }
      },
      "required": ["source"]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": ["table", "friends", "results"]
        },
        "reason": {
          "type": "string",
          "enum": [
            "cheating",
            "abusive_text",
            "abusive_voice",
            "inappropriate_profile",
            "spam",
            "underage"
          ]
        }
      },
      "required": ["source", "reason"]
    },
    "mission_complete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "pass_tier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "premium": {
          "type": "boolean"
        }
      },
      "required": ["id"]
    },
    "shop_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string"
        },
        "placement": {
          "type": "string"
        }
      }
    },
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "placement": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "enum": ["coins", "gems", "store"]
        }
      },
      "required": ["item"]
    },
    "ad_impression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": {
          "type": "string"
        }
      },
      "required": ["placement"]
    },
    "ad_reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": {
          "type": "string"
        }
      },
      "required": ["placement"]
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": ["rejoined", "gave_up"]
        }
      },
      "required": ["outcome"]
    },
    "disconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": ["dropped", "left"]
        }
      },
      "required": ["outcome"]
    },
    "perf_sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps_avg": {
          "type": "number",
          "minimum": 0
        },
        "mem_mb": {
          "type": "number",
          "minimum": 0
        },
        "device_tier": {
          "type": "string",
          "enum": ["low", "mid", "high"]
        }
      },
      "required": ["fps_avg"]
    },
    "screen_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screen": {
          "type": "string"
        },
        "overlay": {
          "type": "boolean"
        }
      },
      "required": ["screen"]
    },
    "sign_in": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["device", "google", "facebook", "apple", "phone"]
        }
      },
      "required": ["method"]
    },
    "account_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["google", "facebook", "apple", "phone"]
        },
        "outcome": {
          "type": "string",
          "enum": ["linked", "switched", "in_use", "failed"]
        }
      },
      "required": ["provider", "outcome"]
    },
    "table_join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": {
          "type": "string",
          "enum": ["create", "code", "link", "friend", "quick_play", "ranked", "rejoin", "watch"]
        },
        "mode": {
          "type": "string",
          "enum": ["private", "public", "ranked"]
        },
        "spectator": {
          "type": "boolean"
        }
      },
      "required": ["via"]
    },
    "table_leave": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["lobby", "round", "between_rounds"]
        },
        "reason": {
          "type": "string",
          "enum": ["left", "removed", "closed"]
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["phase", "reason"]
    },
    "share_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ratio": {
          "type": "string",
          "enum": ["feed", "story"]
        },
        "sheet": {
          "type": "boolean"
        }
      },
      "required": ["ratio"]
    },
    "daily_reward_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "gems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["day"]
    },
    "level_up": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["level"]
    },
    "achievement_unlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "iap_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": "string"
        }
      },
      "required": ["product"]
    },
    "iap_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": ["granted", "cancelled", "failed"]
        },
        "code": {
          "type": "string"
        }
      },
      "required": ["product", "outcome"]
    },
    "ad_watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placement": {
          "type": "string"
        },
        "rewarded": {
          "type": "boolean"
        }
      },
      "required": ["placement", "rewarded"]
    },
    "error_shown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "screen": {
          "type": "string"
        }
      },
      "required": ["code"]
    },
    "push_prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": "string",
          "enum": ["yes", "no"]
        }
      },
      "required": ["answer"]
    },
    "push_open": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string",
          "enum": ["lobby", "friends", "pass", "home"]
        }
      },
      "required": ["route"]
    }
  }
}
