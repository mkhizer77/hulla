{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/protocol/common.json",
  "title": "Shared definitions",
  "definitions": {
    "card": {
      "type": "string",
      "pattern": "^[2-9TJQKA][SHCD]$",
      "description": "Rank then suit: AS, TH, 2C"
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/card"
      }
    },
    "suit": {
      "type": "string",
      "enum": ["S", "H", "C", "D"]
    },
    "seatIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "seatIndexOrNull": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 7
    },
    "seatList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/seatIndex"
      }
    },
    "tableId": {
      "type": "string",
      "pattern": "^t_[A-Z2-9]{6}$"
    },
    "roundId": {
      "type": "string",
      "pattern": "^r_[0-9]+$"
    },
    "playerId": {
      "type": "string",
      "description": "Server-issued; no length constraint because nullable constrained strings crash quicktype's generated converter"
    },
    "roomCode": {
      "type": "string",
      "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$"
    },
    "gameId": {
      "type": "string",
      "enum": ["thulla", "rung"]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix milliseconds from the server clock"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "errorCode": {
      "type": "string",
      "pattern": "^(rules|table|auth|economy|content|network|voice)\\.[a-z0-9_]+$"
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "handCounts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Per seat, in seat order"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Per seat, in seat order"
    },
    "seatStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thullasGiven", "thullasReceived", "cardsPickedUp", "handsTaken"],
      "properties": {
        "thullasGiven": {
          "type": "integer",
          "minimum": 0
        },
        "thullasReceived": {
          "type": "integer",
          "minimum": 0
        },
        "cardsPickedUp": {
          "type": "integer",
          "minimum": 0
        },
        "handsTaken": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "seriesState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundsPlayed", "points", "loserTally", "nextDealerSeat", "finished"],
      "properties": {
        "roundsPlayed": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "$ref": "#/definitions/points"
        },
        "loserTally": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "nextDealerSeat": {
          "$ref": "#/definitions/seatIndex"
        },
        "finished": {
          "type": "boolean"
        }
      }
    }
  }
}
