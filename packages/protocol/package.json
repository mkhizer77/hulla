{
  "name": "@hulla/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "The wire protocol: JSON Schema draft-07 source of truth for every message, with generated TypeScript and C#",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./generated/ts/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "codegen:check": "git diff --exit-code -- generated"
  },
  "devDependencies": {
    "@hulla/rules-engine": "workspace:*",
    "@hulla/shared-ts": "workspace:*"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "zod": "^4.6.5"
  }
}
