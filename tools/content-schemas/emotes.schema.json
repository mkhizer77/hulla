{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/emotes.json",
  "title": "An emote pack: the animated stickers a table may send (GDD 11.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "emotes"],
  "properties": {
    "schema": { "type": "string", "pattern": "emotes\\.schema\\.json$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "emotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
          "name": {
            "type": "string",
            "pattern": "^emote\\.[a-z0-9_]+$",
            "description": "A string id"
          },
          "throwable": { "type": "boolean", "description": "May be thrown at a seat" }
        }
      }
    }
  }
}
