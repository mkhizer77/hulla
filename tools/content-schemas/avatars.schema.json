{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/avatars.json",
  "title": "Preset avatars and frames a profile may pick (GDD 10.1); unlockables join through the catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "avatars", "frames"],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "avatars\\.schema\\.json$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "avatars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "name": {
            "type": "string",
            "pattern": "^avatar\\.[a-z0-9_]+$"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "name": {
            "type": "string",
            "pattern": "^frame\\.[a-z0-9_]+$"
          },
          "earnOnly": {
            "description": "Granted by a reward or a purchase; a profile may show it only once owned",
            "type": "boolean"
          }
        }
      }
    }
  }
}
