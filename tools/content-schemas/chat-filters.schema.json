{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/chat-filters.json",
  "title": "Chat filter lists",
  "description": "Words the table chat masks (Standard) or blocks (Family), per language; the server matches after normalising spelling evasions (GDD 11.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "languages"],
  "properties": {
    "schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "words"],
        "properties": {
          "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z]{4})?$" },
          "words": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2, "maxLength": 40 }
          }
        }
      }
    }
  }
}
