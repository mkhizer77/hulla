{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/manifest.json",
  "title": "Content manifest",
  "description": "Every content file with its hash, written by tools/content-sign and served signed by content_manifest (ADR-0011)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "files"],
  "properties": {
    "schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "const": "content-manifest"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "id", "version", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_./-]+\\.json$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
