{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/ranked.json",
  "title": "Ranked seasons",
  "description": "The ranked ladder (GDD 7.5, 12.9, R53): the starting rating, placement, demotion protection, the season length, the matchmaking band, and the leagues Bronze to Ustad with their season-end rewards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "gameId",
    "seats",
    "startRating",
    "placementRounds",
    "protectionRounds",
    "softReset",
    "ustadTop",
    "abandonAfterMs",
    "abandonPenalty",
    "season",
    "matchmaking",
    "leagues"
  ],
  "properties": {
    "schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "gameId": { "type": "string", "enum": ["thulla"] },
    "seats": { "type": "integer", "minimum": 3, "maximum": 6 },
    "startRating": { "type": "integer", "minimum": 0 },
    "placementRounds": { "type": "integer", "minimum": 0 },
    "protectionRounds": { "type": "integer", "minimum": 0 },
    "softReset": {
      "description": "How much of the distance from the starting rating a player keeps into the next season",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ustadTop": { "type": "integer", "minimum": 1 },
    "abandonAfterMs": { "type": "integer", "minimum": 0 },
    "abandonPenalty": { "type": "integer", "minimum": 0 },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorTs", "weeks"],
      "properties": {
        "anchorTs": { "type": "integer", "minimum": 0 },
        "weeks": { "type": "integer", "minimum": 1 }
      }
    },
    "matchmaking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "widenBy", "maxBand"],
      "properties": {
        "band": { "type": "integer", "minimum": 0 },
        "widenBy": { "type": "integer", "minimum": 0 },
        "maxBand": { "type": "integer", "minimum": 0 }
      }
    },
    "leagues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "minRating", "reward"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "name": { "type": "string", "pattern": "^league\\.[a-z0-9_]+$" },
          "minRating": { "type": "integer", "minimum": 0 },
          "topOnly": {
            "description": "Held only by players ranked inside ustadTop on the season board",
            "type": "boolean"
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "coins": { "type": "integer", "minimum": 0 },
              "items": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
              },
              "frame": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" }
            }
          }
        }
      }
    }
  }
}
