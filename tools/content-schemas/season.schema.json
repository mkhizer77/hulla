{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hulla.gg/schemas/content/season.json",
  "title": "Season pass",
  "description": "One season: its dates, the pass XP per source, forty tiers with a free and a premium reward each (GDD 12.10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "startTs", "endTs", "xpPerTier", "xp", "tiers"],
  "definitions": {
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "gems": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "title": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^season\\.[a-z0-9_.-]+$"
    },
    "startTs": {
      "type": "integer",
      "minimum": 0
    },
    "endTs": {
      "type": "integer",
      "minimum": 0
    },
    "xpPerTier": {
      "type": "integer",
      "minimum": 1
    },
    "xp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "dailyMission", "weeklyMission", "catchUpDays", "catchUpMultiplier"],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "dailyMission": {
          "type": "integer",
          "minimum": 0
        },
        "weeklyMission": {
          "type": "integer",
          "minimum": 0
        },
        "catchUpDays": {
          "type": "integer",
          "minimum": 0
        },
        "catchUpMultiplier": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "free", "premium"],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "free": {
            "$ref": "#/definitions/reward"
          },
          "premium": {
            "$ref": "#/definitions/reward"
          }
        }
      }
    }
  }
}
