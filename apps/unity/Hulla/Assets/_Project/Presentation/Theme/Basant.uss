/* ==================== Lobby (docs/design/basant-lobby.md) ==================== */
/* A 1080 x 1936 stage on the calm sky; the shared kit under Art/Basant/Kit, the rug under Lobby. */

.skin--basant .lobby.screen {
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .lobby .unity-button,
.skin--basant .lobby .unity-button:hover,
.skin--basant .lobby .unity-button:active,
.skin--basant .lobby .unity-button:focus {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .lobby .lobby__holder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.skin--basant .lobby .lobby__stage {
    width: 1080px;
    height: 1936px;
    flex-shrink: 0;
    transform-origin: center;
}

.skin--basant .lobby .lobby__stage > *,
.skin--basant .lobby .lobby__face,
.skin--basant .lobby .lobby__face > *,
.skin--basant .lobby .lobby__card > *,
.skin--basant .lobby .lobby__strip > *,
.skin--basant .lobby .lobby__seat > * {
    position: absolute;
}

.skin--basant .lobby Label {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

