}

.skin--basant .ranked__step--me {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row-yellow.png");
}

.skin--basant .ranked__step-name,
.skin--basant .ranked__step-detail,
.skin--basant .ranked__rating {
    color: rgb(74, 30, 14);
}

.skin--basant .ranked__banner {
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-label.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 120;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 0.3px;
}

/* Settings: one cream card per section; the rows inside are plain lines. */

.skin--basant .settings__group {
    padding: 14px 10px;
    margin-bottom: 10px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .settings__group > .settings__row,
.skin--basant .settings__group > .settings__action {
