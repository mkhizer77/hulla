    background-image: none;
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(255, 236, 200);
}

.skin--basant .results > .status {
    display: none;
}

/* Status fits beside a smaller face; the pill takes the room the mic and chat leave. */
.skin--basant .table__strip .me-badge .seat__avatar {
    width: 150px;
    height: 150px;
    border-top-left-radius: 75px;
    border-top-right-radius: 75px;
    border-bottom-left-radius: 75px;
    border-bottom-right-radius: 75px;
}

.skin--basant .table__status {
