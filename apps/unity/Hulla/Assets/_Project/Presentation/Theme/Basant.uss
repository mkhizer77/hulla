/*
 * Basant daytime, the one look (docs/design/basant-home.md). Loads after Skins.uss.
 *
 * Home is a 1080 x 1736 stage with every element at its box on the concept scaled to 1080 wide;
 * HomeView scales the stage to the room above the dock. Plates wider than their art stretch
 * through a horizontal slice of their plain middle (slice-scale = box height / art height), so
 * corners keep their drawn shape.
 *
 * Words drawn as art: a label marked .text-art--<key> shows its sprite for the root's lang--
 * class (the rules at the end) and its own text in any other language.
 */

/* ---------- Scene ---------- */

.skin--basant {
    background-color: rgb(91, 192, 240);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Backdrops/home-basant.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* The scene sits on the shell root so it reaches under the notch and the home bar (Theme/Backdrop.cs);
   the screens inside the safe area are transparent. Overlays carry the calm sky themselves. */
.skin--basant.backdrop--calm,
.skin--basant .backdrop--calm {
    background-color: rgb(196, 226, 246);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Backdrops/calm.png");
    -unity-background-scale-mode: scale-and-crop;
}

.skin--basant.backdrop--felt {
    background-color: rgb(18, 74, 48);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Backdrops/felt.png");
    -unity-background-scale-mode: scale-and-crop;
}

.skin--basant .home.screen {
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .home .unity-button,
.skin--basant .home .unity-button:hover,
.skin--basant .home .unity-button:active,
.skin--basant .home .unity-button:focus {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .home .home__holder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.skin--basant .home .home__stage {
    width: 1080px;
    height: 1736px;
    flex-shrink: 0;
    transform-origin: center;
}

.skin--basant .home .home__stage > * {
    position: absolute;
}

.skin--basant .home Label {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* The scene already flies its kites; the theme's drifting ones stay off Home. */
.skin--basant .home .ambient {
    display: none;
}

/* A control's art sits on its face at the concept's box; the control around it is the 48 dp target. */
.skin--basant .home .home__face {
    position: absolute;
}

/* ---------- Header ---------- */

.skin--basant .home .home__settings {
    left: 36px;
    top: 37px;
    width: 132px;
    height: 132px;
}

/* The same 124 px face as the shared top bar's gear, on the same centre. */
.skin--basant .home .home__settings .home__face {
