    text-overflow: ellipsis;
}

.skin--basant .settings .chip--teal,
.skin--basant .settings .chip--teal:hover,
.skin--basant .settings .chip--teal:active {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 92, 96);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-teal-normal.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.53px;
}

.skin--basant .friend-row__dismiss,
.skin--basant .friend-row__dismiss:hover,
.skin--basant .friend-row__dismiss:active {
    width: 100px;
