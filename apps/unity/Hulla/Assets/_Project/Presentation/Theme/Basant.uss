}

.skin--basant .table__status-text {
    font-size: 38px;
}

.skin--basant .table__status-secs {
    width: 96px;
    font-size: 36px;
}

.skin--basant .table__strip .table__mic,
.skin--basant .table__strip .table__chat,
.skin--basant .table__strip .table__mic:hover,
.skin--basant .table__strip .table__chat:hover,
.skin--basant .table__strip .table__mic:active,
.skin--basant .table__strip .table__chat:active {
