/* ==================== Friends, UI pass (design: Friends, Player sheet, Add friend) ==================== */

.skin--basant .friends__search {
    position: relative;
    height: 120px;
    margin: 0 10px 10px 10px;
    flex-direction: row;
    align-items: center;
}

.skin--basant .friends__search-icon {
    position: absolute;
    left: 34px;
    top: 34px;
    width: 52px;
    height: 52px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-search.png");
