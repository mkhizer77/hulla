/* ---------- Dock ---------- */

.skin--basant .nav {
    height: 200px;
    padding: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    overflow: hidden;
    border-top-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .nav .nav__tab,
.skin--basant .nav .nav__tab:hover,
.skin--basant .nav .nav__tab:active,
.skin--basant .nav .nav__tab:focus {
    width: 253px;
    height: 240px;
    flex-grow: 0;
    margin: 0 3.5px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/tab-tile-normal.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-top: 100;
    -unity-slice-bottom: 100;
    -unity-slice-scale: 0.5px;
}

.skin--basant .nav .nav__tab--on,
.skin--basant .nav .nav__tab--on:hover,
