.skin--basant .medal-tile--locked .achievement__medal.medal--first_friend, .skin--basant .medal-sheet__medal--locked.medal--first_friend { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/first_friend-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--friends_10, .skin--basant .medal-sheet__medal--locked.medal--friends_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/friends_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--friends_50, .skin--basant .medal-sheet__medal--locked.medal--friends_50 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/friends_50-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--rounds_with_friend_10, .skin--basant .medal-sheet__medal--locked.medal--rounds_with_friend_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/rounds_with_friend_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--rounds_with_friend_100, .skin--basant .medal-sheet__medal--locked.medal--rounds_with_friend_100 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/rounds_with_friend_100-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--full_house_friends, .skin--basant .medal-sheet__medal--locked.medal--full_house_friends { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/full_house_friends-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--same_group_10, .skin--basant .medal-sheet__medal--locked.medal--same_group_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/same_group_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--same_group_50, .skin--basant .medal-sheet__medal--locked.medal--same_group_50 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/same_group_50-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--escaped_first_10, .skin--basant .medal-sheet__medal--locked.medal--escaped_first_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/escaped_first_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--escaped_first_100, .skin--basant .medal-sheet__medal--locked.medal--escaped_first_100 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/escaped_first_100-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--first_escape_streak_5, .skin--basant .medal-sheet__medal--locked.medal--first_escape_streak_5 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/first_escape_streak_5-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--no_bhabhi_20, .skin--basant .medal-sheet__medal--locked.medal--no_bhabhi_20 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/no_bhabhi_20-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--clean_round_first, .skin--basant .medal-sheet__medal--locked.medal--clean_round_first { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/clean_round_first-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--clean_rounds_25, .skin--basant .medal-sheet__medal--locked.medal--clean_rounds_25 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/clean_rounds_25-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--houdini, .skin--basant .medal-sheet__medal--locked.medal--houdini { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/houdini-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--houdini_10, .skin--basant .medal-sheet__medal--locked.medal--houdini_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/houdini_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--first_cosmetic, .skin--basant .medal-sheet__medal--locked.medal--first_cosmetic { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/first_cosmetic-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--cosmetics_10, .skin--basant .medal-sheet__medal--locked.medal--cosmetics_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/cosmetics_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--cosmetics_30, .skin--basant .medal-sheet__medal--locked.medal--cosmetics_30 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/cosmetics_30-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--seasonal_rounds_10, .skin--basant .medal-sheet__medal--locked.medal--seasonal_rounds_10 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/seasonal_rounds_10-locked.png"); }
.skin--basant .medal-tile--locked .achievement__medal.medal--seasonal_rounds_50, .skin--basant .medal-sheet__medal--locked.medal--seasonal_rounds_50 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/seasonal_rounds_50-locked.png"); }

/* One laurel medal per ranked league (concept: Ranked). */
.skin--basant .ranked__medal.ranked__medal--league-bronze { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-bronze.png"); }
.skin--basant .ranked__medal.ranked__medal--league-silver { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-silver.png"); }
.skin--basant .ranked__medal.ranked__medal--league-gold { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-gold.png"); }
.skin--basant .ranked__medal.ranked__medal--league-platinum { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-platinum.png"); }
.skin--basant .ranked__medal.ranked__medal--league-diamond { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-diamond.png"); }
.skin--basant .ranked__medal.ranked__medal--league-ustad { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-ustad.png"); }
.skin--basant .ranked__medal.ranked__medal--league-none { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/league-none.png"); }

/* ==================== Achievement sheet (concept: sheet-achievement, 28 Oct) ==================== */
.skin--basant .sheet.medal-sheet {
    overflow: visible;
    padding-top: 0;
}

.skin--basant .medal-sheet .sheet__grabber {
    display: none;
}

.skin--basant .medal-sheet .medal-sheet__medal {
    width: 320px;
    height: 320px;
    margin: -170px 0 10px 0;
}

.skin--basant .medal-sheet .medal-sheet__goal {
    margin-top: 4px;
    font-size: 48px;
}

.skin--basant .medal-sheet .medal-sheet__reward {
    margin: 26px -64px 0 -64px;
    padding: 18px 20px;
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
    background-color: rgb(240, 216, 186);
}

.skin--basant .medal-sheet .medal-sheet__date {
    margin-top: 18px;
    font-size: 40px;
    -unity-font-style: normal;
    color: rgb(56, 34, 28);
}

.skin--basant .medal-sheet .medal-sheet__bar {
    height: 40px;
    margin: 24px 60px 0 60px;
    background-image: none;
    background-color: rgb(255, 252, 246);
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.skin--basant .medal-sheet .medal-sheet__bar > .meter__fill {
    left: 0;
    top: 0;
    bottom: 0;
    background-image: none;
    background-color: rgb(76, 176, 72);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* Report: Send report centred under the list. */
.skin--basant .report__send,
.skin--basant .report__send:hover,
.skin--basant .report__send:active {
    align-self: center;
}

/* The table's chat panel in the same cream sheet as every other sheet. */
.skin--basant .chat-panel {
    left: 0;
    right: 0;
    padding: 30px 48px 60px 48px;
    background-image: none;
    background-color: rgb(255, 245, 230);
    border-top-width: 7px;
    border-left-width: 7px;
    border-right-width: 7px;
    border-bottom-width: 0;
    border-color: rgb(40, 22, 18);
    border-top-left-radius: 64px;
    border-top-right-radius: 64px;
}

.skin--basant .chat-panel .sheet__grabber {
    width: 150px;
    height: 24px;
    border-width: 0;
    background-color: rgb(80, 76, 82);
}

/* ==================== Table strip and seats, owner comments 28 Oct ==================== */
/* Your face's box is the face itself, so the status bar sits right beside it. */
.skin--basant .table__strip .table__me,
.skin--basant .table__strip .me-badge {
    width: auto;
    min-width: 0;
    margin: 0 6px 0 0;
    padding: 0;
}

.skin--basant .table__strip .table__status {
    margin-left: 0;
}

/* Mic and chat: cream circles with a thick dark outline and bold red icons (concept: Table). */
.skin--basant .table__strip .table__mic,
.skin--basant .table__strip .table__chat,
.skin--basant .table__strip .table__mic:hover,
.skin--basant .table__strip .table__chat:hover,
.skin--basant .table__strip .table__mic:active,
.skin--basant .table__strip .table__chat:active {
    width: 132px;
    height: 132px;
    background-image: none;
    background-color: rgb(255, 242, 224);
    border-width: 7px;
    border-color: rgb(70, 22, 16);
    border-top-left-radius: 66px;
    border-top-right-radius: 66px;
    border-bottom-left-radius: 66px;
    border-bottom-right-radius: 66px;
}

.skin--basant .table__strip .table__mic:active,
.skin--basant .table__strip .table__chat:active {
    background-color: rgb(240, 220, 196);
}

.skin--basant .table__strip .table__icon {
    left: 24px;
    top: 24px;
    width: 70px;
    height: 70px;
}

/* Opponents: larger faces with a dark outline and a bigger name plate. */
.skin--basant .table .seat {
    width: 240px;
}

.skin--basant .table .seat .seat__avatar {
    width: 156px;
    height: 156px;
    border-width: 6px;
    border-color: rgb(70, 22, 16);
    border-top-left-radius: 78px;
    border-top-right-radius: 78px;
    border-bottom-left-radius: 78px;
    border-bottom-right-radius: 78px;
}

.skin--basant .table .seat .seat__name {
    min-width: 190px;
    height: 64px;
    font-size: 38px;
}

.skin--basant .table .seat .seat__count {
    width: 56px;
    height: 56px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    font-size: 34px;
}

/* Your own badge keeps its own size over the opponents' seat rules. */
.skin--basant .table .table__strip .me-badge {
    width: auto;
    min-width: 0;
    margin: 0 6px 0 0;
}

.skin--basant .table .table__strip .me-badge .seat__avatar {
    width: 186px;
    height: 186px;
    border-width: 5px;
    border-color: rgb(70, 22, 16);
    border-top-left-radius: 93px;
    border-top-right-radius: 93px;
    border-bottom-left-radius: 93px;
    border-bottom-right-radius: 93px;
}

/* Hold-to-talk tip above the mic, and the mic lit while held. */
.skin--basant .table__mic {
    overflow: visible;
}

.skin--basant .table__mic-tip {
    display: none;
    position: absolute;
    bottom: 140px;
    right: -40px;
    padding: 10px 24px;
    font-size: 34px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: rgb(255, 255, 255);
    background-color: rgb(46, 36, 38);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.skin--basant .table__strip .table__mic.table__mic--held {
    background-color: rgb(120, 210, 110);
    border-color: rgb(30, 90, 30);
}

/* Home: "Seat size" as live text on a small maroon tab over the tray (owner comment, 28 Oct). */
.skin--basant .home .home__seats-label {
    left: 185px;
    top: -34px;
    width: 210px;
    height: 58px;
    font-size: 34px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 240, 220);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-image: none;
    background-color: rgb(150, 36, 60);
    border-width: 4px;
    border-color: rgb(80, 20, 30);
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-left-radius: 29px;
    border-bottom-right-radius: 29px;
}

/* Playable cards: a light, subtle glow and a gentler lift. */
.skin--basant .card--legal {
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: rgb(244, 196, 80);
    border-bottom-color: rgb(200, 150, 40);
    translate: 0 -22px;
}

.skin--basant .card--legal > .card__glow,
.skin--basant .card--raised > .card__glow {
    left: -22px;
    top: -22px;
    right: -22px;
    bottom: -26px;
    opacity: 0.45;
    -unity-slice-scale: 0.55px;
}

/* The status line shrinks to fit rather than cutting off ("Your turn · play any card"). */
.skin--basant .table__strip .table__status-text {
    -unity-text-auto-size: best-fit 26px 40px;
    text-overflow: clip;
}

/* The status pill already says "Out · watching": no second tag beside your face. */
.skin--basant .table .table__strip .me-badge .seat__state,
.skin--basant .table .table__strip .me-badge .seat__name,
.skin--basant .table .table__strip .me-badge .seat__you {
    display: none;
}

/* Friends headings: the words, then the count bubble beside them. */
.skin--basant .friends__heading .friends__heading-text {
    margin: 0;
    font-size: 52px;
    color: rgb(40, 22, 18);
}

/* Locked achievement names: one line where they fit, smaller when long. */
.skin--basant .settings .medals__grid--locked .medal-tile__name {
    font-size: 38px;
    white-space: normal;
}

/* Missions headings at the concept's size (an older Settings heading rule was more specific). */
.skin--basant .settings .settings__heading.missions__heading {
    flex-shrink: 1;
    white-space: normal;
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

/* ==================== Turn ring, owner message 28 Oct (concept: table) ==================== */
/* One drawn ring hugs the face's dark outline at the same thickness for every seat, its glow drawn with
   it; the old glow picture under it made a second ring of another size. Insets are the border plus the ring. */
.skin--basant .table .seat--turn .seat__frame {
    background-image: none;
}

.skin--basant .table .seat .seat__timer {
    left: -15px;
    top: -15px;
    right: -15px;
    bottom: -15px;
}

.skin--basant .table .table__strip .me-badge .seat__timer {
    left: -14px;
    top: -14px;
    right: -14px;
    bottom: -14px;
}

/* ==================== Results, owner message 28 Oct (concept: results-basant-v3) ==================== */
/* A panel only as tall as its content, centred on the felt: plain cream in a maroon frame, the podium
   along its top, the headline, reward, level and highlights under it; Play again, the small row and an
   underlined Leave below the panel. */
.skin--basant .results {
    justify-content: center;
    padding: 30px 64px 10px 64px;
}

.skin--basant .results__panel {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    padding: 22px 30px 26px 30px;
    background-image: none;
    background-color: rgb(255, 241, 226);
    border-width: 10px;
    border-color: rgb(150, 34, 74);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-left-radius: 44px;
    border-bottom-right-radius: 44px;
}

.skin--basant .results__scroll {
    flex-grow: 0;
    flex-shrink: 1;
}

.skin--basant .results .podium {
    margin: 0;
    align-items: stretch;
}

.skin--basant .results .podium__stand {
    width: 100%;
    margin: 0;
    padding: 0;
    border-bottom-width: 6px;
    border-color: rgb(120, 40, 34);
}

/* Columns share the panel's width, so three players fill it as four do. */
.skin--basant .results .podium__col {
    flex-grow: 1;
    flex-shrink: 1;
    width: 214px;
    max-width: 280px;
    margin: 0;
}

.skin--basant .results .podium__col--1 {
    width: 240px;
    max-width: 300px;
}

.skin--basant .results .podium__col--loser {
    width: 206px;
}

/* The blocks are drawn steps (light top face, maroon outline); the tag and the name plate sit on them. */
.skin--basant .results .podium__block {
    padding: 34px 8px 14px 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Results/podium-1.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 90;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 0.5px;
}

.skin--basant .results .podium__col--1 .podium__block { height: 282px; background-color: rgba(0, 0, 0, 0); }
.skin--basant .results .podium__col--2 .podium__block { height: 212px; }

.skin--basant .results .podium__col--3 .podium__block {
