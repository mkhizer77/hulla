    top: 18px;
    height: 108px;
    font-size: 92px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    -unity-text-auto-size: best-fit 44px 92px;
    -unity-text-outline-width: 5px;
}

.skin--basant .lobby .lobby__play-label--small {
    font-size: 52px;
    -unity-text-auto-size: best-fit 34px 52px;
}

.skin--basant .lobby .lobby__play:disabled {
    opacity: 0.75;
}

.skin--basant .lobby .lobby__strip-text {
    font-size: 40px;
}

.skin--basant .lobby .lobby__strip-text--empty {
    color: rgb(150, 110, 80);
    -unity-font-style: normal;
}

/* ---------- Chat sheet: bubbles, mine on the right, the field and the send arrow ---------- */

.skin--basant .chat-sheet__log {
    height: 640px;
    margin: 10px 0 20px 0;
    padding: 20px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: rgba(214, 178, 140, 0.35);
}

.skin--basant .chat-sheet__empty {
    margin-top: 220px;
    color: rgb(150, 110, 80);
}

.skin--basant .chat-bubble__row {
    align-items: flex-start;
    margin-bottom: 18px;
}

.skin--basant .chat-bubble__row--mine {
    align-items: flex-end;
}

.skin--basant .chat-bubble__name {
    margin: 0 0 4px 24px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(110, 62, 36);
}

.skin--basant .chat-bubble {
    max-width: 80%;
    padding: 18px 30px;
    font-size: 42px;
    white-space: normal;
    color: rgb(74, 30, 14);
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .chat-bubble--mine {
    background-color: rgb(255, 205, 64);
}

.skin--basant .chat-sheet__compose {
    flex-direction: row;
    align-items: center;
}

.skin--basant .chat-sheet__input {
    flex-grow: 1;
    margin: 0 20px 0 0;
}

.skin--basant .chat-sheet__input TextInput,
.skin--basant .chat-sheet__input .unity-base-text-field__input {
    min-height: 124px;
    padding: 0 30px;
    font-size: 44px;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .chat-sheet__send,
.skin--basant .chat-sheet__send:hover,
.skin--basant .chat-sheet__send:focus,
.skin--basant .chat-sheet__send:active {
    width: 150px;
    height: 132px;
    min-height: 132px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-normal.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-scale: 0.9px;
}

.skin--basant .chat-sheet__send:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-pressed.png");
}

.skin--basant .chat-sheet__send-icon {
    position: absolute;
    left: 39px;
    top: 30px;
    width: 72px;
    height: 72px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-send.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .chat-sheet__status {
    margin-top: 8px;
    font-size: 32px;
    color: rgb(198, 40, 40);
    -unity-text-align: middle-center;
}

/* ==================== Table, UI pass (design: Table) ==================== */

.skin--basant .table {
    padding: 12px 24px 0 24px;
}

.skin--basant .table__hidden {
    display: none;
}

.skin--basant .table__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 136px;
    flex-shrink: 0;
}

.skin--basant .table__top .table__pill,
.skin--basant .table__top .table__pill:hover,
.skin--basant .table__top .table__pill:active {
    height: 104px;
    min-width: 190px;
    font-size: 42px;
    -unity-slice-scale: 0.77px;
}

.skin--basant .table__plate {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    min-width: 0;
    height: 104px;
    margin: 0 16px;
    padding: 0 44px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.867px;
}

.skin--basant .table__plate .table__info {
    min-width: 0;
    height: 104px;
    padding: 0;
    font-size: 46px;
    background-image: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgb(74, 30, 14);
}

.skin--basant .table__eye {
    width: 56px;
    height: 44px;
    margin-left: 22px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-eye.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .table__eye-count {
    margin-left: 8px;
    font-size: 42px;
    color: rgb(74, 30, 14);
}

.skin--basant .table__round,
.skin--basant .table__round:hover,
.skin--basant .table__round:active,
.skin--basant .table__round:focus {
    width: 132px;
    height: 132px;
    min-height: 132px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-normal.png");
    background-size: 124px 124px;
    background-position: center;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .table__round:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-pressed.png");
}

.skin--basant .table__round .table__icon {
    left: 34px;
    top: 34px;
    width: 64px;
    height: 64px;
}

.skin--basant .table__icon--more { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-more.png"); }

/* The rug keeps a fixed square on phones; the space left over goes above it and above the strip. */
.skin--basant .table__gap {
    flex-grow: 0;
    flex-shrink: 1;
}

.skin--basant.size--compact .table__zone {
    flex-grow: 0;
    flex-shrink: 0;
    height: 1000px;
}

.skin--basant.size--compact .table__gap {
    flex-grow: 1;
}

.skin--basant.size--compact .table__gap--top {
    flex-grow: 0.35;
}

.skin--basant .table__zone > .rail {
    left: 6%;
    right: 6%;
    top: 7%;
    bottom: 7%;
}

/* ---------- Own-seat strip: the face with its ring, the status pill, mic and chat ---------- */

.skin--basant .table__strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 196px;
    margin: 0 0 6px 0;
}

.skin--basant .table__strip .table__me {
    position: relative;
    left: auto;
    bottom: auto;
    translate: 0 0;
    flex-shrink: 0;
}

.skin--basant .table__strip .me-badge {
    margin: 0 18px 0 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .table__strip .me-badge .seat__name,
.skin--basant .table__strip .me-badge .seat__state,
.skin--basant .table__strip .me-badge .seat__you {
    display: none;
}

.skin--basant .table__strip .me-badge .seat__avatar {
    width: 172px;
    height: 172px;
    border-top-left-radius: 86px;
    border-top-right-radius: 86px;
    border-bottom-left-radius: 86px;
    border-bottom-right-radius: 86px;
    border-width: 8px;
    border-color: rgb(250, 184, 36);
}

.skin--basant .table__strip .me-badge .seat__initial {
    font-size: 80px;
}

.skin--basant .table__status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 116px;
    padding: 0 18px 0 40px;
    flex-direction: row;
    align-items: center;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Table/plate-turn.png");
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-scale: 0.287px;
}

.skin--basant .table__status-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 42px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgb(255, 243, 218);
}

.skin--basant .table__status-secs {
    display: none;
    flex-shrink: 0;
    width: 104px;
    height: 84px;
    margin-left: 12px;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-left-radius: 42px;
    border-bottom-right-radius: 42px;
    background-color: rgba(255, 255, 255, 0.14);
    font-size: 40px;
    -unity-text-align: middle-center;
    color: rgb(255, 210, 63);
}

.skin--basant .table__strip .table__mic,
.skin--basant .table__strip .table__chat,
.skin--basant .table__strip .table__mic:hover,
.skin--basant .table__strip .table__chat:hover,
.skin--basant .table__strip .table__mic:active,
.skin--basant .table__strip .table__chat:active {
    width: 132px;
    height: 132px;
    min-width: 132px;
    min-height: 132px;
    margin: 0 0 0 12px;
    flex-shrink: 0;
    background-size: 124px 124px;
    background-position: center;
    -unity-background-scale-mode: stretch-to-fill;
}

.skin--basant .table__strip .table__icon {
    left: 34px;
    top: 34px;
    width: 64px;
    height: 64px;
}

/* ---------- Quick chat under the strip, Ask for a hand among the chips ---------- */

.skin--basant .table__bar {
    flex-shrink: 0;
    min-height: 120px;
    justify-content: center;
}

.skin--basant .quick-strip {
    flex-shrink: 1;
    min-width: 0;
    flex-wrap: nowrap;
    overflow: hidden;
    margin: 0;
}

.skin--basant .quick-strip__chip,
.skin--basant .quick-strip__more,
.skin--basant .quick-strip__chip:hover,
.skin--basant .quick-strip__chip:active {
    flex-shrink: 0;
    min-height: 104px;
    margin: 0 6px;
    padding: 0 34px;
    font-size: 40px;
    white-space: nowrap;
    -unity-slice-scale: 0.77px;
}

.skin--basant .table__bar-actions .button--primary,
.skin--basant .table__bar-actions .button--primary:hover,
.skin--basant .table__bar-actions .button--primary:active {
    flex-shrink: 0;
    min-height: 104px;
    margin-left: 8px;
    padding: 0 34px;
    font-size: 40px;
}

/* ---------- Sheets on the table: the dim, the player sheet, the chat ---------- */

.skin--basant .table__dim {
    display: none;
    position: absolute;
    left: -60px;
    right: -60px;
    top: -320px;
    bottom: -240px;
    background-color: rgba(34, 14, 24, 0.5);
}

.skin--basant .player-sheet {
    top: auto;
    left: -8px;
    right: -8px;
    bottom: 0;
    padding: 40px 52px 60px 52px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .player-sheet .coach__text {
    font-size: 60px;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

.skin--basant .player-sheet .chips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 20px;
}

.skin--basant .player-sheet .chip,
.skin--basant .player-sheet .chip:hover,
.skin--basant .player-sheet .chip:active {
    min-height: 120px;
    margin: 8px;
    padding: 0 40px;
    font-size: 42px;
    -unity-slice-scale: 0.89px;
}

.skin--basant .player-sheet .caption {
    margin-top: 16px;
    font-size: 36px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.skin--basant .player-sheet .sheet__level {
    width: 100%;
    margin: 6px 0 10px 0;
}

.skin--basant .chat-panel {
    left: -8px;
    right: -8px;
    height: auto;
    padding: 30px 44px 44px 44px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .chat-panel .sheet__grabber {
    align-self: center;
}

.skin--basant .chat-panel__tabs {
    margin-bottom: 18px;
}

.skin--basant .chat-panel__log {
    height: 560px;
}

.skin--basant .chat-panel__scroll {
    height: 700px;
    flex-grow: 0;
}

.skin--basant .chat-panel .chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.skin--basant .chat-panel .chip,
.skin--basant .chat-panel .chip:hover,
.skin--basant .chat-panel .chip:active {
    min-height: 112px;
    margin: 8px;
    padding: 0 32px;
    font-size: 40px;
    -unity-slice-scale: 0.83px;
}

.skin--basant .chat-panel__compose {
    flex-direction: row;
    align-items: center;
}

.skin--basant .chat-panel__input {
    flex-grow: 1;
    margin: 0 18px 0 0;
}

.skin--basant .chat-panel__input TextInput,
.skin--basant .chat-panel__input .unity-base-text-field__input {
    min-height: 124px;
    padding: 0 30px;
    font-size: 44px;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .chat-log__line {
    margin-bottom: 14px;
    font-size: 40px;
    white-space: normal;
    color: rgb(74, 30, 14);
}

/* The coach sits between the rug and the hand, never over the pile (design: Tutorial). */
.skin--basant .coach {
    top: auto;
    bottom: 520px;
    left: 0;
    right: 0;
}

.skin--basant .player-sheet {
    bottom: 0;
}

/* ---------- Menu, scoreboard and watching sheets ---------- */

.skin--basant .menu-sheet__item,
.skin--basant .menu-sheet__item:hover,
.skin--basant .menu-sheet__item:active {
    flex-grow: 0;
    min-height: 140px;
    margin: 10px 20px;
}

.skin--basant .score__row {
    flex-direction: row;
    align-items: center;
    height: 104px;
    padding: 0 30px;
    margin: 4px 0;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

.skin--basant .score__row Label {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .score__row #score-name {
    flex-grow: 1;
}

.skin--basant .score__row--head Label {
    font-size: 34px;
    color: rgb(133, 89, 58);
}

.skin--basant .score__row--me {
    background-color: rgba(255, 205, 64, 0.4);
}

.skin--basant .watch-row {
    flex-direction: row;
    align-items: center;
    min-height: 132px;
    margin: 6px 0;
}

.skin--basant .watch-row__name {
    flex-grow: 1;
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .watch-row__tag {
    font-size: 36px;
    color: rgb(30, 130, 60);
}

.skin--basant .watch-row__seat,
.skin--basant .watch-row__seat:hover,
.skin--basant .watch-row__seat:active {
    flex-grow: 0;
    min-width: 220px;
}

/* ==================== Results, UI pass (design: Results) ==================== */

.skin--basant .results {
    padding: 30px 30px 20px 30px;
    justify-content: center;
}

.skin--basant .results__panel {
    flex-shrink: 1;
    padding: 36px 30px 30px 30px;
}

.skin--basant .podium {
    align-items: center;
    margin: 0 0 6px 0;
}

.skin--basant .podium__stand {
    padding-top: 70px;
}

.skin--basant .podium__steps {
    right: 220px;
    height: 300px;
}

.skin--basant .podium__place {
    width: 220px;
}

.skin--basant .podium__avatar {
    width: 164px;
    height: 164px;
    border-top-left-radius: 82px;
    border-top-right-radius: 82px;
    border-bottom-left-radius: 82px;
    border-bottom-right-radius: 82px;
    border-width: 7px;
}

.skin--basant .podium__place--1 .podium__avatar {
    width: 190px;
    height: 190px;
    border-top-left-radius: 95px;
    border-top-right-radius: 95px;
    border-bottom-left-radius: 95px;
    border-bottom-right-radius: 95px;
}

.skin--basant .podium__place--loser .podium__avatar {
    width: 150px;
    height: 150px;
    border-top-left-radius: 75px;
    border-top-right-radius: 75px;
    border-bottom-left-radius: 75px;
    border-bottom-right-radius: 75px;
    opacity: 0.75;
}

.skin--basant .podium__name {
    height: 64px;
    margin-top: 6px;
    font-size: 38px;
    -unity-slice-scale: 0.533px;
}

.skin--basant .podium__rank {
    height: 56px;
    font-size: 34px;
    -unity-slice-scale: 0.69px;
}

.skin--basant .podium__place--loser .results__stamp {
    position: absolute;
    left: -30px;
    top: 40px;
    right: auto;
    width: 280px;
    height: 128px;
    rotate: -10deg;
}

.skin--basant .results__title {
    margin: 10px 0 4px 0;
    font-size: 84px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: rgb(255, 205, 50);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(110, 40, 12);
    text-shadow: 0 6px 0 rgb(110, 40, 12);
    white-space: normal;
}

.skin--basant .result-reward {
    margin: 4px 0 10px 0;
    font-size: 50px;
    -unity-text-align: middle-center;
}

.skin--basant .results__level {
    height: 72px;
    margin: 4px 50px 18px 50px;
    overflow: hidden;
    justify-content: center;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-track.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-scale: 0.286px;
}

.skin--basant .results__level-fill {
    position: absolute;
    left: 8px;
    top: 8px;
    bottom: 8px;
    min-width: 50px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-fill.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-scale: 0.19px;
}

.skin--basant .results__level-text {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

.skin--basant .results__highlights {
    margin: 6px 24px 14px 24px;
    padding: 20px 30px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    background-color: rgba(214, 178, 140, 0.4);
}

.skin--basant .results__highlight {
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .results__friends {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.skin--basant .results__new-here {
    margin-right: 10px;
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .results__again {
    margin: 30px 10px 6px 10px;
}

.skin--basant .results__play,
.skin--basant .results__play:hover,
.skin--basant .results__play:active {
    min-height: 170px;
    font-size: 70px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
}

.skin--basant .results__play .podium__votes {
    position: absolute;
    right: 40px;
    top: 0;
    bottom: 0;
    align-items: center;
}

.skin--basant .results__quiet {
    align-items: center;
    margin-top: 10px;
}

.skin--basant .results__quiet .button,
.skin--basant .results__quiet .button:hover,
.skin--basant .results__quiet .button:active {
    min-height: 132px;
    margin: 0 10px;
    padding: 0 40px;
    font-size: 44px;
}

.skin--basant .results__quiet .results__share,
.skin--basant .results__quiet .results__share:hover,
.skin--basant .results__quiet .results__share:active {
    width: 132px;
    min-width: 132px;
    padding: 0;
    background-size: 100% 120px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-teal-normal.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.6px;
}

.skin--basant .results__share-icon {
    position: absolute;
    left: 34px;
    top: 34px;
    width: 64px;
    height: 64px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-share.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .results__share--hot {
