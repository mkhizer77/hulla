.skin--basant .medal-tile--locked .achievement__medal.medal--series_first, .skin--basant .medal-sheet__medal--locked.medal--series_first { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Medals/series_first-locked.png"); }
