}

.skin--basant .settings__group > .settings__action,
.skin--basant .settings__group > .settings__action:hover,
.skin--basant .settings__group > .settings__action:active {
    -unity-text-align: middle-left;
    background-image: none;
}

.skin--basant .settings__group > .field {
    margin: 8px 26px;
}

.skin--basant .settings__group > .status {
    margin: 4px 26px;
}

/* Rulebook: section headings on the yellow tag, lines on cream cards. */

.skin--basant .rulebook__section > .turn {
    align-self: flex-start;
    min-height: 60px;
    margin-bottom: 8px;
    padding: 0 28px;
    font-size: 32px;
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-yellow.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-scale: 0.74px;
}

.skin--basant .rulebook__section {
    padding: 20px 30px;
    margin-bottom: 20px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .rulebook__line {
    font-size: 30px;
    color: rgb(74, 30, 14);
}

/* The faint far kites of the calm screens (AmbientLayer, Basant). */

.skin--basant .ambient__kite-faint {
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.85;
}

.skin--basant .ambient__kite-faint--1 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/kite-faint-1.png"); }
.skin--basant .ambient__kite-faint--2 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/kite-faint-2.png"); }
.skin--basant .ambient__kite-faint--3 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/kite-faint-3.png"); }

/* ==================== Loading ==================== */
/* The first screen: the HULLA kite on the Home sky (the scene already flies its kites), the bar, one word. */

.skin--basant .loading.screen {
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .loading .ambient {
    display: none;
}

.skin--basant .loading__stage {
    height: 1936px;
}

.skin--basant .loading__logo {
    left: 118px;
    top: 575px;
    width: 845px;
    height: 657px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/logo-hulla.png");
}

.skin--basant .loading__bar {
    left: 302px;
    top: 1590px;
    width: 476px;
}

.skin--basant .loading__status {
    left: 240px;
    top: 1680px;
    width: 600px;
    height: 64px;
    font-size: 44px;
    color: rgb(96, 40, 20);
    -unity-text-align: middle-center;
}

/* ==================== Bottom sheets (design: Dialogs) ==================== */
/* Every question: the dimmed screen, a cream sheet from the bottom with a grabber, a title, one line
   and two answers side by side, the safe one left. */

.skin--basant .sheet-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: stretch;
    background-color: rgba(34, 14, 24, 0.55);
}

.skin--basant .sheet {
    margin: 0 16px 16px 16px;
    padding: 30px 48px 52px 48px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .sheet__grabber {
    width: 120px;
    height: 14px;
    margin-bottom: 28px;
    align-self: center;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: rgba(74, 30, 14, 0.35);
}

.skin--basant .sheet__title {
    margin: 0 0 8px 0;
    font-size: 60px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--basant .sheet__body {
    margin: 4px 0 0 0;
    font-size: 40px;
    white-space: normal;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-text-align: middle-center;
    color: rgb(110, 62, 36);
}

.skin--basant .sheet__answers {
    flex-direction: row;
    margin-top: 44px;
}

.skin--basant .sheet__answer,
.skin--basant .sheet__answer:hover,
.skin--basant .sheet__answer:active,
.skin--basant .sheet__answer:focus {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 140px;
    margin: 0 12px;
    padding: 0 16px;
    border-width: 0;
    border-radius: 0;
    white-space: normal;
    font-size: 46px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-square-normal.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 70;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.5px;
}

.skin--basant .sheet__answer:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-square-pressed.png");
}

.skin--basant .sheet__answer--yes,
.skin--basant .sheet__answer--yes:hover,
.skin--basant .sheet__answer--yes:focus {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.45px;
}

.skin--basant .sheet__answer--yes:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-pressed.png");
}

.skin--basant .sheet__answer--danger,
.skin--basant .sheet__answer--danger:hover,
.skin--basant .sheet__answer--danger:focus {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(96, 20, 20);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-danger-normal.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 0.55px;
}

.skin--basant .sheet__answer--danger:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-danger-pressed.png");
}

/* ==================== UI pass 28 Oct: shared rules ==================== */

/* The game's face everywhere, fields included; the screens' own rules still win. */
.skin--basant Label,
.skin--basant .unity-button,
.skin--basant TextInput,
.skin--basant .unity-base-text-field__input,
.skin--basant .unity-text-element {
