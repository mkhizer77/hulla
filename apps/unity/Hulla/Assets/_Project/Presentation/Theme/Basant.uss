    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
    background-color: rgb(255, 246, 228);
}

.skin--basant .shop__state--price {
    background-color: rgb(255, 205, 50);
}

.skin--basant .shop__state--short {
    opacity: 0.6;
}

.skin--basant .shop__state--equipped {
    border-width: 0;
    background-color: rgb(250, 190, 40);
    font-size: 30px;
}

.skin--basant .shop__state--owned {
    background-color: rgb(250, 190, 40);
    font-size: 28px;
}

/* Drawn art until the cosmetics art lands: a card back, a rug, a card face or a badge. */
.skin--basant .shop__art {
    width: 110px;
    height: 150px;
    padding: 8px;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgb(255, 250, 238);
    rotate: -6deg;
}

.skin--basant .shop__art-inner {
    flex-grow: 1;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    align-items: center;
    justify-content: center;
}

.skin--basant .shop__art-motif {
    width: 46px;
    height: 46px;
    rotate: 45deg;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.75);
}

.skin--basant .shop__art--table {
    width: 160px;
    height: 104px;
    rotate: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.skin--basant .shop__art--cardFace .shop__art-inner {
    background-color: rgb(255, 255, 255);
}

.skin--basant .shop__art--emotePack,
.skin--basant .shop__art--celebration,
.skin--basant .shop__art--soundSet,
.skin--basant .shop__art--voPack {
    width: 126px;
    height: 126px;
    rotate: 0;
    border-top-left-radius: 63px;
    border-top-right-radius: 63px;
    border-bottom-left-radius: 63px;
    border-bottom-right-radius: 63px;
}

.skin--basant .shop__art--emotePack .shop__art-inner,
.skin--basant .shop__art--celebration .shop__art-inner,
.skin--basant .shop__art--soundSet .shop__art-inner,
.skin--basant .shop__art--voPack .shop__art-inner {
    border-top-left-radius: 55px;
    border-top-right-radius: 55px;
    border-bottom-left-radius: 55px;
    border-bottom-right-radius: 55px;
}

.skin--basant .shop__art--large {
    width: 160px;
    height: 220px;
    margin-right: 40px;
}

.skin--basant .shop__art--sheet {
    width: 230px;
    height: 316px;
    margin: 10px 0 24px 0;
    align-self: center;
}

.skin--basant .item-sheet__action,
.skin--basant .item-sheet__action:hover,
.skin--basant .item-sheet__action:active {
    flex-grow: 0;
    min-height: 150px;
    margin: 24px 20px 6px 20px;
    font-size: 52px;
}

.skin--basant .item-sheet__balance {
    font-size: 36px;
    color: rgb(133, 89, 58);
}

/* Pass */

.skin--basant .pass__plate {
    margin: 0 0 18px 0;
    padding: 40px 36px 34px 36px;
}

.skin--basant .pass__empty {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__plate-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.skin--basant .pass__season {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__days,
.skin--basant .pass__xp {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__tierline {
    margin-top: 12px;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__meter {
    height: 44px;
    margin: 10px 0 24px 0;
}

.skin--basant .pass__track {
    height: 480px;
}

.skin--basant .pass__col {
    width: 220px;
    margin-right: 6px;
    padding: 0 6px 10px 6px;
    align-items: center;
}

.skin--basant .pass__col--current {
    background-color: rgba(255, 205, 50, 0.5);
}

.skin--basant .pass__num {
    width: 100%;
    height: 80px;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
    background-color: rgba(214, 178, 140, 0.45);
}

.skin--basant .pass__col--current .pass__num {
    background-color: rgb(255, 205, 50);
}

.skin--basant .pass__cell {
    width: 196px;
    height: 180px;
    margin-top: 12px;
    padding: 12px;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tier-cell.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.skin--basant .pass__cell--premium {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tier-cell-premium.png");
}

.skin--basant .pass__cell--ahead {
    opacity: 0.6;
}

.skin--basant .pass__reward {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__claim,
.skin--basant .pass__claim:hover,
.skin--basant .pass__claim:active {
    position: absolute;
    bottom: 6px;
    height: 64px;
    min-height: 64px;
    padding: 0 22px;
    border-width: 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-normal.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-scale: 0.45px;
}

.skin--basant .pass__tick {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 52px;
    height: 52px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tick-ready.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .pass__lock {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 46px;
    height: 52px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-lock.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .pass__track-label {
    margin-top: 14px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .pass__track-label--premium {
    color: rgb(192, 52, 96);
}

.skin--basant .pass__note {
    margin: 0 30px;
    padding: 30px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    background-color: rgba(214, 178, 140, 0.55);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
}

/* ==================== Settings, UI pass (design: Settings, Settings pages) ==================== */

.skin--basant .settings__group {
    padding: 22px 12px;
}

.skin--basant .settings__group > .settings__row,
.skin--basant .settings__group > .settings__row:hover,
.skin--basant .settings__group > .settings__row:active {
    min-height: 120px;
    margin: 0;
    padding: 4px 30px;
    border-width: 0;
    border-radius: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .settings__group > .settings__level {
    flex-direction: row;
}

.skin--basant .settings__group > .settings__level > .unity-label {
    flex-grow: 0;
    min-width: 330px;
    font-size: 46px;
    color: rgb(74, 30, 14);
}

.skin--basant .settings__group > .settings__level > .unity-base-slider__input {
    flex-grow: 1;
}

.skin--basant .settings__link-label {
    flex-shrink: 1;
    font-size: 46px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .settings__link-value {
    flex-shrink: 0;
    margin-left: 16px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(133, 89, 58);
}

.skin--basant .settings__tick {
    font-size: 52px;
    color: rgb(30, 130, 60);
}

.skin--basant .settings__link-row--danger .settings__link-label {
    color: rgb(198, 40, 40);
}

.skin--basant .settings__seg {
    width: 330px;
    height: 100px;
    flex-shrink: 0;
    background-size: 100% 84px;
}

.skin--basant .settings__seg .mini-seg__item,
.skin--basant .settings__seg .mini-seg__item:hover,
.skin--basant .settings__seg .mini-seg__item:active {
    font-size: 36px;
}

.skin--basant .settings__seg .mini-seg__item--on {
    background-size: 100% 70px;
}

.skin--basant .settings__note {
    margin: 10px 30px;
    font-size: 40px;
    color: rgb(133, 89, 58);
}

.skin--basant .settings__link-row .chip,
.skin--basant .settings__link-row .chip:hover,
.skin--basant .settings__link-row .chip:active {
    margin: 0;
}

.skin--basant .settings__footer,
.skin--basant .settings__footer:hover,
.skin--basant .settings__footer:active {
    align-self: center;
    min-height: 110px;
    margin: 16px 0 30px 0;
    padding: 0 30px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(110, 62, 36);
}

/* ==================== Profile, UI pass (design: Profile, Edit profile) ==================== */

.skin--basant .profile__hidden {
    display: none;
}

.skin--basant .profile__card {
    align-items: center;
    margin: 6px 0 22px 0;
    padding: 44px 30px 40px 30px;
    border-width: 8px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-left-radius: 44px;
    border-bottom-right-radius: 44px;
    background-color: rgb(255, 238, 214);
}

.skin--basant .profile__face {
    width: 270px;
    height: 270px;
    border-width: 12px;
    border-color: rgb(250, 184, 36);
    border-top-left-radius: 135px;
    border-top-right-radius: 135px;
    border-bottom-left-radius: 135px;
    border-bottom-right-radius: 135px;
    -unity-background-scale-mode: scale-and-crop;
}

.skin--basant .profile__face .seat__initial {
    font-size: 130px;
}

.skin--basant .settings .profile__name {
    margin-top: 16px;
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(96, 26, 26);
}

.skin--basant .settings .profile__line {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(96, 26, 26);
}

.skin--basant .profile__code-row {
    flex-direction: row;
    align-items: center;
    margin: 0 0 22px 0;
    padding: 24px 30px 24px 50px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .profile__code-text {
    flex-grow: 1;
    align-items: center;
}

.skin--basant .settings .profile__code-label {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .settings .profile__code {
    font-size: 88px;
    letter-spacing: 6px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    color: rgb(255, 205, 50);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(110, 40, 12);
}

.skin--basant .profile__share,
.skin--basant .profile__share:hover,
.skin--basant .profile__share:active {
    width: 132px;
    height: 132px;
    min-height: 132px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-teal-normal.png");
    background-size: 100% 120px;
    background-position: center;
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.6px;
}

.skin--basant .profile__tiles {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.skin--basant .profile__tile {
    width: 49%;
    height: 230px;
    margin-bottom: 20px;
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .settings .profile__tile-number {
    font-size: 100px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    color: rgb(255, 250, 240);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(74, 30, 14);
}

.skin--basant .settings .profile__tile-number--red {
    color: rgb(214, 40, 40);
}

.skin--basant .settings .profile__tile-label {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .profile__medals-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 10px 10px 10px;
}

.skin--basant .settings .profile__medals-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .profile__see-all,
.skin--basant .profile__see-all:hover,
.skin--basant .profile__see-all:active {
    min-height: 100px;
    padding: 0 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    border-bottom-width: 4px;
    border-color: rgb(74, 30, 14);
}

.skin--basant .profile__medals {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 0 20px 0;
}

.skin--basant .profile__medal {
    width: 180px;
    height: 180px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-gold.png");
    background-size: 150px 150px;
    background-position: center;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    background-color: rgb(255, 238, 214);
}

.skin--basant .profile__medal--locked {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-grey.png");
    background-color: rgb(225, 214, 200);
}

.skin--basant .settings .profile__ranked {
    margin: 0 0 30px 0;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

/* Edit sheet: the fields in the game's face */

.skin--basant .edit-profile .field > Label {
    font-size: 36px;
    color: rgb(133, 89, 58);
}

.skin--basant .edit-profile .field TextInput,
.skin--basant .edit-profile .field .unity-base-text-field__input {
    min-height: 116px;
    padding: 0 28px;
    font-size: 46px;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-color: rgb(255, 246, 228);
    color: rgb(74, 30, 14);
}

.skin--basant .edit-profile .field {
    flex-direction: column;
    align-items: stretch;
    margin: 8px 10px;
}

.skin--basant .edit-profile__rule {
    margin: -2px 10px 8px 10px;
    font-size: 32px;
    -unity-text-align: middle-left;
    color: rgb(133, 89, 58);
}

.skin--basant .edit-profile .button--primary,
.skin--basant .edit-profile .button--primary:hover,
.skin--basant .edit-profile .button--primary:active {
    min-height: 150px;
    margin: 24px 20px 6px 20px;
    border-width: 0;
    font-size: 52px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.45px;
}

.skin--basant .edit-profile .status {
    font-size: 36px;
    -unity-text-align: middle-center;
    color: rgb(30, 130, 60);
}

/* ==================== Ranked, UI pass (design: Ranked) ==================== */

.skin--basant .ranked__card {
    align-items: center;
    margin: 90px 10px 22px 10px;
    padding: 110px 40px 36px 40px;
    border-width: 7px;
    border-color: rgb(30, 90, 150);
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    background-color: rgb(200, 226, 248);
    overflow: visible;
}

.skin--basant .ranked__medal {
    position: absolute;
    top: -110px;
    width: 220px;
    height: 220px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-grey.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .ranked__medal--gold { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-1.png"); }
.skin--basant .ranked__medal--silver { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-2.png"); }
.skin--basant .ranked__medal--bronze { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-3.png"); }

.skin--basant .settings .ranked__league {
    font-size: 96px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    color: rgb(96, 26, 26);
    -unity-text-outline-width: 0;
}

.skin--basant .settings .ranked__rating {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .ranked__bar {
    width: 90%;
    height: 54px;
    margin: 16px 0 8px 0;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
    background-color: rgb(214, 190, 160);
}

.skin--basant .ranked__fill {
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    background-color: rgb(40, 120, 220);
}

.skin--basant .settings .ranked__progress {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .settings .ranked__rules {
    margin: 0 10px 18px 10px;
    padding: 20px 26px;
    border-width: 4px;
    border-color: rgb(150, 110, 80);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-color: rgb(236, 220, 196);
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .settings .ranked__season {
    margin-bottom: 12px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

.skin--basant .ranked__ladder {
    margin: 0 10px 24px 10px;
    padding: 24px 30px;
    border-width: 7px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
    background-color: rgb(255, 238, 214);
}

.skin--basant .ranked__step {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    padding: 0 16px;
    border-bottom-width: 2px;
    border-color: rgba(74, 30, 14, 0.2);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.skin--basant .ranked__step--me {
    background-color: rgb(255, 225, 120);
}

.skin--basant .settings .ranked__step-name {
    width: auto;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .settings .ranked__step-detail {
    flex-grow: 0;
    flex-shrink: 1;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
    color: rgb(74, 30, 14);
}

.skin--basant .settings .ranked__play,
.skin--basant .settings .ranked__play:hover,
.skin--basant .settings .ranked__play:active {
    align-self: center;
    width: 70%;
    min-height: 170px;
    margin: 14px 0 24px 0;
    font-size: 64px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    background-size: 100% 150px;
}

/* ==================== Rulebook, UI pass (design: Rulebook) ==================== */

.skin--basant .rulebook__contents-scroll {
    flex-shrink: 0;
    height: 136px;
    margin: 0 0 14px 0;
}

.skin--basant .rulebook__contents {
    flex-direction: row;
    align-items: center;
}

.skin--basant .settings .rulebook__chip,
.skin--basant .settings .rulebook__chip:hover,
.skin--basant .settings .rulebook__chip:active {
    margin: 0 6px;
    min-height: 116px;
    padding: 0 34px;
    font-size: 40px;
    -unity-slice-scale: 0.86px;
}

.skin--basant .rulebook__section {
    padding: 34px 40px;
    margin: 0 10px 24px 10px;
}

.skin--basant .rulebook__section > .turn {
    min-height: 0;
    margin-bottom: 14px;
    padding: 0;
    font-size: 58px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-image: none;
}

.skin--basant .rulebook__line {
    margin-bottom: 16px;
    font-size: 44px;
    white-space: normal;
    color: rgb(74, 30, 14);
}

/* ==================== Phone, UI pass (design: Phone number) ==================== */

.skin--basant .phone__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-top: 120px;
}

.skin--basant .phone__plate {
    margin: 0 20px;
    padding: 60px 50px 56px 50px;
    border-width: 8px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-left-radius: 44px;
    border-bottom-right-radius: 44px;
    background-color: rgb(255, 238, 214);
}

.skin--basant .settings .phone__text {
    margin: 0 0 24px 0;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(96, 26, 26);
}

.skin--basant .phone__plate .field {
    flex-direction: column;
    align-items: stretch;
    margin: 0 0 30px 0;
}

.skin--basant .phone__plate .field > Label {
    margin-bottom: 10px;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(96, 26, 26);
}

.skin--basant .phone__plate .field TextInput,
.skin--basant .phone__plate .field .unity-base-text-field__input {
    min-height: 140px;
    font-size: 64px;
    border-width: 0;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-color: rgb(238, 220, 196);
}

.skin--basant .settings .phone__plate .button--primary,
.skin--basant .settings .phone__plate .button--primary:hover,
.skin--basant .settings .phone__plate .button--primary:active {
    min-height: 170px;
    margin: 6px 40px 0 40px;
    font-size: 66px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    background-size: 100% 150px;
}

/* ==================== First launch, UI pass (design: First launch) ==================== */

.skin--basant .gate {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.skin--basant .gate__plate {
    width: 900px;
    align-items: center;
    padding: 70px 56px 64px 56px;
    border-width: 9px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-bottom-right-radius: 50px;
    background-color: rgb(255, 238, 214);
}

.skin--basant .gate__picture {
    width: 400px;
    height: 240px;
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .gate__picture--cards {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/cards-fan.png");
}

.skin--basant .gate__title {
    font-size: 92px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(110, 26, 30);
}

.skin--basant .gate__line {
    margin: 6px 0 30px 0;
    font-size: 44px;
    -unity-text-align: middle-center;
    color: rgb(110, 62, 36);
}

.skin--basant .gate__name {
    width: 100%;
    margin: 0 0 26px 0;
}

.skin--basant .gate__name TextInput,
.skin--basant .gate__name .unity-base-text-field__input {
    min-height: 150px;
    font-size: 66px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 0;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 1.25px;
}

.skin--basant .gate__row {
    flex-direction: row;
    justify-content: center;
}

.skin--basant .gate__small,
.skin--basant .gate__small:hover,
.skin--basant .gate__small:active {
    min-height: 120px;
    margin: 0 12px;
    padding: 0 40px;
    border-width: 0;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.89px;
}

.skin--basant .gate__guard {
    margin-top: 14px;
    font-size: 38px;
    color: rgb(198, 40, 40);
}

.skin--basant .gate__go,
.skin--basant .gate__go:hover,
.skin--basant .gate__go:active {
    width: 80%;
    min-height: 170px;
    margin-top: 34px;
    border-width: 0;
    font-size: 70px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(110, 40, 12);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.48px;
}

.skin--basant .gate__answers {
    flex-direction: row;
    justify-content: center;
    margin-top: 44px;
}

.skin--basant .gate__round,
.skin--basant .gate__round:hover,
.skin--basant .gate__round:active {
    width: 330px;
    height: 330px;
    margin: 0 26px;
    padding: 40px;
    border-width: 0;
    border-radius: 0;
    white-space: normal;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(110, 26, 30);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-circle-outline-normal.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .gate__round:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-circle-outline-pressed.png");
}

.skin--basant .gate__round--yes,
.skin--basant .gate__round--yes:hover {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-circle-yellow-normal.png");
}

.skin--basant .gate__round--yes:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-circle-yellow-pressed.png");
}

/* ==================== Report, invite and tutorial, UI pass ==================== */

.skin--basant .report__list {
    width: 100%;
}

.skin--basant .report__reason,
.skin--basant .report__reason:hover,
.skin--basant .report__reason:active {
    min-height: 116px;
    margin: 6px 0;
    padding: 0 110px 0 36px;
    border-width: 3px;
    border-color: rgba(74, 30, 14, 0.25);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-color: rgb(250, 232, 210);
    background-image: none;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(74, 30, 14);
}

.skin--basant .report__reason--on,
.skin--basant .report__reason--on:hover {
    border-color: rgb(166, 30, 74);
    background-color: rgb(255, 222, 190);
}

.skin--basant .report__radio {
    position: absolute;
    right: 34px;
    top: 34px;
    width: 46px;
    height: 46px;
    border-width: 5px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .report__reason--on .report__radio {
    border-width: 13px;
    border-color: rgb(110, 26, 30);
}

.skin--basant .report__block {
    width: 100%;
    min-height: 116px;
    margin: 6px 0;
    padding: 0 30px 0 36px;
    flex-direction: row;
    align-items: center;
}

.skin--basant .report__send,
.skin--basant .report__send:hover,
.skin--basant .report__send:active {
    width: 70%;
    min-height: 150px;
    margin-top: 20px;
    border-width: 0;
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.42px;
}

/* Invite your group */

.skin--basant .invite-sheet__list {
    max-height: 760px;
}

.skin--basant .invite-row {
    flex-direction: row;
    align-items: center;
    min-height: 170px;
    margin: 8px 0;
    padding: 16px 26px;
    border-width: 4px;
    border-color: rgb(74, 30, 14);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .invite-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.skin--basant .invite-row__name {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .invite-row__state {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(133, 89, 58);
}

.skin--basant .invite-row__state--online {
    color: rgb(30, 130, 60);
}

.skin--basant .invite-row__button,
.skin--basant .invite-row__button:hover,
.skin--basant .invite-row__button:active {
    flex-grow: 0;
    min-width: 250px;
    margin: 0;
}

.skin--basant .invite-sheet__code,
.skin--basant .invite-sheet__code:hover,
.skin--basant .invite-sheet__code:active {
    letter-spacing: 3px;
}

/* Tutorial: ✕ to skip, the counter in the plate, no strip, mic, chat or menu */

.skin--basant .table--tutorial .quick-strip,
.skin--basant .table--tutorial .table__mic,
.skin--basant .table--tutorial .table__chat,
.skin--basant .table--tutorial .table__round {
    display: none;
}

.skin--basant .table__top .table__close,
.skin--basant .table__top .table__close:hover,
.skin--basant .table__top .table__close:active {
    width: 132px;
    min-width: 132px;
    padding: 0;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-normal.png");
    background-size: 124px 124px;
    background-position: center;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
}

.skin--basant .table__close .table__icon {
    left: 34px;
    top: 34px;
    width: 64px;
    height: 64px;
}

.skin--basant .table__icon--close { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-close.png"); }

/* Fixes from the first verification pass */

.skin--basant .mission {
    flex-direction: column;
    align-items: stretch;
}

.skin--basant .missions__heading {
    flex-grow: 1;
}

.skin--basant .settings .missions__swap,
.skin--basant .settings .missions__swap:hover,
.skin--basant .settings .missions__swap:active {
    min-width: 320px;
}

.skin--basant .settings .mission__claim,
.skin--basant .settings .mission__claim:hover,
.skin--basant .settings .mission__claim:active {
    min-width: 300px;
    padding: 0 30px;
    font-size: 36px;
}

/* Leaderboard: the top, segments and own row keep their height; only the list scrolls. */
.skin--basant .settings > .settings__top,
.skin--basant .settings > .segment-host,
.skin--basant .settings > .board__filters,
.skin--basant .settings > .board__me,
.skin--basant .settings > .board__ranked,
.skin--basant .settings > .friends__search,
.skin--basant .settings > .shop__tabs,
.skin--basant .settings > .rulebook__contents-scroll {
    flex-shrink: 0;
}

.skin--basant .settings > .settings__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.skin--basant .segment {
    flex-shrink: 0;
}

.skin--basant .board__ranked {
    min-height: 150px;
}

.skin--basant .board__ranked-text {
    min-width: 0;
}

/* The switch keeps its own box: a wrapping label measures to the full row and squeezed it to nothing. */
.skin--basant .unity-toggle > .unity-label {
    flex-basis: 0;
    min-width: 0;
}

.skin--basant .unity-toggle > .unity-toggle__input {
    width: 120px;
    min-width: 120px;
    height: 64px;
    margin-left: 16px;
    align-items: center;
    justify-content: center;
}

/* On is green on every switch, Settings included (an older Settings rule was more specific). */
.skin--basant .settings .unity-toggle .unity-toggle__checkmark,
.skin--basant .settings .unity-toggle:hover > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .settings .unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark {
    width: 132px;
    height: 68px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/switch-off.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .settings .unity-toggle:checked .unity-toggle__checkmark,
.skin--basant .settings .unity-toggle:checked:hover > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .settings .unity-toggle:checked:focus > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/switch-on-green.png");
}

.skin--basant .unity-toggle > .unity-toggle__input {
    width: 140px;
    min-width: 140px;
    height: 72px;
}

/* Long page titles step down instead of cutting ("Privacy and blocked players"). */
.skin--basant .settings .settings__top .top__title {
    -unity-text-auto-size: best-fit 44px 88px;
}

/* A watcher's pill says the whole line, on two rows when it must (design: Watching a table). */
.skin--basant .table--watching .table__status {
    height: auto;
    min-height: 116px;
    padding: 16px 30px 16px 40px;
}

.skin--basant .table--watching .table__status-text {
    white-space: normal;
    overflow: visible;
    font-size: 38px;
}

/* Results: the felt is the root's, so there is no seam at the notch; the panel takes the free height. */
.skin--basant .results {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    justify-content: flex-start;
    padding-top: 20px;
}

.skin--basant .results__panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.skin--basant .results__scroll {
    flex-grow: 1;
}

.skin--basant .lobby .lobby__seat-them,
.skin--basant .lobby .lobby__seat-them:hover,
.skin--basant .lobby .lobby__seat-them:active {
    height: 96px;
    padding: 0 30px;
    font-size: 36px;
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-normal.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-scale: 0.66px;
}

/* Ladder rows are lines inside one panel, not cards of their own. */
.skin--basant .ranked__ladder .ranked__step {
    margin-bottom: 0;
    background-image: none;
}

.skin--basant .ranked__ladder .ranked__step--me {
    background-image: none;
    background-color: rgb(255, 225, 120);
}

.skin--basant .settings .ranked__league {
    color: rgb(96, 26, 26);
}

/* Tutorial: the coach sits where the own-seat pill would, between the rug and the hand. */
.skin--basant .table--tutorial .table__status {
    display: none;
}

.skin--basant .table--tutorial .coach {
    bottom: 21%;
    left: 4%;
    right: 4%;
}

.skin--basant .coach .coach__text {
    font-size: 44px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

.skin--basant .chat-panel .chat-sheet__send,
.skin--basant .chat-panel .chat-sheet__send:hover,
.skin--basant .chat-panel .chat-sheet__send:active {
    min-width: 150px;
    color: rgba(0, 0, 0, 0);
}

.skin--basant .chat-panel__input TextInput,
.skin--basant .chat-panel__input .unity-base-text-field__input {
    color: rgb(74, 30, 14);
}

/* ==================== Accessibility: every control 132 px high, readable initials ==================== */

/* The tinted circles behind an initial are deep enough for white text at any size. */
.skin--basant .seat__avatar--a { -unity-background-image-tint-color: #7D3C98; background-color: #7D3C98; }
.skin--basant .seat__avatar--b { -unity-background-image-tint-color: #1F618D; background-color: #1F618D; }
.skin--basant .seat__avatar--c { -unity-background-image-tint-color: #A04000; background-color: #A04000; }
.skin--basant .seat__avatar--d { -unity-background-image-tint-color: #117864; background-color: #117864; }
.skin--basant .seat__avatar--e { -unity-background-image-tint-color: #922B21; background-color: #922B21; }
.skin--basant .seat__avatar--f { -unity-background-image-tint-color: #4D5656; background-color: #4D5656; }

.skin--basant .settings .friends__count {
    color: rgb(255, 255, 255);
}

/* Settings rows and the footer: the tap area is 132, the drawing stays as it was. */
.skin--basant .settings__group > .settings__row,
.skin--basant .settings__group > .settings__row:hover,
.skin--basant .settings__group > .settings__row:active {
    min-height: 132px;
}

.skin--basant .settings__footer,
.skin--basant .settings__footer:hover,
.skin--basant .settings__footer:active {
    min-height: 132px;
}

/* Small segments: 132 high, the pill art drawn inside. */
.skin--basant .mini-seg {
    height: 132px;
    background-size: 100% 104px;
}

.skin--basant .mini-seg__item,
.skin--basant .mini-seg__item:hover,
.skin--basant .mini-seg__item:active,
.skin--basant .mini-seg__item:focus {
    height: 132px;
    font-size: 34px;
}

.skin--basant .mini-seg__item--on,
.skin--basant .mini-seg__item--on:hover,
.skin--basant .mini-seg__item--on:active,
.skin--basant .mini-seg__item--on:focus {
    background-size: 100% 86px;
}

.skin--basant .settings__seg {
    height: 132px;
    background-size: 100% 92px;
}

.skin--basant .settings__seg .mini-seg__item--on {
    background-size: 100% 76px;
}

/* Chip rows (shop categories, rulebook contents): 132 high with the pill at its drawn size. */
.skin--basant .settings .shop__chip,
.skin--basant .settings .shop__chip:hover,
.skin--basant .settings .shop__chip:active,
.skin--basant .settings .rulebook__chip,
.skin--basant .settings .rulebook__chip:hover,
.skin--basant .settings .rulebook__chip:active {
    min-height: 132px;
    background-size: 100% 112px;
}

.skin--basant .shop__tabs,
.skin--basant .rulebook__contents-scroll {
    height: 140px;
}

.skin--basant .results__leave,
.skin--basant .results__leave:hover,
.skin--basant .results__leave:active {
    min-height: 132px;
}

.skin--basant .pass__claim,
.skin--basant .pass__claim:hover,
.skin--basant .pass__claim:active {
    bottom: -20px;
    height: 132px;
    min-height: 132px;
    background-size: 100% 64px;
    background-position: center;
}

/* Longer translations (pseudo-locale) fit: names before details, wider swap. */
.skin--basant .settings .ranked__step-name {
    flex-shrink: 0;
    margin-right: 16px;
}

.skin--basant .settings .missions__swap,
.skin--basant .settings .missions__swap:hover,
.skin--basant .settings .missions__swap:active {
    min-width: 370px;
}

/* Initials on the tinted circles are white on every list screen too. */
.skin--basant .settings .seat__initial,
.skin--basant .sheet .seat__initial {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* While the results show, the table under them is hidden (the overlay is see-through so the felt
   reaches under the notch). */
.skin--basant .table--results > .table__top,
.skin--basant .table--results > .table__gap,
.skin--basant .table--results > .table__zone,
.skin--basant .table--results > .table__strip,
.skin--basant .table--results > .table__bar,
.skin--basant .table--results > .hand,
.skin--basant .table--results > .coach,
.skin--basant .table--results > .recap {
    visibility: hidden;
}

/* First launch, owner's review 28 Oct: the plate wears the concept's wide magenta frame; the name
   and its two choices are soft flat pills so only Continue stands out. */
.skin--basant .gate__plate {
    width: 940px;
    padding: 64px 60px 60px 60px;
    border-width: 18px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 64px;
    border-top-right-radius: 64px;
    border-bottom-left-radius: 64px;
    border-bottom-right-radius: 64px;
