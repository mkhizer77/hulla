    width: 270px;
    height: 389px;
    rotate: 0;
}

.skin--basant .shop__art--sheet.shop__art--picture.shop__art--table {
    width: 470px;
    height: 470px;
}

.skin--basant .shop__art--sheet.shop__art--picture.shop__art--emotePack,
.skin--basant .shop__art--sheet.shop__art--picture.shop__art--voPack,
.skin--basant .shop__art--sheet.shop__art--picture.shop__art--celebration,
.skin--basant .shop__art--sheet.shop__art--picture.shop__art--soundSet {
    width: 360px;
    height: 360px;
}

/* A card face is shown as the king of hearts in that style, the card filling the art box. */
.skin--basant .shop__art--face {
    width: 144px;
    height: 202px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    rotate: -6deg;
}

.skin--basant .shop__art--face > .card {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
}

.skin--basant .shop__art--large.shop__art--face {
    width: 170px;
    height: 238px;
}

.skin--basant .shop__art--sheet.shop__art--face {
    width: 320px;
    height: 448px;
    rotate: 0;
}

/* The court band takes most of the card in the shop, so the portrait reads at tile size. */
.skin--basant .shop__art--face .card__field {
    left: 16px;
    right: 16px;
    top: 42px;
    bottom: 42px;
}

.skin--basant .shop__art--sheet.shop__art--face .card__field {
    left: 34px;
    right: 34px;
    top: 84px;
    bottom: 84px;
}

.skin--basant .shop__art--sheet.shop__art--face .card__rank {
    font-size: 64px;
}

.skin--basant .shop__art--sheet.shop__art--face .card__suit,
.skin--basant .shop__art--sheet.shop__art--face .card__index-suit {
    font-size: 46px;
}

.skin--basant .shop__art--sheet.shop__art--face .card__court {
    font-size: 150px;
}

/* Large index: the corner rank and suit about a third bigger, on the hand and in the shop. */
.skin--basant .shop__art--face.face--large-index .card__rank {
    font-size: 46px;
}

.skin--basant .shop__art--face.face--large-index .card__suit,
.skin--basant .shop__art--face.face--large-index .card__index-suit {
    font-size: 34px;
}

.skin--basant .shop__art--sheet.face--large-index .card__rank {
    font-size: 88px;
}

.skin--basant .shop__art--sheet.face--large-index .card__suit,
.skin--basant .shop__art--sheet.face--large-index .card__index-suit {
    font-size: 62px;
}

.skin--basant .face--large-index .hand .card__rank {
    font-size: 68px;
}

.skin--basant .face--large-index .hand .card__suit,
.skin--basant .face--large-index .hand .card__index-suit {
    font-size: 50px;
}

.skin--basant .cards--large .face--large-index .hand .card__rank {
    font-size: 78px;
}

.skin--basant .cards--large .face--large-index .hand .card__suit,
.skin--basant .cards--large .face--large-index .hand .card__index-suit {
    font-size: 58px;
}

/* Desi court: the jack, queen and king are portraits in a gold frame; the big letter steps aside. */
.skin--basant .card__court-art {
    border-width: 3px;
    border-color: rgb(201, 143, 16);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgb(255, 246, 228);
}

.skin--basant .card__court-face {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .card__court-art--j .card__court-face { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Shop/court_jack.png"); }
.skin--basant .card__court-art--q .card__court-face { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Shop/court_queen.png"); }
.skin--basant .card__court-art--k .card__court-face { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Shop/court_king.png"); }

.skin--basant .face--desi .card--court .card__court {
    color: rgba(0, 0, 0, 0);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
}

/* The thulla giver's celebration bursts behind the stamp (ThullaTableView.ShowStamp). */
.skin--basant .stamp-burst {
    position: absolute;
    width: 460px;
    height: 460px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ==================== Lobby chat bar, owner message 29 Oct ==================== */
/* The bar ends before the buttons with a small gap; the mic stands right beside the chat button.
   The buttons are 136 wide with a 100 px face 16 px in: faces 16 px apart, the bar 24 px short of the mic. */
.skin--basant .lobby .lobby__strip {
    width: 726px;
}

.skin--basant .lobby .lobby__strip-text {
    width: 640px;
    -unity-text-auto-size: best-fit 30px 40px;
}

.skin--basant .lobby .lobby__mic {
    left: 734px;
}

.skin--basant .lobby .lobby__chat {
    left: 850px;
}

/* ==================== First-rounds tip, owner message 29 Oct ==================== */
/* A compact card above your own face, never over it: the words on the left, Got it inside on the right.
   The tutorial keeps its speech bubble (restored below). */
.skin--basant .table .coach {
    top: auto;
    bottom: 700px;
    left: 5%;
    right: 5%;
    flex-direction: row;
    align-items: center;
    padding: 28px 30px 28px 40px;
    border-width: 5px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
}

.skin--basant .table .coach .coach__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 24px 0 0;
    font-size: 38px;
    -unity-text-align: middle-left;
}

.skin--basant .table .coach .coach__tail {
    display: none;
}

.skin--basant .table .coach .button--primary,
.skin--basant .table .coach .button--primary:hover,
.skin--basant .table .coach .button--primary:active {
    flex-shrink: 0;
    align-self: center;
    min-width: 200px;
    min-height: 96px;
    margin: 0;
    padding: 0 34px;
