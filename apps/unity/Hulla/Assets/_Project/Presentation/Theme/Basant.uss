    border-top-left-radius: 52px;
    border-top-right-radius: 52px;
    border-bottom-left-radius: 52px;
    border-bottom-right-radius: 52px;
}

.skin--basant .table--tutorial .coach .coach__text {
    margin: 0;
    font-size: 44px;
    -unity-text-align: middle-center;
}

.skin--basant .table--tutorial .coach .coach__tail {
    display: flex;
}

.skin--basant .table--tutorial .coach .button--primary,
.skin--basant .table--tutorial .coach .button--primary:hover,
