}

.skin--basant .segment__item,
.skin--basant .segment__item:hover,
.skin--basant .segment__item:active {
    font-size: 44px;
}

.skin--basant .settings .field > Label {
    font-size: 36px;
}

.skin--basant .settings .field TextInput,
.skin--basant .settings .field .unity-base-text-field__input {
    min-height: 112px;
    padding: 0 28px;
    font-size: 46px;
}

/* ---------- Toggles: the switch at the row's right edge, green when on, unchanged by focus ---------- */

.skin--basant .unity-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 46px;
    color: rgb(74, 30, 14);
    white-space: normal;
}

.skin--basant .unity-toggle > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-end;
}

.skin--basant .unity-toggle .unity-toggle__checkmark,
.skin--basant .unity-toggle:hover > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .unity-toggle:active > .unity-toggle__input > .unity-toggle__checkmark {
    width: 110px;
    height: 58px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/switch-off.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .unity-toggle:checked .unity-toggle__checkmark,
.skin--basant .unity-toggle:checked:hover > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .unity-toggle:checked:focus > .unity-toggle__input > .unity-toggle__checkmark,
.skin--basant .unity-toggle:checked:active > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/switch-on-green.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Every screen is transparent over the root's scene (the older skin painted a menu picture on each). */
.skin--basant .screen {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

/* ---------- Home: long names, the claimed reward and its pop ---------- */

.skin--basant .home .home__name--long {
    font-size: 38px;
}

.skin--basant .home .home__name--longer {
    font-size: 32px;
}

.skin--basant .home .home__daily--done .home__gift {
    opacity: 0.55;
}

.skin--basant .home .daily-pop {
    left: 60px;
    top: -10px;
    width: 300px;
    height: 70px;
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(255, 210, 63);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(122, 58, 10);
    -unity-text-align: middle-center;
    opacity: 1;
    translate: 0 0;
    transition-property: translate, opacity;
    transition-duration: 1.3s, 1.3s;
    transition-timing-function: ease-out, ease-in;
}

.skin--basant .home .daily-pop--up {
    translate: 0 -120px;
    opacity: 0;
}

/* ---------- Join by code sheet ---------- */

.skin--basant .join-sheet__boxes {
