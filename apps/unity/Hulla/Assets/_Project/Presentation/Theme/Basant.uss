.skin--basant TextInput,
.skin--basant .unity-base-text-field__input {
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

/* ---------- Top bar: the title centred, one button each side ---------- */

.skin--basant .settings__top {
    position: relative;
    height: 148px;
    min-height: 148px;
    margin-bottom: 20px;
    flex-direction: row;
    justify-content: center;
