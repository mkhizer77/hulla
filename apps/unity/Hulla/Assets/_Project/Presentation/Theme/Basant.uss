/* ==================== Shared kit classes (docs/design/basant-lobby.md) ==================== */
/* Every stage screen after the lobby uses these: the holder and stage, round buttons with an icon,
   the cream panel, the progress bar and the seat medallions. */

.skin--basant .kit__holder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.skin--basant .kit__stage {
    width: 1080px;
    height: 1936px;
    flex-shrink: 0;
    transform-origin: center;
}

.skin--basant .kit__stage > *,
.skin--basant .kit__face,
.skin--basant .kit__face > * {
    position: absolute;
}

.skin--basant .kit__stage .unity-button,
.skin--basant .kit__stage .unity-button:hover,
.skin--basant .kit__stage .unity-button:active,
.skin--basant .kit__stage .unity-button:focus {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .kit__stage Label {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.skin--basant .kit__round {
    width: 136px;
    height: 136px;
}

.skin--basant .kit__round .kit__face {
    left: 6px;
    top: 6px;
    width: 124px;
    height: 124px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-normal.png");
}

.skin--basant .kit__round:active .kit__face {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-pressed.png");
}

.skin--basant .kit__round .kit__icon {
    left: 30px;
    top: 30px;
    width: 64px;
    height: 64px;
}

.skin--basant .kit__icon {
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .kit__icon--close { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-close.png"); }
.skin--basant .kit__icon--back { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-back.png"); }
.skin--basant .kit__icon--book { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-book.png"); }
.skin--basant .kit__icon--more { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-more.png"); }
.skin--basant .kit__icon--tick { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-tick.png"); }
.skin--basant .kit__icon--pencil { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-pencil.png"); }
.skin--basant .kit__icon--plus { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-plus.png"); }
.skin--basant .kit__icon--share { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-share.png"); }
.skin--basant .kit__icon--copy { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-copy.png"); }
.skin--basant .kit__icon--mic { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-mic.png"); }
.skin--basant .kit__icon--mic-off { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-mic-off.png"); }
.skin--basant .kit__icon--chat { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-chat.png"); }
.skin--basant .kit__icon--search { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-search.png"); }
.skin--basant .kit__icon--eye { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-eye.png"); }
.skin--basant .kit__icon--refresh { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-refresh.png"); }

.skin--basant .kit__panel {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .kit__panel > * {
    position: absolute;
}

.skin--basant .kit__bar {
    height: 60px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-track.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-scale: 0.238px;
    overflow: hidden;
}

.skin--basant .kit__bar-fill {
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    min-width: 48px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-fill.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-scale: 0.15px;
}

.skin--basant .kit__medal {
    width: 150px;
    height: 150px;
    margin: 0 15px;
    overflow: visible;
    opacity: 0.55;
}

.skin--basant .kit__medal > * {
    position: absolute;
}

.skin--basant .kit__medal--on {
    opacity: 1;
}

.skin--basant .kit__medal--3 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/medal-seat-3.png"); }
.skin--basant .kit__medal--4 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/medal-seat-4.png"); }
.skin--basant .kit__medal--5 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/medal-seat-5.png"); }
.skin--basant .kit__medal--6 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/medal-seat-6.png"); }

.skin--basant .kit__medal Label {
    left: 35px;
    top: 35px;
    width: 80px;
    height: 80px;
    font-size: 76px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
}

.skin--basant .kit__medal-ring {
    left: -7px;
    top: -7px;
    width: 164px;
    height: 164px;
    display: none;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/ring-seat-selected.png");
}

.skin--basant .kit__medal--on .kit__medal-ring {
    display: flex;
}

/* ==================== Quick Play ==================== */

.skin--basant .quick.screen {
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .quick__close {
    left: 30px;
    top: 40px;
}

.skin--basant .quick__panel {
    left: 98px;
    top: 491px;
    width: 884px;
    height: 982px;
}

.skin--basant .quick__faces {
    left: 0;
    right: 0;
    top: 80px;
    height: 164px;
    flex-direction: row;
    justify-content: center;
}

.skin--basant .quick__seat {
    width: 164px;
    height: 164px;
    margin: 0 16px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/seat-empty.png");
}

.skin--basant .quick__title {
    left: 40px;
    top: 300px;
    width: 804px;
    height: 80px;
    font-size: 60px;
    -unity-text-auto-size: best-fit 36px 60px;
}

.skin--basant .quick__elapsed {
    left: 40px;
    top: 400px;
    width: 804px;
    height: 48px;
    font-size: 38px;
    color: rgb(176, 48, 84);
}

.skin--basant .quick__bar {
    left: 92px;
    top: 520px;
    width: 700px;
}

.skin--basant .quick__seats-label {
    left: 40px;
    top: 660px;
    width: 804px;
    height: 42px;
    font-size: 38px;
}

.skin--basant .quick__seats {
    left: 0;
    right: 0;
    top: 730px;
    height: 150px;
    flex-direction: row;
    justify-content: center;
}

.skin--basant .quick__status {
    left: 40px;
    top: 900px;
    width: 804px;
    height: 48px;
    font-size: 30px;
    white-space: normal;
    color: rgb(120, 56, 20);
}

/* ==================== Table (docs/design/basant-play.md) ==================== */
/* The table keeps its responsive frame (seat ring, trick pile, fanned hand); the kit dresses it. */

.skin--basant .table {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .table__zone > .rail {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Lobby/rug-table.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .felt {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .table Label,
.skin--basant .table .unity-button {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
}

.skin--basant .table__pill,
.skin--basant .table__pill:hover,
.skin--basant .table__pill:active {
    min-width: 160px;
    height: 80px;
    padding: 0 30px;
    border-width: 0;
    border-radius: 0;
    font-size: 32px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.59px;
}

.skin--basant .table__pill:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-pressed.png");
}

.skin--basant .table__pill Label {
    color: rgb(74, 30, 14);
}

.skin--basant .table__info {
    min-width: 240px;
    height: 80px;
    padding: 0 40px;
    font-size: 36px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.667px;
}

.skin--basant .table__info Label {
    color: rgb(74, 30, 14);
}

/* Seats */

.skin--basant .seat__avatar {
    border-width: 0;
    background-color: rgb(238, 150, 120);
}

.skin--basant .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/frame-friend.png");
}

.skin--basant .me-badge .seat__frame,
.skin--basant .seat--me .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/frame-avatar-gold.png");
}

.skin--basant .seat--turn .seat__avatar {
    border-width: 0;
}

.skin--basant .seat--turn .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/ring-turn-glow.png");
}

.skin--basant .seat__name {
    margin-top: 10px;
    min-width: 170px;
    height: 56px;
    padding: 0 26px;
    font-size: 32px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.467px;
}

.skin--basant .seat--turn .seat__name {
    color: rgb(74, 30, 14);
}

.skin--basant .seat__chip {
    right: -24px;
    bottom: -8px;
    width: 60px;
    height: 60px;
    padding: 0;
    border-width: 0;
    justify-content: center;
    border-radius: 30px;
    background-color: rgb(192, 52, 96);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/badge-count.png");
}

.skin--basant .seat__back {
    display: none;
}

.skin--basant .seat__count {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    font-size: 30px;
    -unity-text-align: middle-center;
    background-color: rgb(190, 40, 50);
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(74, 30, 14);
}

.skin--basant .seat__state {
    margin-top: 6px;
    height: 44px;
    padding: 0 20px;
    font-size: 24px;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-grey.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-scale: 0.543px;
}

.skin--basant .seat__state--lead {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-yellow.png");
}

.skin--basant .seat__state--ready,
.skin--basant .seat__state--out {
    color: rgb(255, 255, 255);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-green.png");
    -unity-slice-scale: 0.454px;
}

.skin--basant .seat__crown {
    top: -62px;
    height: 70px;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/crown-host.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .seat__void {
    color: rgb(74, 30, 14);
    background-color: rgba(255, 243, 218, 0.9);
}

.skin--basant .seat__back,
.skin--basant .discard__card,
.skin--basant .game__back {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Table/card-back.png");
}

/* The bottom strip: the turn pill, quick chat, the round mic and chat */

.skin--basant .turn,
.skin--basant .turn--mine {
    min-height: 90px;
    padding: 0 40px;
    font-size: 34px;
    color: rgb(255, 243, 218);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Table/plate-turn.png");
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-scale: 0.223px;
}

.skin--basant .me-badge,
.skin--basant .me-badge .seat__name {
    background-image: none;
    color: rgb(74, 30, 14);
}

.skin--basant .me-badge .seat__name {
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
}

.skin--basant .me-badge .seat__avatar {
    border-width: 6px;
    border-color: rgb(250, 184, 36);
}

.skin--basant .quick-strip__chip,
.skin--basant .quick-strip__more,
.skin--basant .quick-strip__chip:hover,
.skin--basant .quick-strip__chip:active {
    min-height: 80px;
    padding: 0 28px;
    border-width: 0;
    font-size: 30px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.59px;
}

.skin--basant .table__chat,
.skin--basant .table__mic,
.skin--basant .table__chat:hover,
.skin--basant .table__mic:hover,
.skin--basant .table__chat:active,
.skin--basant .table__mic:active {
    width: 100px;
    height: 100px;
    min-width: 100px;
    padding: 0;
    border-width: 0;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-normal.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.skin--basant .table__chat:active,
.skin--basant .table__mic:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-pressed.png");
}

.skin--basant .table__icon {
    position: absolute;
    left: 24px;
    top: 22px;
    width: 52px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .table__icon--chat { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-chat.png"); }
.skin--basant .table__icon--mic { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-mic.png"); }
.skin--basant .table__mic--off .table__icon--mic { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/icon-mic-off.png"); }

.skin--basant .hint {
    color: rgb(255, 243, 218);
    background-color: rgb(74, 30, 14);
}

.skin--basant .bubble {
    background-color: rgb(255, 243, 218);
    color: rgb(74, 30, 14);
}

/* ==================== Results ==================== */

.skin--basant .results {
    background-color: rgb(18, 74, 48);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Backdrops/felt.png");
    -unity-background-scale-mode: scale-and-crop;
}

.skin--basant .results__panel {
    padding: 40px 36px 30px 36px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .podium {
    margin-top: 10px;
    margin-bottom: 16px;
    align-items: flex-end;
}

.skin--basant .podium__stand {
    flex-direction: row;
    align-items: flex-end;
    overflow: visible;
}

.skin--basant .podium__steps {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 304px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Table/podium.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .podium__place--1 { padding-bottom: 184px; }
.skin--basant .podium__place--2 { padding-bottom: 53px; }
.skin--basant .podium__place--3 { padding-bottom: 20px; }

.skin--basant .podium__place--loser {
    margin-left: 0;
    padding-bottom: 0;
}

.skin--basant .podium__avatar {
    border-width: 5px;
    border-color: rgb(255, 243, 218);
}

.skin--basant .podium__place--1 .podium__avatar {
    border-color: rgb(250, 184, 36);
}

.skin--basant .podium__place--loser .podium__avatar {
    border-color: rgb(200, 48, 48);
    opacity: 0.8;
}

.skin--basant .podium__rank {
    height: 44px;
    padding: 0 18px;
    margin-top: 6px;
    font-size: 24px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-yellow.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-scale: 0.543px;
}

.skin--basant .podium__name {
    height: 52px;
    padding: 0 22px;
    font-size: 28px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-name.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.433px;
}

.skin--basant .results__loser {
    flex-direction: column;
}

.skin--basant .results__title {
    font-size: 64px;
    color: rgb(255, 210, 63);
    text-shadow: 0 5px 0 rgb(122, 58, 10);
}

.skin--basant .results__stamp {
    position: absolute;
    right: 0;
    top: -56px;
    width: 260px;
    height: 119px;
    margin: 0;
    padding: 0;
    rotate: 0;
    border-width: 0;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Table/stamp-bhabhi.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .result-reward {
    padding: 0;
    font-size: 38px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .results__order {
    padding: 18px 30px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/plate-label.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 120;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 0.3px;
}

.skin--basant .results__order .settings__heading {
    color: rgb(176, 48, 84);
}

.skin--basant .results__order .rulebook__line {
    color: rgb(74, 30, 14);
}

.skin--basant .results .chip,
.skin--basant .results .chip--fair {
    min-height: 76px;
    padding: 0 28px;
    border-width: 0;
    font-size: 28px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.56px;
}

.skin--basant .results__play,
.skin--basant .results__play:hover,
.skin--basant .results__play:active {
    height: 140px;
    border-width: 0;
    border-radius: 0;
    font-size: 56px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.583px;
}

.skin--basant .results__play:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-pressed.png");
}

.skin--basant .results__quiet .button,
.skin--basant .results__quiet .button:hover,
.skin--basant .results__quiet .button:active {
    min-width: 260px;
    height: 90px;
    border-width: 0;
    border-radius: 0;
    font-size: 32px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.667px;
}

.skin--basant .results__quiet .button--secondary {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 92, 96);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-teal-normal.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.596px;
}

.skin--basant .results .status {
    color: rgb(120, 56, 20);
}

/* ==================== Tab and list screens (docs/design/basant-tabs.md) ==================== */
/* Friends, Trophies (Missions, Achievements, Leaderboard), Shop, Pass, Profile, Settings, Ranked and
   the rest share the "settings" list frame: the calm sky, the title in the lettered face, round icon
   buttons, the segmented control, cream row cards, pill chips and the bar. */

.skin--basant .settings.screen {
    padding: 24px 36px 0 36px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .settings Label,
.skin--basant .settings .unity-button,
.skin--basant .settings TextInput {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
}

.skin--basant .settings__top {
    min-height: 132px;
    margin-bottom: 16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.skin--basant .settings .settings__top .title {
    flex-grow: 1;
    font-size: 76px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: rgb(255, 210, 63);
    text-shadow: 0 5px 0 rgb(122, 58, 10);
}

/* The top-bar buttons are round icons: back, done, add. The word stays for a screen reader. */
.skin--basant .settings .settings__top .button,
.skin--basant .settings .settings__top .button:hover,
.skin--basant .settings .settings__top .button:active {
    width: 132px;
    height: 132px;
    min-height: 132px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-normal.png");
    background-size: 124px 124px;
    background-position: center;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.skin--basant .settings .settings__top .button:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-pressed.png");
}

.skin--basant .settings .settings__top .button > .kit__icon {
    position: absolute;
    left: 34px;
    top: 34px;
    width: 64px;
    height: 64px;
}

.skin--basant .settings__top #back {
    flex-direction: row;
}

.skin--basant .segment-host {
    margin-bottom: 20px;
}

.skin--basant .segment {
    height: 132px;
    flex-direction: row;
    padding: 0 10px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/segment-track.png");
    background-size: 100% 104px;
    background-position: center;
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.5px;
}

.skin--basant .segment__item,
.skin--basant .segment__item:hover,
.skin--basant .segment__item:active {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    font-size: 34px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .segment__item--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/segment-on.png");
    background-size: 100% 88px;
    background-position: center;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-scale: 0.33px;
}

.skin--basant .settings__heading {
    margin: 28px 0 12px 12px;
    font-size: 34px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--basant .caption {
    font-size: 28px;
    color: rgb(133, 89, 58);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--basant .status {
    color: rgb(120, 56, 20);
}

/* Rows */

.skin--basant .lobby-seat,
.skin--basant .settings__row,
.skin--basant .leaderboard__row {
    min-height: 150px;
    flex-shrink: 0;
    padding: 22px 36px;
    margin-bottom: 18px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .leaderboard__row--me {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row-yellow.png");
}

.skin--basant .lobby-seat__name > Label,
.skin--basant .settings__row > Label,
.skin--basant .settings__row Label,
.skin--basant .leaderboard__name {
    font-size: 38px;
    color: rgb(74, 30, 14);
}

.skin--basant .lobby-seat__name > .caption {
    font-size: 28px;
    color: rgb(133, 89, 58);
}

.skin--basant .leaderboard__points {
    font-size: 36px;
    color: rgb(74, 30, 14);
}

.skin--basant .leaderboard__rank {
    width: 96px;
    height: 80px;
    font-size: 36px;
    color: rgb(74, 30, 14);
    -unity-text-align: middle-center;
}

.skin--basant .leaderboard__rank--1,
.skin--basant .leaderboard__rank--2,
.skin--basant .leaderboard__rank--3 {
    color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .leaderboard__rank--1 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-1.png"); }
.skin--basant .leaderboard__rank--2 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-2.png"); }
.skin--basant .leaderboard__rank--3 { background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-rank-3.png"); }

.skin--basant .leaderboard__me {
    margin-bottom: 12px;
    padding: 0;
    background-image: none;
}

/* Chips and buttons */

.skin--basant .settings .chip,
.skin--basant .settings .chip:hover,
.skin--basant .settings .chip:active {
    min-height: 132px;
    margin: -14px 6px;
    padding: 0 30px;
    background-size: 100% 80px;
    background-position: center;
    border-width: 0;
    border-radius: 0;
    font-size: 30px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.59px;
}

.skin--basant .settings .chip:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-pressed.png");
}

.skin--basant .settings .chip--on,
.skin--basant .settings .chip--on:hover,
.skin--basant .settings .chip--on:active {
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-normal.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-scale: 0.71px;
}

.skin--basant .settings .chip--on:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-join-small-pressed.png");
}

.skin--basant .settings .tag--ok {
    height: 46px;
    padding: 0 20px;
    font-size: 26px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tag-green.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-scale: 0.474px;
}

.skin--basant .settings .button,
.skin--basant .settings .button:hover,
.skin--basant .settings .button:active {
    min-height: 132px;
    background-size: 100% 96px;
    background-position: center;
    border-width: 0;
    border-radius: 0;
    font-size: 34px;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.71px;
}

.skin--basant .settings .button:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-pressed.png");
}

.skin--basant .settings .button--primary,
.skin--basant .settings .button--primary:hover,
.skin--basant .settings .button--primary:active {
    min-height: 132px;
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
    background-size: 100% 120px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.5px;
}

.skin--basant .settings .button--primary:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-pressed.png");
}

.skin--basant .settings .button--secondary,
.skin--basant .settings .button--secondary:hover,
.skin--basant .settings .button--secondary:active {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 92, 96);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-teal-normal.png");
    -unity-slice-left: 100;
    -unity-slice-right: 100;
    -unity-slice-scale: 0.636px;
}

.skin--basant .settings .button--danger {
    color: rgb(198, 40, 40);
}

/* Progress */

.skin--basant .meter {
    height: 40px;
    margin-top: 12px;
    border-radius: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-track.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-scale: 0.159px;
}

.skin--basant .meter__fill {
    position: absolute;
    left: 4px;
    top: 4px;
    bottom: 4px;
    min-width: 32px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-fill-green.png");
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-scale: 0.1px;
}

.skin--basant .meter--full > .meter__fill {
    background-color: rgba(0, 0, 0, 0);
}

/* Fields, toggles and sliders */

.skin--basant .settings .field > Label {
    color: rgb(133, 89, 58);
}

.skin--basant .settings .field TextInput,
.skin--basant .settings .field .unity-base-text-field__input {
    border-width: 4px;
    border-radius: 24px;
    border-color: rgb(74, 30, 14);
    background-color: rgb(255, 243, 218);
    color: rgb(74, 30, 14);
}

.skin--basant .settings .unity-toggle__checkmark {
    width: 100px;
    height: 52px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/switch-off.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .settings .unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/switch-on.png");
}

.skin--basant .settings .unity-base-slider__tracker {
    height: 24px;
    margin-top: -12px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/bar-track.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-scale: 0.095px;
}

.skin--basant .settings .unity-base-slider__dragger {
    width: 56px;
    height: 56px;
    margin-top: -28px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/knob-slider.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Panels */

.skin--basant .settings .panel,
.skin--basant .settings .code-box {
    border-width: 0;
    padding: 40px 36px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .settings .code {
    font-size: 96px;
    letter-spacing: 6px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    color: rgb(255, 210, 63);
    text-shadow: 0 5px 0 rgb(122, 58, 10);
}

.skin--basant .settings .title--small {
    font-size: 48px;
}

/* Achievements and the pass */

.skin--basant .achievement__medal {
    width: 110px;
    height: 110px;
    margin-right: 24px;
    flex-shrink: 0;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-gold.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .achievement--locked {
    opacity: 1;
}

.skin--basant .achievement--locked .achievement__medal {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/medal-grey.png");
}

.skin--basant .achievement--locked Label {
    color: rgb(133, 89, 58);
}

.skin--basant .pass__header {
    margin-bottom: 20px;
}

.skin--basant .pass__row {
    min-height: 140px;
    margin-bottom: 18px;
    padding: 16px 24px;
    border-width: 0;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/card-row.png");
    -unity-slice-left: 90;
    -unity-slice-right: 90;
    -unity-slice-top: 70;
    -unity-slice-bottom: 90;
    -unity-slice-scale: 0.3px;
}

.skin--basant .pass__row--ahead {
    opacity: 0.7;
}

.skin--basant .pass__tier {
    width: 90px;
    height: 56px;
    align-self: center;
    margin-right: 16px;
    font-size: 32px;
    color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/tier-cell-on.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .pass__side--premium {
    border-left-width: 4px;
    border-color: rgb(192, 52, 96);
    background-color: rgba(192, 52, 96, 0.06);
}

.skin--basant .pass__reward {
    font-size: 28px;
}

/* Shop */

.skin--basant .shop__balances {
    font-size: 34px;
    color: rgb(74, 30, 14);
}

.skin--basant .shop__swatch {
    border-color: rgb(74, 30, 14);
}

.skin--basant .rarity--rare { color: rgb(23, 119, 170); }
.skin--basant .rarity--epic { color: rgb(146, 58, 170); }
.skin--basant .rarity--legendary { color: rgb(192, 52, 96); }

/* ==================== Panels, dialogs, sheets and the coach ==================== */

.skin--basant .panel,
.skin--basant .game {
    padding: 40px 36px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/panel-cream.png");
    -unity-slice-left: 170;
    -unity-slice-right: 170;
    -unity-slice-top: 170;
    -unity-slice-bottom: 170;
    -unity-slice-scale: 0.3px;
}

.skin--basant .overlay {
    background-color: rgba(40, 20, 30, 0.55);
}

.skin--basant .dialog__text,
.skin--basant .coach__text,
.skin--basant .dialog Label {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--basant .dialog__text {
    font-size: 44px;
    -unity-text-align: middle-center;
}

.skin--basant .dialog__button,
.skin--basant .dialog__button:hover,
.skin--basant .dialog__button:active,
.skin--basant .coach .button,
.skin--basant .coach .button:hover {
    min-height: 100px;
    border-width: 0;
    border-radius: 0;
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    color: rgb(74, 30, 14);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-pill-normal.png");
    -unity-slice-left: 130;
    -unity-slice-right: 130;
    -unity-slice-scale: 0.74px;
}

.skin--basant .dialog__button.button--primary,
.skin--basant .dialog__button.button--primary:hover,
.skin--basant .coach .button--primary,
.skin--basant .coach .button--primary:hover {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(74, 30, 14);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.417px;
}

.skin--basant .dialog__button.button--danger,
.skin--basant .dialog__button.button--danger:hover {
