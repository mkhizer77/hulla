    text-overflow: ellipsis;
    overflow: hidden;
    -unity-text-align: middle-center;
}

.skin--basant .settings .settings__top--start .top__title {
    left: 160px;
    right: 0;
    -unity-text-align: middle-left;
}

.skin--basant .settings__top .top__button,
.skin--basant .settings__top .top__button:hover,
