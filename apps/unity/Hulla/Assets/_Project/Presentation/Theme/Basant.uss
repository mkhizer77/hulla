    -unity-slice-bottom: 0;
}

.skin--basant .settings__top .top__button:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/btn-round-pressed.png");
}

.skin--basant .settings__top .top__left { left: 0; }
.skin--basant .settings__top .top__right { right: 0; }
.skin--basant .settings__top .top__hidden { display: none; }

.skin--basant .settings__top .top__button > .kit__icon {
    position: absolute;
    left: 34px;
    top: 34px;
