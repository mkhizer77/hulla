}

.skin--basant .results .podium__col--loser .podium__block {
    height: 150px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Results/podium-loser.png");
}

.skin--basant .results .podium__col .podium__avatar {
    margin-bottom: -26px;
}

/* Gold, silver and bronze tags with a notch, the place written on them. */
.skin--basant .results .podium__block .podium__rank {
    width: 128px;
    height: 80px;
    padding: 12px 0 0 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Results/rank-gold.png");
    -unity-background-scale-mode: stretch-to-fill;
    font-size: 38px;
    -unity-text-align: middle-center;
    color: rgb(62, 26, 12);
}

.skin--basant .results .podium__col--1 .podium__rank { background-color: rgba(0, 0, 0, 0); }

.skin--basant .results .podium__col--2 .podium__rank {
    height: 74px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Results/rank-silver.png");
    color: rgb(40, 44, 58);
}

.skin--basant .results .podium__col--3 .podium__rank {
    height: 76px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Results/rank-bronze.png");
    color: rgb(255, 244, 230);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(96, 40, 14);
}

.skin--basant .results .podium__block .podium__name {
    width: 92%;
    height: 66px;
    padding: 0 6px;
    font-size: 38px;
    border-width: 4px;
    background-color: rgb(255, 250, 240);
}

.skin--basant .results .podium__col--loser .results__stamp {
    left: -14px;
    top: 96px;
}

/* The middle: headline, reward, level bar, highlights and the friend chips; no plate behind them. */
.skin--basant .results .results__order {
    padding: 0;
    background-image: none;
}

.skin--basant .results .results__title {
    margin: 22px 10px 0 10px;
    font-size: 68px;
}

.skin--basant .results .result-reward {
    margin: 4px 0 18px 0;
    padding: 0;
    min-height: 0;
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(62, 26, 12);
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.skin--basant .results .results__level {
    height: 70px;
    margin: 0 36px 22px 36px;
}

.skin--basant .results .results__level-text {
    font-size: 40px;
}

.skin--basant .results .results__highlights {
    margin: 0 36px 20px 36px;
    padding: 18px 24px;
    background-color: rgb(238, 220, 200);
}

.skin--basant .results .results__highlight {
    font-size: 34px;
    color: rgb(96, 26, 26);
}

.skin--basant .results .results__friends {
    margin: 0 20px;
}

.skin--basant .results .results__new-here {
    font-size: 38px;
    color: rgb(62, 26, 12);
}

.skin--basant .results .results__friends .chip,
.skin--basant .results .results__friends .chip:hover,
.skin--basant .results .results__friends .chip:active {
    height: 88px;
    min-height: 88px;
    margin: 6px 8px;
    padding: 0 26px;
    font-size: 38px;
    color: rgb(74, 30, 14);
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: rgb(176, 120, 96);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-left-radius: 44px;
    border-bottom-right-radius: 44px;
}

/* The bottom: the big Play again, then Change rules, Fair deal and Share in one row, Leave underlined. */
.skin--basant .results .results__again {
    margin: 24px 30px 0 30px;
}

.skin--basant .results .results__quiet {
    flex-direction: row;
    justify-content: center;
    margin: 22px 30px 0 30px;
}

.skin--basant .results .results__quiet .button,
.skin--basant .results .results__quiet .button:hover,
.skin--basant .results .results__quiet .button:active {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 124px;
    margin: 0 8px;
    padding: 0 20px;
    font-size: 46px;
}

.skin--basant .results .results__quiet .results__share,
.skin--basant .results .results__quiet .results__share:hover,
.skin--basant .results .results__quiet .results__share:active {
    flex-grow: 0;
    width: 124px;
    min-width: 124px;
    background-size: 100% 100%;
}

.skin--basant .results .results__share-icon {
    left: 30px;
    top: 30px;
}

.skin--basant .results .results__leave,
.skin--basant .results .results__leave:hover,
.skin--basant .results .results__leave:active {
    margin-top: 20px;
    font-size: 50px;
    color: rgb(255, 236, 190);
}

.skin--basant .results .results__leave-text {
    margin: 0;
    padding: 0 0 2px 0;
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(255, 236, 190);
    border-bottom-width: 4px;
    border-color: rgb(255, 236, 190);
}

/* Headings and lines under the highlights (who left, the series, the escape order) centred and quiet. */
.skin--basant .results .results__order .settings__heading,
.skin--basant .results .results__order .rulebook__line {
    margin: 4px 20px;
    font-size: 34px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(110, 60, 44);
}


