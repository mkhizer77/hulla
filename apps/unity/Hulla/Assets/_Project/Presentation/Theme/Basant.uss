}

.skin--basant .shop__art--large.shop__art--picture.shop__art--table,
.skin--basant .shop__art--large.shop__art--picture.shop__art--emotePack,
.skin--basant .shop__art--large.shop__art--picture.shop__art--voPack,
.skin--basant .shop__art--large.shop__art--picture.shop__art--celebration,
