}

.skin--basant .lobby-seat__name > Label,
.skin--basant .settings__row > Label,
.skin--basant .settings__row Label,
.skin--basant .leaderboard__name {
    font-size: 50px;
}

.skin--basant .lobby-seat__name > .caption,
.skin--basant .settings__row .caption {
    font-size: 34px;
}

.skin--basant .leaderboard__points {
    font-size: 48px;
}

.skin--basant .settings .chip,
.skin--basant .settings .chip:hover,
.skin--basant .settings .chip:active {
