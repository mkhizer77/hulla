}

/* ---------- Type scale: rows, headings, captions, chips and buttons at the concepts' size ---------- */

.skin--basant .settings__heading {
    margin: 30px 0 14px 12px;
    font-size: 42px;
    color: rgb(74, 30, 14);
}

.skin--basant .caption,
.skin--basant .settings .caption {
    font-size: 34px;
}

.skin--basant .settings .status {
    font-size: 38px;
