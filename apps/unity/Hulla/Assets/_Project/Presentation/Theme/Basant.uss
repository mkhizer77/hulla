.skin--basant .psheet__face {
    width: 176px;
    height: 176px;
    min-width: 176px;
    margin: 0 30px 0 0;
    border-width: 6px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 88px;
    border-top-right-radius: 88px;
    border-bottom-left-radius: 88px;
    border-bottom-right-radius: 88px;
}

.skin--basant .psheet__face .seat__initial {
    font-size: 80px;
    color: rgb(255, 255, 255);
}

.skin--basant .psheet__lines {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.skin--basant .player-sheet .psheet__name {
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(62, 26, 12);
}

.skin--basant .player-sheet .psheet__line {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(74, 30, 14);
}

.skin--basant .player-sheet .psheet__strip {
    margin: 0 0 18px 0;
    padding: 22px 24px;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(74, 30, 14);
    background-color: rgb(242, 220, 182);
    border-width: 3px;
    border-color: rgb(214, 186, 150);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.skin--basant .player-sheet .psheet__add,
.skin--basant .player-sheet .psheet__add:hover,
.skin--basant .player-sheet .psheet__add:active {
    min-height: 132px;
    margin: 0 0 18px 0;
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(62, 26, 12);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/btn-play-normal.png");
    -unity-slice-left: 176;
    -unity-slice-right: 176;
    -unity-slice-scale: 0.45px;
}

.skin--basant .player-sheet .psheet__voice {
    margin: 0 0 14px 0;
    padding: 12px 24px;
    border-width: 3px;
    border-color: rgb(214, 186, 150);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.skin--basant .player-sheet .psheet__voice > Label {
    font-size: 42px;
    min-width: 180px;
    color: rgb(62, 26, 12);
}

.skin--basant .psheet__links {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
}

.skin--basant .player-sheet .psheet__link,
.skin--basant .player-sheet .psheet__link:hover,
.skin--basant .player-sheet .psheet__link:active {
    min-height: 96px;
    margin: 0;
    padding: 0 18px;
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(150, 110, 90);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .player-sheet .psheet__dot {
    font-size: 38px;
    color: rgb(150, 110, 90);
}

/* ==================== Player sheet and Report, owner comment 28 Oct (concept: sheet-report) ==================== */
/* A cream sheet with a dark outline and a grabber, floating above the bottom edge. */
.skin--basant .coach.player-sheet {
    left: 36px;
    right: 36px;
    bottom: 36px;
    padding: 30px 44px 52px 44px;
    background-image: none;
    background-color: rgb(255, 241, 224);
    border-width: 7px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}

.skin--basant .player-sheet .player-sheet__grabber {
    width: 150px;
    height: 26px;
    margin-bottom: 24px;
    border-width: 4px;
    border-color: rgb(52, 24, 16);
    background-color: rgb(70, 66, 80);
}

.skin--basant .player-sheet .coach__text {
    font-size: 62px;
    color: rgb(96, 26, 26);
}

.skin--basant .report__reason,
.skin--basant .report__reason:hover,
.skin--basant .report__reason:active {
    min-height: 132px;
    margin: 0 0 14px 0;
    padding: 0 120px 0 40px;
    font-size: 54px;
    border-color: rgb(236, 214, 190);
    background-color: rgb(255, 238, 220);
    color: rgb(74, 26, 14);
}

.skin--basant .report__reason--on,
.skin--basant .report__reason--on:hover {
    border-color: rgb(206, 170, 130);
    background-color: rgb(246, 222, 192);
}

.skin--basant .report__radio {
    right: 36px;
    top: 34px;
    width: 64px;
    height: 64px;
    border-width: 5px;
    border-color: rgb(96, 26, 26);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
    background-color: rgb(244, 214, 178);
}

.skin--basant .report__reason--on .report__radio {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/radio-on.png");
}

.skin--basant .report__block {
    min-height: 132px;
    margin: 0 0 14px 0;
    padding: 0 30px 0 40px;
    border-width: 3px;
    border-color: rgb(236, 214, 190);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-color: rgb(255, 238, 220);
}

.skin--basant .report__block > .unity-label {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(74, 26, 14);
}

.skin--basant .report__send,
.skin--basant .report__send:hover,
.skin--basant .report__send:active {
    width: 66%;
    min-height: 164px;
    margin-top: 26px;
    font-size: 64px;
    color: rgb(74, 26, 14);
}

/* Chat fields: typed text and the placeholder in Baloo 2 Regular (the main file is ExtraBold only), at the table and in the lobby (owner comment). */
.skin--basant .chat-panel__input,
.skin--basant .chat-panel__input TextInput,
.skin--basant .chat-panel__input .unity-base-text-field__input,
.skin--basant .chat-panel__input .unity-text-element,
.skin--basant .chat-sheet__input,
.skin--basant .chat-sheet__input TextInput,
.skin--basant .chat-sheet__input .unity-base-text-field__input,
.skin--basant .chat-sheet__input .unity-text-element,
.skin--basant .table .chat-panel__input Label,
.skin--basant .table .chat-sheet__input Label {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2-Regular.ttf");
    -unity-font-style: normal;
}

/* ==================== Watching, owner comment 28 Oct (concept: watching) ==================== */
/* The line on its own wide plum plate, the mic and chat under it on the right, no quick-chat chips. */
.skin--basant .table--watching .table__strip {
    flex-wrap: wrap;
    justify-content: flex-end;
    height: auto;
    margin: 0 30px 20px 30px;
}

.skin--basant .table--watching .table__strip .table__me {
    display: none;
}

.skin--basant .table--watching .table__status {
    flex-basis: 100%;
    flex-grow: 1;
    min-height: 170px;
    margin: 0 0 22px 0;
    padding: 24px 44px;
    justify-content: center;
    background-color: rgb(70, 22, 44);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}

.skin--basant .table--watching .table__status-text {
    flex-grow: 1;
    font-size: 48px;
    -unity-text-align: middle-center;
}

.skin--basant .table--watching .quick-strip {
    display: none;
}

.skin--basant .table__mic:disabled {
    opacity: 1;
}

.skin--basant .table__mic:disabled .table__icon {
    opacity: 0.6;
}

/* ==================== Watching sheet, owner comment 28 Oct (concept: watching-sheet) ==================== */
.skin--basant .sheet.watch-sheet {
    background-image: none;
    background-color: rgb(255, 241, 224);
    border-width: 7px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
    margin: 0 36px 36px 36px;
    padding: 28px 40px 40px 40px;
}

.skin--basant .watch-sheet .sheet__grabber {
    width: 150px;
    height: 26px;
    border-width: 4px;
    border-color: rgb(52, 24, 16);
    background-color: rgb(70, 66, 80);
}

.skin--basant .watch-sheet__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 0 4px 18px 4px;
}

.skin--basant .watch-sheet .watch-sheet__title {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .watch-sheet .watch-sheet__free {
    flex-shrink: 1;
    margin-left: 20px;
    font-size: 36px;
    -unity-font-style: normal;
    -unity-text-align: middle-right;
    color: rgb(120, 92, 76);
}

.skin--basant .watch-sheet .watch-row,
.skin--basant .watch-sheet .watch-row:hover,
.skin--basant .watch-sheet .watch-row:active {
    flex-direction: row;
    align-items: center;
    min-height: 160px;
    margin: 0 0 16px 0;
    padding: 0 22px 0 16px;
    border-width: 3px;
    border-color: rgb(236, 214, 190);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    background-color: rgb(255, 236, 214);
    background-image: none;
}

.skin--basant .watch-sheet .watch-row__face {
    width: 120px;
    height: 120px;
    min-width: 120px;
    margin: 0 24px 0 0;
    border-width: 5px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-left-radius: 60px;
    border-bottom-right-radius: 60px;
}

.skin--basant .watch-sheet .watch-row__face .seat__initial {
    font-size: 56px;
    color: rgb(255, 255, 255);
}

.skin--basant .watch-sheet .watch-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .watch-sheet .watch-row__tag {
    padding: 16px 30px;
    font-size: 38px;
    -unity-font-style: bold;
    white-space: normal;
    max-width: 330px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(24, 80, 30);
    background-color: rgb(58, 160, 70);
    border-width: 5px;
    border-color: rgb(30, 70, 30);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.skin--basant .watch-sheet .watch-row__seat,
.skin--basant .watch-sheet .watch-row__seat:hover,
.skin--basant .watch-sheet .watch-row__seat:active {
    min-width: 180px;
    min-height: 132px;
    margin: 0;
    padding: 0 30px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
    background-image: none;
    background-color: rgb(255, 246, 232);
    border-width: 5px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.skin--basant .watch-sheet .watch-sheet__foot {
    margin-top: 8px;
    font-size: 36px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: rgb(120, 92, 76);
}

/* ==================== Bottom sheets to the reference, owner comments 28 Oct (concept: sheet-leave) ==================== */
/* Full width from the bottom, cream with a dark outline and rounded top, a dark grabber, regular body text,
   and big outlined answers with room around them. Sheets with their own card style (watching) keep it. */
.skin--basant .sheet {
    margin: 0;
    padding: 30px 64px 84px 64px;
    background-image: none;
    background-color: rgb(255, 245, 230);
    border-top-width: 7px;
    border-left-width: 7px;
    border-right-width: 7px;
    border-bottom-width: 0;
    border-color: rgb(40, 22, 18);
    border-top-left-radius: 64px;
    border-top-right-radius: 64px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.skin--basant .sheet .sheet__grabber {
    width: 150px;
    height: 24px;
    margin-bottom: 30px;
    border-width: 0;
    background-color: rgb(80, 76, 82);
}

.skin--basant .sheet .sheet__title {
    font-size: 70px;
    color: rgb(40, 22, 18);
}

.skin--basant .sheet .sheet__body {
    margin: 10px 10px 0 10px;
    font-size: 46px;
    -unity-font-style: normal;
    color: rgb(56, 34, 28);
}

.skin--basant .sheet .sheet__answers {
    margin-top: 50px;
}

.skin--basant .sheet .sheet__answer,
.skin--basant .sheet .sheet__answer:hover,
.skin--basant .sheet .sheet__answer:focus,
.skin--basant .sheet .sheet__answer:active {
    min-height: 156px;
    margin: 0 16px;
    font-size: 62px;
    color: rgb(40, 22, 18);
    background-image: none;
    background-color: rgb(255, 242, 222);
    border-width: 7px;
    border-color: rgb(40, 22, 18);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}

.skin--basant .sheet .sheet__answer:active {
    opacity: 0.85;
}

.skin--basant .sheet .sheet__answer--yes,
.skin--basant .sheet .sheet__answer--yes:hover,
.skin--basant .sheet .sheet__answer--yes:focus,
.skin--basant .sheet .sheet__answer--yes:active {
    color: rgb(40, 22, 18);
    -unity-text-outline-width: 0;
    background-color: rgb(255, 196, 48);
}

.skin--basant .sheet .sheet__answer--danger,
.skin--basant .sheet .sheet__answer--danger:hover,
.skin--basant .sheet .sheet__answer--danger:focus,
.skin--basant .sheet .sheet__answer--danger:active {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    background-color: rgb(212, 64, 58);
}

.skin--basant .sheet .sheet__answer--teal,
.skin--basant .sheet .sheet__answer--teal:hover,
.skin--basant .sheet .sheet__answer--teal:focus,
.skin--basant .sheet .sheet__answer--teal:active {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    background-color: rgb(44, 150, 158);
}

.skin--basant .sheet .invite-sheet__share,
.skin--basant .sheet .invite-sheet__share:hover,
.skin--basant .sheet .invite-sheet__share:focus,
.skin--basant .sheet .invite-sheet__share:active {
    color: rgb(255, 255, 255);
    background-color: rgb(246, 138, 36);
}

/* ==================== Results podium and level bar, owner comment 28 Oct (concept: results) ==================== */
.skin--basant .podium__stand {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    height: auto;
    margin: 10px 0 20px 0;
    padding: 0;
    background-image: none;
}

.skin--basant .podium__col {
    width: 214px;
    padding: 0;
    margin: 0 -2px;
    align-items: center;
    justify-content: flex-end;
}

.skin--basant .podium__col--1 {
    width: 250px;
}

.skin--basant .podium__crown {
    width: 120px;
    height: 92px;
    margin-bottom: -18px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/crown-host.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .podium__col .podium__avatar {
    width: 168px;
    height: 168px;
    margin: 0 0 -34px 0;
    border-width: 6px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-left-radius: 84px;
    border-bottom-right-radius: 84px;
    scale: 1 1;
}

.skin--basant .podium__col--1 .podium__avatar {
    width: 196px;
    height: 196px;
    border-color: rgb(212, 150, 30);
    border-top-left-radius: 98px;
    border-top-right-radius: 98px;
    border-bottom-left-radius: 98px;
    border-bottom-right-radius: 98px;
}

/* The Bhabhi's face greyed under the stamp. */
.skin--basant .podium__col--loser .podium__avatar {
    -unity-background-image-tint-color: rgb(196, 196, 196);
    border-color: rgb(110, 104, 104);
}

.skin--basant .podium__block {
    width: 100%;
    padding: 46px 10px 16px 10px;
    align-items: center;
    background-color: rgb(250, 236, 214);
    border-width: 5px;
    border-bottom-width: 0;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
}

.skin--basant .podium__col--1 .podium__block { height: 300px; background-color: rgb(255, 244, 226); }
.skin--basant .podium__col--2 .podium__block { height: 220px; }
.skin--basant .podium__col--3 .podium__block { height: 186px; background-color: rgb(246, 224, 196); }
.skin--basant .podium__col--loser .podium__block { height: 152px; background-color: rgb(236, 226, 220); }

.skin--basant .podium__spacer {
    flex-grow: 1;
}

.skin--basant .podium__block .podium__rank {
    position: relative;
    padding: 4px 22px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(62, 26, 12);
    border-width: 4px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-image: none;
}

.skin--basant .podium__col--1 .podium__rank { background-color: rgb(255, 212, 84); border-color: rgb(160, 104, 24); }
.skin--basant .podium__col--2 .podium__rank { background-color: rgb(222, 224, 230); border-color: rgb(116, 118, 130); }
.skin--basant .podium__col--3 .podium__rank { background-color: rgb(236, 172, 116); border-color: rgb(146, 86, 38); }

.skin--basant .podium__block .podium__name {
    width: 96%;
    padding: 6px 8px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(62, 26, 12);
    background-color: rgb(255, 248, 236);
    background-image: none;
    border-width: 4px;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.skin--basant .podium__col--loser .results__stamp {
    position: absolute;
    left: -30px;
    top: 50px;
    rotate: -12deg;
}

/* The level bar: an orange fill on a rose track, white outlined text (concept: Results). */
.skin--basant .results__level {
    background-image: none;
    background-color: rgb(214, 150, 140);
    border-width: 5px;
    border-color: rgb(120, 36, 40);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
}

.skin--basant .results__level-fill {
    left: 0;
    top: 0;
    bottom: 0;
    background-image: none;
    background-color: rgb(250, 160, 50);
    border-top-left-radius: 30px;
    border-bottom-left-radius: 30px;
    border-right-width: 4px;
    border-color: rgb(255, 196, 92);
}

.skin--basant .results__level-text {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(110, 40, 20);
}

/* ==================== Friends, owner comment 28 Oct (concept: friends) ==================== */
.skin--basant .friends__heading {
    margin: 26px 36px 12px 36px;
    font-size: 52px;
    color: rgb(40, 22, 18);
}

.skin--basant .friends__search-field TextInput,
.skin--basant .friends__search-field .unity-base-text-field__input,
.skin--basant .friends__search-field .unity-text-element {
    font-size: 52px;
    -unity-font-style: normal;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2-Regular.ttf");
}

.skin--basant .settings .friend-row {
    min-height: 196px;
    margin: 0 26px 20px 26px;
    padding: 12px 30px 12px 26px;
    background-image: none;
    background-color: rgb(255, 238, 220);
    border-width: 6px;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
}

.skin--basant .settings .friend-row__face {
    width: 152px;
    height: 152px;
    margin-right: 30px;
    border-width: 6px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 76px;
    border-top-right-radius: 76px;
    border-bottom-left-radius: 76px;
    border-bottom-right-radius: 76px;
}

.skin--basant .settings .friend-row__dot {
    right: -4px;
    top: 0;
    width: 44px;
    height: 44px;
}

.skin--basant .settings .friend-row .lobby-seat__name > Label {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .friend-row .lobby-seat__name > .caption {
    font-size: 44px;
    -unity-font-style: normal;
    color: rgb(56, 34, 28);
}

.skin--basant .settings .friend-row .chip,
.skin--basant .settings .friend-row .chip:hover,
.skin--basant .settings .friend-row .chip:active {
    padding: 0 36px;
    font-size: 48px;
}

/* Teal stays teal on the flat chips (Invite). */
.skin--basant .settings .chip--teal,
.skin--basant .settings .chip--teal:hover,
.skin--basant .settings .chip--teal:active {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Kit/chip-flat-on.png");
    -unity-background-image-tint-color: rgb(80, 200, 205);
}

/* ==================== Player sheet, Friends, owner comment 28 Oct (concept: sheet-player) ==================== */
.skin--basant .player-card__head {
    align-items: center;
}

.skin--basant .player-card .player-card__face {
    width: 196px;
    height: 196px;
    min-width: 196px;
    margin-right: 34px;
    border-width: 7px;
    border-color: rgb(52, 24, 16);
    border-top-left-radius: 98px;
    border-top-right-radius: 98px;
    border-bottom-left-radius: 98px;
    border-bottom-right-radius: 98px;
}

.skin--basant .player-card__dot {
    position: absolute;
    right: 2px;
    top: 4px;
    width: 48px;
    height: 48px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/dot-online.png");
    -unity-background-scale-mode: scale-to-fit;
}

.skin--basant .player-card .player-card__who {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.skin--basant .player-card .player-card__name {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .player-card .player-card__handle {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .player-card .player-card__stats {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(56, 34, 28);
}

.skin--basant .player-card__star,
.skin--basant .player-card__star:hover,
.skin--basant .player-card__star:active {
    position: absolute;
    right: -10px;
    top: -6px;
    width: 132px;
    height: 132px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/badge-level-star.png");
    background-size: 96px 96px;
    background-position: center;
    -unity-background-image-tint-color: rgb(200, 190, 180);
}

.skin--basant .player-card__star--on,
.skin--basant .player-card__star--on:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skin--basant .player-card .player-card__where {
    margin: 30px 0 0 0;
    padding: 24px 20px 40px 20px;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
    background-color: rgb(240, 216, 186);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.skin--basant .player-card .player-card__main,
.skin--basant .player-card .player-card__main:hover,
.skin--basant .player-card .player-card__main:active {
    margin: -24px 0 0 0;
    min-height: 164px;
    font-size: 64px;
}

.skin--basant .player-card .sheet__answers {
    margin-top: 26px;
}

.skin--basant .player-card__links {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 26px;
}

.skin--basant .player-card .player-card__link,
.skin--basant .player-card .player-card__link:hover,
.skin--basant .player-card .player-card__link:active {
    min-height: 96px;
    margin: 0;
    padding: 0 14px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(150, 120, 104);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skin--basant .player-card .player-card__sep {
    font-size: 40px;
    color: rgb(150, 120, 104);
}

/* ==================== Tab titles and Missions, owner comment 28 Oct (concept: missions) ==================== */
/* Screen titles: bigger, with the thick dark outline of the concepts (Trophies, Friends, Shop…). */
.skin--basant .settings .settings__top .top__title {
    font-size: 108px;
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(110, 40, 10);
    text-shadow: 0 6px 0 rgb(110, 40, 10);
}

.skin--basant .missions__heading {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .missions__head {
    margin: 24px 32px 14px 32px;
}

.skin--basant .settings .missions__swap,
.skin--basant .settings .missions__swap:hover,
.skin--basant .settings .missions__swap:active {
    font-size: 46px;
}

.skin--basant .settings .mission {
    margin: 0 26px 22px 26px;
    padding: 30px 40px 32px 40px;
    background-image: none;
    background-color: rgb(255, 238, 220);
    border-width: 6px;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
}

.skin--basant .settings .mission__name {
    font-size: 60px;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .mission__reward {
    font-size: 60px;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .mission__count {
    flex-shrink: 0;
    min-width: 180px;
    font-size: 46px;
    white-space: nowrap;
    -unity-text-align: middle-right;
    color: rgb(40, 22, 18);
}

/* The bar: green on a white track with a dark outline. */
.skin--basant .settings .mission__meter {
    height: 42px;
    background-image: none;
    background-color: rgb(255, 252, 246);
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
}

.skin--basant .settings .mission__meter > .meter__fill {
    left: 0;
    top: 0;
    bottom: 0;
    min-width: 30px;
    background-image: none;
    background-color: rgb(76, 176, 72);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* Claim: a compact yellow pill with a dark outline beside the bar. */
.skin--basant .settings .mission__claim,
.skin--basant .settings .mission__claim:hover,
.skin--basant .settings .mission__claim:active {
    margin: -24px 0 -24px 22px;
    padding: 0 30px;
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

/* ==================== Achievements, owner comment 28 Oct (concept: achievements) ==================== */
.skin--basant .medals__total {
    margin: 18px 30px 26px 30px;
}

.skin--basant .medals__count {
    font-size: 58px;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .medals__bar {
    height: 40px;
    background-image: none;
    background-color: rgb(255, 252, 246);
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.skin--basant .settings .medals__bar > .meter__fill,
.skin--basant .settings .medal-tile__bar > .meter__fill {
    left: 0;
    top: 0;
    bottom: 0;
    background-image: none;
    background-color: rgb(76, 176, 72);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.skin--basant .medals__grid {
    margin: 0 26px;
}

.skin--basant .settings .medal-tile,
.skin--basant .settings .medal-tile:hover,
.skin--basant .settings .medal-tile:active {
    width: 31.5%;
    height: 400px;
    margin: 0 0 22px 0;
    padding: 0 10px 18px 10px;
    justify-content: flex-start;
    background-image: none;
    background-color: rgb(255, 238, 220);
    border-width: 6px;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
    overflow: visible;
}

.skin--basant .settings .medal-tile__medal {
    width: 250px;
    height: 250px;
    margin: -10px 0 6px 0;
}

.skin--basant .settings .medal-tile__name {
    font-size: 48px;
    color: rgb(40, 22, 18);
}

/* Locked: wide tiles, two a row, the silver medal beside the name and its bar. */
.skin--basant .settings .medals__grid--locked .medal-tile,
.skin--basant .settings .medals__grid--locked .medal-tile:hover,
.skin--basant .settings .medals__grid--locked .medal-tile:active {
    width: 48.5%;
    height: 220px;
    padding: 10px 26px 10px 14px;
    flex-direction: row;
    align-items: center;
}

.skin--basant .settings .medals__grid--locked .medal-tile__medal {
    width: 190px;
    height: 190px;
    margin: 0 16px 0 0;
}

.skin--basant .medal-tile__side {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.skin--basant .settings .medals__grid--locked .medal-tile__name {
    font-size: 46px;
    -unity-text-align: middle-left;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .medal-tile__bar {
    width: 100%;
    height: 34px;
    margin-top: 14px;
    background-image: none;
    background-color: rgb(255, 252, 246);
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.skin--basant .settings .medal-tile__bar > .meter__fill {
    background-color: rgb(150, 150, 150);
}

/* ==================== Leaderboard, owner comment 28 Oct (concept: leaderboard) ==================== */
.skin--basant .settings .leaderboard__row {
    min-height: 168px;
    margin: 0 26px 18px 26px;
    padding: 0 34px 0 24px;
    background-image: none;
    background-color: rgb(255, 236, 222);
    border-width: 6px;
    border-color: rgb(110, 44, 30);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

.skin--basant .settings .leaderboard__rank {
    min-width: 80px;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .board__face {
    width: 112px;
    height: 112px;
    min-width: 112px;
    margin: 0 28px 0 12px;
    border-width: 0;
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    border-bottom-left-radius: 56px;
    border-bottom-right-radius: 56px;
}

.skin--basant .settings .leaderboard__name {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .leaderboard__points {
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

/* Your row: yellow, the face large, the rank small over "You", then points and the climb. */
.skin--basant .settings .board__me-row {
    min-height: 240px;
    background-color: rgb(255, 232, 150);
}

.skin--basant .settings .board__me-row .board__face {
    width: 168px;
    height: 168px;
    min-width: 168px;
    margin: 0 30px 0 0;
    border-top-left-radius: 84px;
    border-top-right-radius: 84px;
    border-bottom-left-radius: 84px;
    border-bottom-right-radius: 84px;
}

.skin--basant .settings .board__me-row .leaderboard__rank {
    min-width: 0;
    font-size: 44px;
    -unity-text-align: middle-left;
    background-image: none;
}

.skin--basant .settings .board__me-row .leaderboard__name {
    font-size: 72px;
}

.skin--basant .settings .board__me-row .leaderboard__points {
    display: none;
}

.skin--basant .settings .board__climb {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

/* The Ranked card: compact, centred, pale blue with a dark outline. */
.skin--basant .settings .board__ranked {
    align-self: center;
    width: 72%;
    min-height: 0;
    margin: 10px 0 16px 0;
    padding: 18px 26px 18px 36px;
    background-image: none;
    background-color: rgb(220, 236, 252);
    border-width: 6px;
    border-color: rgb(70, 52, 70);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
}

.skin--basant .settings .board__ranked-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .board__ranked-reset {
    font-size: 38px;
    -unity-font-style: normal;
    white-space: normal;
    color: rgb(40, 22, 18);
}


/* ==================== Ranked, owner comment 28 Oct (concept: ranked) ==================== */
.skin--basant .settings .ranked__card {
    background-image: none;
    background-color: rgb(214, 232, 250);
    border-width: 6px;
    border-color: rgb(70, 110, 160);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

.skin--basant .settings .ranked__league {
    font-size: 104px;
    color: rgb(96, 26, 26);
}

.skin--basant .settings .ranked__rating {
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .ranked__bar {
    width: 84%;
    height: 56px;
    background-image: none;
    background-color: rgb(222, 196, 170);
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.skin--basant .settings .ranked__fill {
    background-image: none;
    background-color: rgb(52, 130, 220);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.skin--basant .settings .ranked__progress {
    font-size: 40px;
    -unity-font-style: normal;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .ranked__rules {
    font-size: 36px;
    -unity-font-style: normal;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .ranked__season {
    font-size: 40px;
    -unity-font-style: normal;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .ranked__ladder {
    background-color: rgb(255, 238, 224);
    border-width: 8px;
    border-color: rgb(166, 30, 74);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

.skin--basant .settings .ranked__ladder .ranked__step {
    min-height: 112px;
    border-bottom-width: 3px;
    border-color: rgb(226, 196, 170);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.skin--basant .settings .ranked__ladder .ranked__step--me {
    background-color: rgb(255, 232, 150);
}

.skin--basant .settings .ranked__ladder .ranked__step-name {
    font-size: 54px;
    color: rgb(40, 22, 18);
}

.skin--basant .settings .ranked__ladder .ranked__step-detail {
    font-size: 46px;
    -unity-font-style: normal;
    -unity-text-align: middle-right;
    color: rgb(40, 22, 18);
}

