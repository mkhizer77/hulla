}

.skin--basant .nav .nav__art--friends {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/icon-nav-friends.png");
}

.skin--basant .nav .nav__art--trophies {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/icon-nav-trophies.png");
}

.skin--basant .nav .nav__art--shop {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/icon-nav-shop.png");
}

.skin--basant .nav .nav__label {
    position: absolute;
    left: 10px;
    top: 136px;
    width: 233px;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 40px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(74, 30, 14);
}

.skin--basant .nav .nav__badge {
    position: absolute;
    left: 162px;
    top: 10px;
    width: 58px;
    height: 58px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    font-size: 36px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Basant/Home/badge-count.png");
}

/* The lettered words differ in letter size; these boxes match each word to the concept. */
.skin--basant .nav #nav-home .nav__label {
    top: 141px;
    height: 31px;
}

.skin--basant .nav #nav-friends .nav__label {
    top: 138px;
    height: 34px;
}

.skin--basant .home #join-toggle-label {
    top: 32px;
    height: 52px;
}

