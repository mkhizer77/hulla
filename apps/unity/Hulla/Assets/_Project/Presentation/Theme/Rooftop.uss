}

.skinned .profile__dossier {
    margin-top: 90px;
}

.skinned .profile__name {
    margin-top: 90px;
    padding: 10px 70px 18px 70px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/nameplate_wood_blank_9.png");
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 46;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.8px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
    color: #FFF8E1;
    -unity-slice-type: tiled;
}

/* The friend code is a ticket: a small plank with the code in gold. */
.skinned .profile__ticket {
    align-self: center;
    min-width: 560px;
    padding: 40px 70px;
    -unity-slice-scale: 0.45px;
}

.skinned .profile__ticket .code {
    font-size: 72px;
}

.skinned .profile__stat {
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/nameplate_wood_blank_9.png");
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 46;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.7px;
    padding: 20px 40px 26px 40px;
    -unity-slice-type: tiled;
}

.skinned .profile__stat-value {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    color: #FFF8E1;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #1F0E05;
}

.skinned .profile__stat--loss .profile__stat-value {
    color: #E53935;
}

.skinned .profile__stat-label {
    color: #E6D3B3;
}

/* The bio on the parchment scroll, in dark ink. */
.skinned .profile__bio {
    padding: 30px 90px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/panel_parchment_dialog_blank_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 80;
    -unity-slice-bottom: 83;
    -unity-slice-scale: 1px;
    color: #3A2412;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-slice-type: tiled;
}

/* ---------------------------------------------------------------- Friends (pack: sprites/07_friends_hub) */

.skinned .friend-row__avatar {
    margin-left: -10px;
    margin-right: 40px;
}

.skinned .friend-row__avatar .seat__frame {
    left: -35px;
    top: -35px;
    width: 166px;
    height: 166px;
}

.skinned .friend-row__avatar .party__dot {
    right: -14px;
    bottom: -14px;
    border-color: #2A170C;
    background-color: #43A047;
}

/* Declines, removals and blocks are red; accepts and adds stay gold. */
.skinned .chip.button--danger {
    -unity-background-image-tint-color: rgb(230, 110, 100);
    color: #FFF8E1;
}

/* Add by code: the field and its button on one carved plate. */
.skinned #friends .chat-panel__compose {
    padding: 16px 44px 22px 44px;
    margin-bottom: var(--space-1);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/nameplate_wood_blank_9.png");
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 46;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.8px;
    -unity-slice-type: tiled;
}

/* ---------------------------------------------------------------- Settings (pack: sprites/09_settings_comforts) */

/* Every toggle is the carved switch: the star knob left when off, right on a warm groove when on. */
.skinned .unity-toggle__checkmark {
    width: 132px;
    height: 50px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/switch_off.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skinned .unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/switch_on.png");
}

/* Sliders: a carved groove and the brass star knob. */
.skinned .unity-base-slider__tracker {
    height: 20px;
    margin-top: -10px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #8C5D14;
    background-color: #2A170C;
}

.skinned .unity-base-slider__dragger {
    width: 68px;
    height: 68px;
    margin-top: -34px;
    border-radius: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/toggle_knob.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---------------------------------------------------------------- Dialogs (pack: sprites/10_popups_dialogs)
   The pack ships the pieces, not a layout: the question in dark ink on the parchment scroll, the gold
   button for yes and a plank for no. */
.skinned .dialog {
    padding: 60px 120px 70px 120px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/panel_parchment_dialog_blank_9.png");
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 80;
    -unity-slice-bottom: 83;
    -unity-slice-scale: 1.2px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-type: tiled;
}

.skinned .dialog__text {
    font-size: 46px;
    color: #3A2412;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    letter-spacing: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
}

.skinned #shell-dialog {
    background-color: rgba(20, 16, 38, 0.78);
}

/* ---------------------------------------------------------------- the tablet rail (responsive guide)
   The dock turns on its side: its trimmed ends become the rail's long edges. */
.skinned.size--expanded > .nav, .skinned .size--expanded > .nav {
    height: auto;
    padding: 60px 0;
    border-right-width: 0;
    -unity-slice-left: 110;
    -unity-slice-right: 110;
    -unity-slice-top: 60;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 1px;
}

.skinned.size--expanded > .nav .nav__art {
    margin-top: 0;
}

/* ---------------------------------------------------------------- the player's own pod at the table
   The same brass pod as the opponents, a little smaller, with the nameplate under it and the You tag
   on the ring; no dark pill. */
.skinned .me-badge {
    flex-direction: column;
    align-items: center;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.skinned .me-badge .seat__avatar {
    width: 104px;
    height: 104px;
    min-width: 104px;
    border-radius: 52px;
    border-width: 0;
}

.skinned .me-badge .seat__initial {
    font-size: 46px;
}

.skinned .me-badge .seat__frame {
    left: -38px;
    top: -38px;
    width: 180px;
    height: 180px;
}

.skinned .me-badge .seat__timer {
    left: -50px;
    top: -50px;
    right: -50px;
    bottom: -50px;
}

.skinned .me-badge .seat__name {
    margin: 46px 0 0 0;
    max-width: none;
    padding: 2px 40px 8px 40px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/nameplate_wood_blank_9.png");
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 46;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.5px;
    font-size: 28px;
    color: #F5F0E6;
    -unity-text-align: middle-center;
    -unity-slice-type: tiled;
}

.skinned .seat--turn.me-badge .seat__name {
    color: #FFE082;
}

.skinned .me-badge .seat__you {
    bottom: -22px;
    padding: 0 12px 2px 12px;
    border-radius: 10px;
    background-color: #F9A825;
    color: #1F0E05;
    font-size: 18px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
}

/* Opponents' timer sits just outside the brass ring, never under it. */
.skinned .seat__timer {
    left: -46px;
    top: -46px;
    right: -46px;
    bottom: -46px;
}

.skinned .seat--turn .seat__avatar {
    border-width: 0;
}

/* Home fills the screen: on a phone taller than the 1920 reference the arch takes the spare height,
   centred, so the boards stay under it instead of leaving a gap above the dock. */
.skinned .home__scroll .unity-scroll-view__content-container {
    min-height: 100%;
}

.skinned .home .games {
    flex-grow: 1;
    justify-content: center;
}

/* The header holds the sign and the shield under it, so a board below never covers the shield. */
.skinned .home .home__header {
    height: 340px;
    margin-top: 60px;
}

.skinned .home .game__mode-label {
    font-size: 40px;
    padding: 0 14px;
}

/* The arch keeps its size; the column around it gives way, not the art. */
.skinned .home .games, .skinned .home .game, .skinned .home .game__play, .skinned .home .home__header, .skinned .home .home__lower {
    flex-shrink: 0;
}

/* Settings rows: the label takes the room and wraps; the switch keeps its size at the row's right edge. */
.skinned .settings__row.unity-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    margin-right: 20px;
}

.skinned .settings__row.unity-toggle > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 168px;
    justify-content: flex-end;
}

/* Every state of a toggle keeps the carved switch and the cream label. Unity's own focus, hover and
   checked styles otherwise recolour the label, blank the switch or draw a tick on a tapped row. */
.skinned .unity-toggle .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:focus .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:hover .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:active .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle .unity-toggle__input:focus .unity-toggle__checkmark,
.skinned .unity-toggle .unity-toggle__input:hover .unity-toggle__checkmark {
    width: 168px;
    height: 64px;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/switch_off.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skinned .unity-toggle:checked .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:checked:focus .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:checked:hover .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:checked:active .unity-toggle__input .unity-toggle__checkmark,
.skinned .unity-toggle:checked .unity-toggle__input:focus .unity-toggle__checkmark,
.skinned .unity-toggle:checked .unity-toggle__input:checked .unity-toggle__checkmark,
.skinned .unity-toggle .unity-toggle__input:checked .unity-toggle__checkmark,
.skinned .unity-toggle .unity-toggle__input:checked:focus .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/switch_on.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.skinned .settings__row.unity-toggle > .unity-label,
.skinned .settings__row.unity-toggle:focus > .unity-label,
.skinned .settings__row.unity-toggle:hover > .unity-label,
.skinned .settings__row.unity-toggle:active > .unity-label,
.skinned .settings__row.unity-toggle:checked > .unity-label,
.skinned .settings__row.unity-toggle:checked:focus > .unity-label {
    color: #FFF8E1;
}

/* Destructive actions are red planks with cream text. */
.skinned .button.button--danger, .skinned .button.button--danger:hover, .skinned .button.button--danger:focus {
    -unity-background-image-tint-color: rgb(236, 112, 100);
    color: #FFF8E1;
}

.skinned .settings__value {
    min-width: 96px;
    -unity-text-align: middle-right;
    color: #FFE082;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
}

/* Friends is a tab: the dock already goes back, so the screen has no Back. */
.skinned #friends .settings__top > .button--quiet {
    display: none;
}

/* ---------------------------------------------------------------- fit and contrast */

.skinned .home .hero {
    min-height: 132px;
}

.skinned .home .plank, .skinned .inventory .plank {
    padding: 0 24px 10px 24px;
    font-size: 44px;
}

.skinned .home .daily__board {
    padding: 0 18px 10px 18px;
    font-size: 40px;
}

/* Ready reads on a green enamel tag. */
.skinned .seat__state--ready {
    padding: 0 12px 2px 12px;
    border-radius: 10px;
    background-color: #2E7D32;
    color: #FFFFFF;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* A reward and its button stack in the tier's pedestal; the pedestal grows with them. */
.skinned .pass__lanes .pass__track .pass__side {
    height: auto;
    min-height: 220px;
}

.skinned .pass__lanes .pass__track .pass__reward {
    flex-shrink: 0;
}
