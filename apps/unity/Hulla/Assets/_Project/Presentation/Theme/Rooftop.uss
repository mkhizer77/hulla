/*
 * The rooftop look (docs/design/rooftop-redesign.md), the app's only look: the owner's art pack, imported by
 * tools/artkit/rooftop_import.py into Art/Skins/Rooftop. Tokens and type follow the pack's
 * handover; the backdrops are the pack's own, the table felt a stand-in until it ships one. Nine-slice borders are set here with -unity-slice-*, measured on
 * the exported files. Loaded after Skins.uss, so these rules win over the shared skin rules.
 */

/* ---------------------------------------------------------------- tokens */

.skinned {
    --surface-ui: #201844;
    --surface-panel: #2A170C;
    --surface-raised: #4A2E1B;
    --accent-saffron: #F9A825;
    --accent-mustard: #FFE082;
    --accent-teal: #00897B;
    --ink-ivory: #FFF8E1;
    --ink-muted: #E6D3B3;
    --gold: #FFE082;
    --felt: #00897B;
    --rt-canary: #FFF176;
    --rt-saffron: #F9A825;
    --rt-honey: #C17900;
    --rt-wood: #4A2E1B;
    --rt-wood-top: #784A29;
    --rt-wood-shadow: #2A170C;
    --rt-brass-light: #FFE082;
    --rt-brass: #D49B35;
    --rt-brass-shadow: #8C5D14;
    --rt-crimson: #D32F2F;
    --rt-peacock: #00897B;
    --rt-felt-dark: #004D40;
    --rt-magenta: #C2185B;
    --rt-cyan: #00BCD4;
    --rt-olive: #43A047;
    --rt-cream: #FFF8E1;
    --rt-ivory: #F5F0E6;
    --rt-ink: #1F0E05;
    --rt-sky-deep: #141026;
    --rt-sky: #201844;
    color: #FFF8E1;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/NunitoBold.ttf");
}

/* ---------------------------------------------------------------- scene */

/* The pack's night scenes: the rooftop over the old city behind every menu, and the walled roof behind
   the table. Both carry their own string lights, so the drawn ones are left out (AmbientLayer). Cover,
   anchored to the top, so a taller phone shows more roof rather than stretching the sky. */
.skinned .screen {
    background-color: #120E26;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Backdrops/bg_home_rooftop.png");
    background-size: cover;
    background-position-y: top;
}

.skinned .table {
    background-color: #120E26;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Backdrops/bg_table_backdrop.png");
    background-size: cover;
    background-position-y: top;
}

.skinned .table__zone > .rail {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/table_felt_rail.png");
}

/* ---------------------------------------------------------------- type (handover §2) */

.skinned .title, .skinned .code, .skinned .home__title, .skinned .seat__initial, .skinned .podium__rank, .skinned .turn, .skinned .countdown, .skinned .results__title, .skinned .results__stamp, .skinned .toast, .skinned .game__name {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
}

.skinned .title, .skinned .home__title, .skinned .code, .skinned .results__title, .skinned .game__name {
    color: #FFE082;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #1F0E05;
    text-shadow: 0 4px 0 #0D0502;
    letter-spacing: 2px;
}

/* UI text a player taps or reads on wood: Baloo 2 ExtraBold, the rounded face of the pack's renders. */
.skinned .button, .skinned .chip, .skinned .seat__name, .skinned .nav__label, .skinned .hero, .skinned .table__pill, .skinned .quick-strip__chip {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
    letter-spacing: -0.5px;
}

/* ---------------------------------------------------------------- shared controls */

/* Planks for every ordinary button; the pressed art sits 4px lower. */
.skinned .button, .skinned .button--secondary, .skinned .chip--share, .skinned .hero {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_plank_medium_normal_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 105;
    -unity-slice-right: 105;
    -unity-slice-top: 82;
    -unity-slice-bottom: 87;
    -unity-slice-scale: 0.55px;
    border-width: 0;
    padding: 0 48px 14px 48px;
    color: #FFF8E1;
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 2px rgba(0, 0, 0, 0.7);
    -unity-slice-type: tiled;
}

.skinned .button:active, .skinned .button--secondary:active, .skinned .chip--share:active, .skinned .hero:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_plank_medium_pressed_9.png");
    scale: 1 1;
    -unity-slice-left: 105;
    -unity-slice-right: 105;
    -unity-slice-top: 82;
    -unity-slice-bottom: 87;
    -unity-slice-scale: 1px;
    -unity-slice-type: tiled;
}

/* The gold bar for primary actions; it presses by moving down. */
.skinned .button--primary, .skinned .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_primary_pressed_9.png");
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 90;
    -unity-slice-bottom: 114;
    -unity-slice-scale: 0.6px;
    padding: 0 48px 22px 48px;
    color: #1F0E05;
    -unity-text-outline-width: 0;
    text-shadow: 0 1px 0 rgba(255, 241, 118, 0.6);
    letter-spacing: 2px;
    -unity-slice-type: tiled;
}

.skinned .button--primary:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_primary_pressed_9.png");
    translate: 0 4px;
    -unity-background-image-tint-color: rgb(235, 215, 190);
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 90;
    -unity-slice-bottom: 114;
    -unity-slice-scale: 1px;
    -unity-slice-type: tiled;
}

.skinned .button--quiet {
    background-image: none;
    color: #E6D3B3;
    -unity-text-outline-width: 0;
}

.skinned .chip {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_chip_pill_normal_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 44;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    padding: 0 36px 8px 36px;
    color: #FFF8E1;
    -unity-slice-type: tiled;
}

.skinned .chip:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_chip_pill_pressed_9.png");
    scale: 1 1;
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 44;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 1px;
    -unity-slice-type: tiled;
}

/* A chosen chip turns to gold with dark ink. */
.skinned .chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_primary_pressed_9.png");
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 90;
    -unity-slice-bottom: 114;
    -unity-slice-scale: 0.45px;
    color: #1F0E05;
    -unity-text-outline-width: 0;
    text-shadow: 0 1px 0 rgba(255, 241, 118, 0.6);
    -unity-slice-type: tiled;
}

/* Panels are the large plank with its painted corners. */
.skinned .panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_plank_large_normal_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 140;
    -unity-slice-right: 140;
    -unity-slice-top: 98;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 0.6px;
    padding: 56px 64px;
    -unity-slice-type: tiled;
}

.skinned .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/nameplate_wood_blank_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 50;
    -unity-slice-right: 50;
    -unity-slice-top: 46;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.5px;
    color: #F5F0E6;
    -unity-slice-type: tiled;
}

.skinned .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Avatars/avatar_frame_brass.png");
}

.skinned .seat__back, .skinned .discard__card, .skinned .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Cards/card_back_truckart.png");
}

.skinned .table__info, .skinned .table__pill, .skinned .quick-strip__chip, .skinned .quick-strip__more, .skinned .table__chat, .skinned .me-badge {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_chip_pill_normal_9.png");
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 44;
    -unity-slice-bottom: 45;
    -unity-slice-scale: 0.5px;
    color: #FFF8E1;
    -unity-slice-type: tiled;
}

.skinned .card--legal {
    border-color: #FFE082;
}

/* The thulla stamp is ink on the felt; the word is in the art, so the label only speaks to screen readers. */
.skinned .toast {
    color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/FX/stamp_thulla.png");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    width: 640px;
    height: 406px;
    padding: 0;
    rotate: -8deg;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skinned .unity-toggle__checkmark {
    border-color: #FFE082;
}

.skinned .unity-base-slider__dragger {
    background-color: #D49B35;
    border-color: #FFE082;
}

.skinned .field .unity-base-text-field__input {
    border-color: #D49B35;
    background-color: #2A170C;
    color: #FFF8E1;
}

/* ---------------------------------------------------------------- navigation dock */

.skinned .nav {
    height: 190px;
    padding: 40px 24px 10px 24px;
    border-top-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Nav/nav_dock_baseboard_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 55;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 1px;
    overflow: visible;
    -unity-slice-type: tiled;
}

.skinned .nav__icon {
    display: none;
}

.skinned .nav__art {
    display: flex;
    width: 120px;
    height: 120px;
    margin-top: -60px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, translate;
    transition-duration: 160ms;
}

.skinned .nav__tab--on .nav__art {
    scale: 1.12 1.12;
    translate: 0 -6px;
}

.skinned .nav__tab:active .nav__art {
    translate: 0 4px;
}

.skinned .nav__art--home {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Nav/icon_nav_home.png");
}

.skinned .nav__art--friends {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Nav/icon_nav_friends.png");
}

.skinned .nav__art--inventory {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Nav/icon_nav_inventory.png");
}

.skinned .nav__art--settings {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Nav/icon_nav_settings.png");
}

.skinned .nav__label {
    font-size: 34px;
    color: #FFF8E1;
    -unity-text-outline-width: 0;
    text-shadow: 0 3px 2px rgba(20, 10, 4, 0.75);
}

.skinned .nav__tab--on .nav__label {
    color: #FFE082;
}

/* ---------------------------------------------------------------- Home (pack: sprites/01_home) */

.skinned .home .home__rope {
    display: flex;
    width: 10px;
    border-radius: 5px;
    background-color: #8A6234;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #5A3A1A;
}

.skinned .home .home__rope--sign-left {
    left: 368px;
    top: -400px;
    height: 430px;
}

.skinned .home .home__rope--sign-right {
    left: 702px;
    top: -400px;
    height: 430px;
}

/* The signboard carries its own rope loops at the top; the name sits on the board below them. */
.skinned .home .home__sign {
    width: 660px;
    height: 290px;
    margin-top: -60px;
    padding: 104px 70px 0 70px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/signboard_header_blank_9.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 182;
    -unity-slice-right: 186;
    -unity-slice-top: 112;
    -unity-slice-bottom: 95;
    -unity-slice-scale: 1.3px;
    -unity-slice-type: tiled;
}

.skinned .home .home__name {
    font-size: 50px;
    max-width: none;
    overflow: visible;
    text-overflow: clip;
    flex-shrink: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
    color: #FFF8E1;
    text-shadow: 0 2px 3px rgba(15, 8, 4, 0.85);
}

.skinned .home .home__shield {
    top: 196px;
    translate: -63px 0;
    width: 126px;
    height: 134px;
    padding: 0 0 8px 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/badge_level_shield_blank.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
    font-size: 48px;
    color: #FFE082;
    -unity-text-outline-width: 0;
    text-shadow: 0 3px 2px rgba(20, 10, 4, 0.75);
}

.skinned .home .home__pouch {
    top: -12px;
    right: 28px;
    width: 150px;
    height: 173px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Props/potli_currency_bag.png");
}

.skinned .home .home__coins {
    margin-bottom: -22px;
    padding: 0 18px;
    border-width: 2px;
    border-color: #2A170C;
    background-color: #4A2E1B;
    color: #FFE082;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
}

/* The arch keeps its own square proportions; slicing would stretch the crown and the peacocks. */
.skinned .home .game {
    width: 770px;
    height: 767px;
    padding: 140px 104px 74px 104px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Frames/frame_truckart_arch.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.skinned .home .game__art {
    background-image: none;
}

.skinned .home .game__name {
    font-size: 112px;
    color: #FFE082;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: #1F0E05;
    text-shadow: 0 6px 0 #0D0502;
}

.skinned .home .game__line {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    font-size: 40px;
    color: #FFF8E1;
    -unity-text-outline-width: 0;
    text-shadow: 0 3px 2px rgba(20, 10, 4, 0.75);
}

/* Seat coins: the pack paints 4, 5 and 6 into their coins, so those labels only speak to screen
   readers; the 3 coin is blank and shows its label. */
.skinned .home .medal {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    background-size: 112px 112px;
    background-repeat: no-repeat no-repeat;
    background-position-x: center;
    background-position-y: center;
    color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    font-size: 58px;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skinned .home .medal--3 {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_3_normal.png");
    color: #FFF8E1;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #1F0E05;
}

.skinned .home .medal--3:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_3_pressed.png");
}

.skinned .home .medal--4 {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_4_normal.png");
}

.skinned .home .medal--4:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_4_pressed.png");
}

.skinned .home .medal--5 {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_5_normal.png");
}

.skinned .home .medal--5:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_5_pressed.png");
}

.skinned .home .medal--6 {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_6_normal.png");
}

.skinned .home .medal--6:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Chips/chip_seat_6_pressed.png");
}

.skinned .home .medal.chip--on {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(0, 0, 0, 0);
    border-width: 5px;
    border-radius: 66px;
    border-color: rgba(255, 224, 130, 0.95);
    background-size: 120px 120px;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.skinned .home .medal--3.chip--on {
    color: #FFF8E1;
}

.skinned .home .game__mode-label {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    color: #CDB898;
    -unity-text-outline-width: 0;
    text-shadow: 0 3px 2px rgba(20, 10, 4, 0.75);
}

.skinned .home .game__mode-label--on {
    color: #FFF8E1;
}

/* The switch: the pack's track with its words painted out, and its star knob, cut free to slide. */
.skinned .home .switch {
    width: 200px;
    height: 76px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/toggle_track_blank.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .home .switch--on {
    -unity-background-image-tint-color: rgb(255, 200, 170);
}

.skinned .home .switch__knob {
    width: 70px;
    height: 70px;
    margin: -2px 0 0 10px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/toggle_knob.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .home .switch--on > .switch__knob {
    translate: 110px 0;
}

.skinned .home .game__help {
    top: 140px;
    right: 104px;
    color: #FFF8E1;
}

/* Play now on its floral plinth: the gold face is the top part of the art, so the label rides high. */
.skinned .home .game__play {
    width: 540px;
    height: 335px;
    margin-top: -72px;
    padding: 0 0 116px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_primary_normal.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
    font-size: 72px;
    letter-spacing: 3px;
    color: #1F0E05;
    -unity-text-outline-width: 0;
    text-shadow: 0 2px 0 rgba(255, 241, 118, 0.7);
}

.skinned .home .game__play:active {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Buttons/btn_primary_normal.png");
    translate: 0 6px;
    -unity-background-image-tint-color: rgb(235, 215, 190);
}

.skinned .home .home__lower {
    margin-top: -96px;
}

.skinned .home .game__art {
    height: 186px;
}

.skinned .home .game__seats {
    margin-top: -64px;
}

.skinned .home .game__mode {
    margin-top: 10px;
}

.skinned .home .home__rope--board-left {
    left: 80px;
    top: -120px;
    height: 200px;
}

.skinned .home .home__rope--board-right {
    left: 330px;
    top: -120px;
    height: 200px;
}

.skinned .home .plank, .skinned .inventory .plank, .skinned .home .hero {
