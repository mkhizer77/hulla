/* Tokens from the GDD palette (15.2). The design system pass (#23) replaces this file with generated tokens. */
:root {
    --surface-table: #1F2A2E;
    --surface-ui: #141518;
    --accent-saffron: #F4A300;
    --accent-teal: #16A085;
    --ink-ivory: #F6F1E7;
    --ink-muted: #9AA0A6;
    --surface-panel: #1C1E22;
    --accent-magenta: #D81B60;
    --accent-mustard: #E0B000;
    --suit-blue: #1E6FD9;
    --suit-green: #2E7D32;
    --surface-raised: #2A2D33;
    --state-thulla: #E53935;
    --state-escape: #43A047;
    --suit-red: #D32F2F;
    --suit-black: #1B1B1F;
    --card-face: #FBF8F2;
    --felt: #1E6B48;
    --felt-deep: #0E2219;
    --rail: #6B4423;
    --gold: #FFC24A;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --radius: 14px;
    /* 48 dp at the 1080 px reference width (GDD 27). */
    --tap: 132px;
    --font-body: 34px;
    --font-small: 26px;
    --font-title: 96px;
    -unity-font-style: normal;
    color: var(--ink-ivory);
    font-size: var(--font-body);
}

.screen {
    flex-grow: 1;
    background-color: var(--surface-ui);
    padding: var(--space-3);
}

.screen--center {
    justify-content: center;
    align-items: stretch;
}

.title {
    font-size: var(--font-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.title--small {
    font-size: 56px;
}

.subtitle {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
}

.caption {
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.panel {
    background-color: var(--surface-panel);
    border-radius: var(--radius);
    padding: var(--space-3);
}

.divider {
    height: 2px;
    background-color: var(--surface-raised);
    margin: var(--space-2) 0;
}

.field {
    flex-direction: column;
    margin-bottom: var(--space-2);
}

.field > Label {
    color: var(--ink-muted);
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.field TextInput, .field .unity-base-text-field__input {
    min-height: var(--tap);
    font-size: var(--font-body);
    background-color: #0E0F11;
    color: var(--ink-ivory);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--surface-raised);
    padding: 0 var(--space-2);
}

.button {
    min-height: var(--tap);
    margin: var(--space-1) 0;
    border-radius: var(--radius);
    border-width: 0;
    background-color: var(--surface-raised);
    color: var(--ink-ivory);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.button:hover {
    background-color: #33373E;
}

.button:disabled {
    opacity: 0.4;
}

.button--primary {
    background-color: var(--accent-saffron);
    color: #141518;
}

.button--primary:hover {
    background-color: #FFB520;
}

.button--quiet {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-muted);
}

.button--small {
    min-height: var(--tap);
    padding: 0 var(--space-2);
}

.status {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-top: var(--space-2);
    white-space: normal;
}

.code-box {
    align-items: center;
    padding: var(--space-3);
}

.code {
    font-size: 120px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: var(--accent-saffron);
}

.seats {
    flex-grow: 1;
}

.lobby-seat {
    flex-direction: row;
    align-items: center;
    padding: var(--space-2);
    margin-bottom: var(--space-1);
    background-color: var(--surface-panel);
    border-radius: var(--radius);
}

.lobby-seat__name {
    flex-grow: 1;
}

.tag, .tag--ok, .tag--muted {
    font-size: var(--font-small);
    margin-left: var(--space-1);
    padding: 4px 12px;
    border-radius: 8px;
}

.tag {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.tag--ok {
    background-color: #123A2B;
    color: var(--state-escape);
}

.tag--muted {
    color: var(--ink-muted);
}

.actions {
    padding-top: var(--space-2);
}

/* Table */
.table {
    background-color: var(--felt-deep);
    padding: var(--space-2);
}

.table__top {
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
}

.table__info {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.opponents {
    flex-shrink: 0;
    height: 27%;
    min-height: 320px;
}

.seat--placed {
    position: absolute;
    translate: -50% -50%;
}

.seat {
    width: 210px;
    margin: var(--space-1);
    align-items: center;
}

.seat--turn .seat__avatar {
    border-color: var(--gold);
    border-width: 7px;
    scale: 1.08 1.08;
}

.seat--turn .seat__name {
    color: var(--gold);
}

.seat--out {
    opacity: 0.55;
}

.seat__avatar {
    width: 116px;
    height: 116px;
    border-radius: 58px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.18);
    justify-content: center;
    align-items: center;
    background-color: #455A64;
    transition-property: scale, border-color;
    transition-duration: 160ms;
}

.seat__avatar--a { background-color: #8E44AD; }
.seat__avatar--b { background-color: #2471A3; }
.seat__avatar--c { background-color: #CA6F1E; }
.seat__avatar--d { background-color: #138D75; }
.seat__avatar--e { background-color: #B03A2E; }
.seat__avatar--f { background-color: #5D6D7E; }

.seat__initial {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--ink-ivory);
}

.seat__chip {
    position: absolute;
    right: -52px;
    bottom: -4px;
    flex-direction: row;
    align-items: center;
    padding: 2px 12px 2px 8px;
    border-radius: 999px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: #141518;
}

.seat__back {
    width: 20px;
    height: 28px;
    margin-right: 6px;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--ink-ivory);
    background-color: #B71C1C;
}

.seat__name {
    margin-top: 12px;
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 200px;
}

.seat__count {
    font-size: 30px;
    -unity-font-style: bold;
}

.seat__state {
    margin-top: 4px;
    padding: 2px 14px;
    border-radius: 999px;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.4);
    color: var(--ink-ivory);
}

.seat__state--lead {
    background-color: var(--gold);
    color: #141518;
    -unity-font-style: bold;
}

.seat__state--away {
    background-color: #6D4C41;
}

.seat__state--out {
    background-color: var(--state-escape);
}

.felt {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: var(--space-1) 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    border-radius: 380px;
    border-width: 14px;
    border-color: var(--rail);
    background-color: var(--felt);
}

.pile {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pile__slot {
    align-items: center;
    margin: 0 -20px;
}

.pile__owner {
    margin-top: 6px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--ink-ivory);
}

.pile__note {
    margin-top: var(--space-2);
    font-size: var(--font-small);
    color: rgba(246, 241, 231, 0.7);
}

.toast {
    display: none;
    position: absolute;
    font-size: 110px;
    -unity-font-style: bold;
    color: var(--state-thulla);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #141518;
}

.table__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 80px;
}

.turn {
    padding: 8px 26px;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-font-style: bold;
    color: var(--ink-ivory);
}

.turn--mine {
    background-color: var(--gold);
    color: #141518;
}

.hand {
    flex-shrink: 0;
    padding: 44px 0 var(--space-2) 0;
}

.hand__row {
    flex-direction: row;
    justify-content: center;
}

.hand__row--stacked {
    margin-bottom: -60px;
}

.hand .card {
    transition-property: translate, scale;
    transition-duration: 120ms;
}

.card {
    width: 150px;
    height: 210px;
    background-color: var(--card-face);
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: #D8D0C0;
    border-bottom-color: #A99F8B;
}

.card__corner {
    position: absolute;
    left: 10px;
    top: 6px;
    align-items: center;
}

.card__corner--bottom {
    left: auto;
    top: auto;
    right: 10px;
    bottom: 4px;
    rotate: 180deg;
}

.card__pip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 76px;
}

.card__rank, .card__suit, .card__index-suit, .card__pip {
    color: var(--suit-black);
}

.card--red .card__rank, .card--red .card__suit, .card--red .card__index-suit, .card--red .card__pip {
    color: var(--suit-red);
}

.card__rank {
    font-size: 42px;
    -unity-font-style: bold;
}

.card__suit, .card__index-suit {
    font-size: 32px;
    margin-top: -8px;
}

.card--legal {
    border-color: var(--gold);
    border-width: 4px;
    border-bottom-width: 6px;
    border-bottom-color: #C98F10;
    translate: 0 -20px;
}

.card--raised {
    translate: 0 -34px;
}

.card--hover {
    scale: 1.15 1.15;
    translate: 0 -24px;
}

.card--dim {
    opacity: 0.4;
}

.card--faded {
    opacity: 0.6;
}

.results {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    padding: var(--space-3);
}

.results__order {
    margin: var(--space-2) 0;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: var(--space-1);
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.table__bar-actions {
    flex-direction: row;
}

.table__bar-actions > .button {
    margin-left: var(--space-1);
}

.bubble {
    margin-top: 6px;
    padding: 6px 12px;
    border-radius: 12px;
    background-color: var(--ink-ivory);
    color: #141518;
    font-size: var(--font-small);
    white-space: normal;
    max-width: 200px;
    -unity-text-align: middle-center;
}

.bubble--mine {
    display: none;
    align-self: center;
    max-width: 600px;
    font-size: var(--font-body);
}

.chat-panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    padding: var(--space-2);
}

.chat-panel__scroll {
    flex-grow: 1;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
}

.chip {
    min-height: var(--tap);
    margin: 6px;
    padding: 10px 18px;
    border-radius: 999px;
    border-width: 0;
    background-color: var(--surface-raised);
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

.chip--emote {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.chips--seats {
    margin-bottom: var(--space-1);
}

.chip--seat {
    min-width: 96px;
    -unity-text-align: middle-center;
}

.chip--on {
    background-color: var(--accent-saffron);
    color: #141518;
}

.countdown {
    -unity-text-align: middle-center;
    font-size: 48px;
}

.recap {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 30%;
}

.recap__text {
    white-space: normal;
    margin: var(--space-1) 0;
}

.elapsed {
    -unity-text-align: middle-center;
}

.table__turn {
    flex-direction: row;
    align-items: center;
}

.timer {
    width: 56px;
    height: 56px;
    margin-right: var(--space-1);
}

.timer-ring {
    flex-grow: 1;
}

.hint {
    display: none;
    align-self: center;
    padding: 8px 18px;
    border-radius: 999px;
    background-color: #3A1F1F;
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

.pile__slot--fly {
    transition-property: translate;
    transition-duration: 220ms;
    transition-timing-function: ease-out-cubic;
}

.pile__slot--fade-start {
    opacity: 0;
}

.pile__slot--fade {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 200ms;
}

/* Settings (GDD 14.12, 27): classes on the shell root, applied live. */
.theme--contrast {
    --surface-ui: #000000;
    --surface-table: #000000;
    --ink-muted: #E8E8E8;
    --card-face: #FFFFFF;
}

.theme--contrast .card {
    border-color: #FFFFFF;
    border-width: 3px;
}

.theme--contrast .seat, .theme--contrast .panel, .theme--contrast .lobby-seat {
    border-width: 2px;
    border-color: #FFFFFF;
}

/* The root font size is resolved once at :root, so the scaled element sets it again for its subtree. */
.text--125, .text--150, .text--200 {
    font-size: var(--font-body);
}

.text--125 {
    --font-body: 42px;
    --font-small: 32px;
    --font-title: 110px;
}

.text--150 {
    --font-body: 51px;
    --font-small: 39px;
    --font-title: 120px;
}

.text--200 {
    --font-body: 68px;
    --font-small: 52px;
    --font-title: 128px;
}

.deck--four .card--suit-d .card__rank, .deck--four .card--suit-d .card__suit, .deck--four .card--suit-d .card__index-suit, .deck--four .card--suit-d .card__pip {
    color: #1E6FD9;
}

.deck--four .card--suit-c .card__rank, .deck--four .card--suit-c .card__suit, .deck--four .card--suit-c .card__index-suit, .deck--four .card--suit-c .card__pip {
    color: #2E7D32;
}

.cards--large .card {
    width: 180px;
    height: 252px;
}

.cards--large .card__pip {
    font-size: 92px;
}

.cards--large .card__rank {
    font-size: 52px;
}

.cards--large .card__suit, .cards--large .card__index-suit {
    font-size: 38px;
}

.hand--left .table__bar {
    flex-direction: row-reverse;
}

.hand--left .table__turn {
    flex-direction: row-reverse;
}

.table__top-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.settings__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.settings__scroll {
    flex-grow: 1;
}

.settings__heading {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
}

.settings__row {
    min-height: var(--tap);
    padding: 0 var(--space-2);
    margin-bottom: var(--space-1);
    background-color: var(--surface-panel);
    border-radius: var(--radius);
    justify-content: center;
}

.settings__row.unity-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings__row.unity-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.settings__row > Label, .settings__row Label {
    font-size: var(--font-body);
    color: var(--ink-ivory);
    white-space: normal;
}

.settings__choice {
    padding: var(--space-1) var(--space-2);
}

.settings__row .unity-toggle__checkmark {
    width: 48px;
    height: 48px;
}

.rulebook__section {
    margin-bottom: var(--space-3);
}

.rulebook__line {
    white-space: normal;
    margin-top: var(--space-1);
}

.hint {
    cursor: link;
}

.chat-panel__compose {
    flex-direction: row;
    align-items: center;
}

.chat-panel__input {
    flex-grow: 1;
    margin-bottom: 0;
    margin-right: var(--space-1);
}

.chat-log {
    margin-bottom: var(--space-2);
}

.chat-log__line {
    white-space: normal;
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.friend-row {
    flex-wrap: wrap;
}

.friend-row > .chip {
    margin: 4px;
}

.home__links {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.home__links > .button {
    margin: 0 var(--space-1);
}

.lobby-chat {
    margin-top: var(--space-1);
}

.hero {
    display: none;
    margin-bottom: var(--space-1);
}

.lobby-rules {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.lobby-rules__text {
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink-muted);
}

.coach {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 32%;
    padding: var(--space-2);
    border-radius: var(--radius);
    background-color: #2B2412;
    border-width: 3px;
    border-color: var(--accent-saffron);
}

.coach__text {
    white-space: normal;
    color: var(--ink-ivory);
    margin-bottom: var(--space-1);
}

.settings__action {
    margin-bottom: var(--space-1);
}

.player-sheet {
    top: 30%;
}

.progress-line {
    margin-top: 0;
    margin-bottom: var(--space-1);
}

.result-reward {
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Share card (GDD 10.9), drawn off screen at 1080 px wide. */
.share-card {
    flex-grow: 1;
    background-color: var(--surface-table);
    padding: 96px 80px 72px 80px;
    align-items: stretch;
}

.share-card--story {
    padding-top: 240px;
    padding-bottom: 160px;
}

.share-card__brand {
    font-size: 120px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__game {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: 48px;
}

.share-card__stamp {
    align-self: center;
    border-width: 10px;
    border-color: var(--state-thulla);
    border-radius: 24px;
    padding: 24px 56px;
    rotate: -6deg;
    margin-bottom: 56px;
}

.share-card__stamp-title {
    font-size: 104px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--state-thulla);
}

.share-card__stamp-name {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__order {
    background-color: #182226;
    border-radius: 32px;
    padding: 24px 40px;
}

.share-card__row {
    flex-direction: row;
    align-items: center;
    height: 112px;
}

.share-card__row--me .share-card__name {
    color: var(--accent-saffron);
    -unity-font-style: bold;
}

.share-card__place {
    width: 64px;
    font-size: 48px;
    color: var(--ink-muted);
}

.share-card__avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-right: 32px;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
    background-color: var(--accent-teal);
}

.share-card__avatar--1 { background-color: #8E44AD; }
.share-card__avatar--2 { background-color: #C0392B; }
.share-card__avatar--3 { background-color: #2E86C1; }
.share-card__avatar--4 { background-color: #D68910; }
.share-card__avatar--5 { background-color: #27AE60; }

.share-card__name {
    font-size: 52px;
    color: var(--ink-ivory);
}

.share-card__highlight {
    margin-top: 48px;
    font-size: 44px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__footer {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__row--loser .share-card__name {
    color: var(--state-thulla);
}

.share-card--story .share-card__brand {
    font-size: 150px;
}

.share-card--story .share-card__stamp {
    margin-top: 40px;
    margin-bottom: 96px;
}

.share-card--story .share-card__row {
    height: 140px;
}

.share-card--story .share-card__name {
    font-size: 60px;
}

.share-card--story .share-card__footer {
    font-size: 52px;
}

.daily {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}

.daily__text {
    flex-shrink: 1;
    white-space: normal;
    margin-right: var(--space-2);
    color: var(--accent-saffron);
}

.leaderboard__row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    padding: 0 var(--space-2);
    border-bottom-width: 1px;
    border-color: var(--surface-raised);
}

.leaderboard__row--me {
    background-color: #2B2412;
    border-radius: var(--radius);
}

.leaderboard__rank {
    width: 96px;
    color: var(--ink-muted);
}

.leaderboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard__points {
    color: var(--accent-saffron);
}

.leaderboard__me {
    margin-top: var(--space-1);
}

.achievement--locked {
    opacity: 0.6;
}

.shop__balances {
    color: var(--accent-saffron);
}

.shop__tabs {
    flex-shrink: 0;
    margin-bottom: var(--space-1);
}

.shop__chips {
    flex-wrap: nowrap;
}

.shop__chips .chip {
    flex-shrink: 0;
}

.shop__swatch {
    width: 72px;
    height: 96px;
    border-radius: 10px;
    margin-right: var(--space-2);
    border-width: 4px;
    border-color: var(--card-face);
}

.shop__swatch--table {
    width: 120px;
    height: 72px;
    border-radius: 36px;
    border-color: #5D4037;
}

.rarity--rare { color: #4FC3F7; }
.rarity--epic { color: #BA68C8; }
.rarity--legendary { color: var(--accent-saffron); }

.pass__row {
    flex-direction: row;
    align-items: stretch;
    min-height: 112px;
    border-bottom-width: 1px;
    border-color: var(--surface-raised);
}

.pass__row--ahead {
    opacity: 0.55;
}

.pass__tier {
    width: 80px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--accent-saffron);
}

.pass__side {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-1);
}

.pass__side--premium {
    background-color: #2B2412;
}

.pass__reward {
    flex-shrink: 1;
    white-space: normal;
    font-size: var(--font-small);
}

/* UX pass (docs/design/ux-ui-pass.md): the crown, the thulla flag, void chips, the pick-up flight, the
   quick-chat strip, the timer on a seat, the reconnect pill, a pressed and a newly arrived card. */
.seat__crown {
    position: absolute;
    top: -46px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 44px;
    color: var(--accent-saffron);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #141518;
}

.seat--leader .seat__avatar {
    border-color: var(--accent-saffron);
}

.seat__flag {
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    align-self: center;
    padding: 2px 12px;
    border-radius: 999px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
}

.seat__voids {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.seat__void {
    min-width: 34px;
    margin: 0 2px;
    padding: 0 6px;
    border-radius: 8px;
    font-size: 22px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.45);
    color: var(--ink-muted);
}

.seat__timer {
    position: absolute;
    left: -10px;
    top: -10px;
    right: -10px;
    bottom: -10px;
}

.seat__chip--bump {
    scale: 1.25 1.25;
}

.pile__slot--pickup {
    transition-property: translate, scale, opacity;
    transition-duration: 400ms;
    transition-timing-function: ease-in-out-cubic;
}

.pile__slot--gone {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
}

.quick-strip {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 var(--space-1) 0;
}

.quick-strip__chip {
    margin: 4px;
}

.quick-strip__more {
    min-width: var(--tap);
    -unity-text-align: middle-center;
}

.hand--left .quick-strip {
    flex-direction: row-reverse;
}

.card--pressed {
    translate: 0 -12px;
    scale: 1.05 1.05;
}

.card--new {
    border-color: var(--accent-teal);
    border-width: 4px;
    border-bottom-color: var(--accent-teal);
}

.banner {
    left: auto;
    right: auto;
    top: var(--space-2);
    align-self: center;
    min-width: 0;
    padding: 8px 26px;
    border-radius: 999px;
    background-color: var(--accent-mustard);
    color: #141518;
    font-size: var(--font-small);
}

.settings__level {
    flex-direction: row;
    align-items: center;
}

.settings__level > .unity-label {
    flex-grow: 1;
    min-width: 0;
}

.settings__level .unity-base-slider__input {
    min-width: 360px;
}

.settings__level .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: var(--surface-raised);
}

.settings__level .unity-base-slider__dragger {
    width: 48px;
    height: 48px;
    margin-top: -22px;
    border-radius: 24px;
    border-width: 0;
    background-color: var(--accent-saffron);
}

/* Shell and screens (design §2 to §6, §8): transitions, the bottom navigation, list states, the
   secondary button, the lobby ring, the podium, the party bar. */
.screen-anim {
    transition-property: opacity, translate;
    transition-duration: 240ms;
    transition-timing-function: ease-out-cubic;
}

.screen--enter {
    opacity: 0;
    translate: 0 24px;
}

.screen--enter-fade {
    opacity: 0;
    transition-duration: 120ms;
}

.button {
    transition-property: scale;
    transition-duration: 80ms;
}

.button:active, .chip:active {
    scale: 0.97 0.97;
}

.button--secondary {
    background-color: rgba(0, 0, 0, 0);
    border-width: 3px;
    border-color: var(--accent-teal);
    color: var(--accent-teal);
}

.button--secondary:hover {
    background-color: rgba(22, 160, 133, 0.12);
}

.nav {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-around;
    padding: 6px 0 10px 0;
    border-top-width: 2px;
    border-top-color: var(--surface-raised);
    background-color: var(--surface-ui);
}

.nav__tab {
    flex-grow: 1;
    min-height: var(--tap);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.nav__glyph {
    font-size: 44px;
    color: var(--ink-muted);
}

.nav__label {
    font-size: 22px;
    color: var(--ink-muted);
}

.nav__tab--on .nav__glyph, .nav__tab--on .nav__label {
    color: var(--accent-saffron);
}

.nav__badge {
    position: absolute;
    top: 6px;
    right: 22%;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 18px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
}

.skeleton {
    padding: var(--space-2) 0;
}

.skeleton__bar {
    height: 36px;
    margin-bottom: var(--space-2);
    border-radius: 10px;
    background-color: var(--surface-raised);
    opacity: 0.6;
}

.skeleton__bar--1 {
    width: 70%;
}

.skeleton__bar--2 {
    width: 45%;
}

.empty {
    align-items: center;
    padding: var(--space-3) var(--space-2);
}

.empty__text {
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
}

.empty--error .empty__text {
    color: var(--ink-ivory);
}

.home__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
}

.home__me {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.home__avatar {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin-right: var(--space-2);
}

.home__avatar .seat__initial {
    font-size: 44px;
}

.home__who {
    flex-shrink: 1;
    min-width: 0;
}

.home__name {
    -unity-font-style: bold;
    overflow: hidden;
}

.home__coins {
    color: var(--accent-mustard);
    -unity-font-style: bold;
    margin: 0 var(--space-1);
}

.home__title {
    font-size: 72px;
    margin-top: var(--space-1);
}

.home__quiet {
    flex-direction: row;
    justify-content: center;
}

.home__hidden {
    display: none;
}

.home__online {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--space-1);
}

.party {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
}

.party__avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin: 4px;
}

.party__initial {
    font-size: 40px;
}

.party__dot {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 4px;
    border-color: var(--surface-ui);
    background-color: var(--state-escape);
}

.party__dot--busy {
    background-color: var(--accent-saffron);
}

.lobby-share {
    justify-content: center;
    margin-top: var(--space-1);
}

.chip--share {
    background-color: var(--accent-teal);
    color: #141518;
    -unity-font-style: bold;
}

.lobby-ring {
    flex-shrink: 0;
    height: 520px;
    margin: var(--space-2) 0;
}

.lobby-watchers {
    flex-shrink: 0;
}

.seat--me .seat__name {
    color: var(--accent-saffron);
}

.seat--empty .seat__avatar {
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: var(--ink-muted);
}

.seat--empty .seat__initial, .seat--empty .seat__name {
    color: var(--ink-muted);
}

.seat--enter .seat__avatar {
    scale: 0.6 0.6;
}

.seat__avatar {
    transition-property: scale, border-color;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.seat__state--ready {
    background-color: var(--accent-teal);
    color: #141518;
    -unity-font-style: bold;
}

.results__scroll {
    flex-shrink: 1;
    min-height: 0;
    max-height: 60%;
}

.podium {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-bottom: var(--space-2);
}

.podium__place {
    align-items: center;
    width: 200px;
}

.podium__place--1 .podium__avatar {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-color: var(--accent-saffron);
    border-width: 6px;
}

.podium__place--1 .podium__name {
    -unity-font-style: bold;
}

.podium__place--loser {
    margin-left: var(--space-2);
}

.podium__place--loser .podium__avatar {
    border-color: var(--state-thulla);
    border-width: 6px;
}

.podium__avatar {
    width: 116px;
    height: 116px;
    border-radius: 58px;
}

.podium__avatar--me {
    border-color: var(--ink-ivory);
}

.podium__name {
    margin-top: 6px;
    font-size: var(--font-small);
    overflow: hidden;
    max-width: 190px;
}

.podium__rank {
    font-size: 22px;
    color: var(--ink-muted);
}

.results__loser {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.results__title {
    flex-shrink: 1;
    white-space: normal;
}

.results__stamp {
    margin-left: var(--space-2);
    padding: 4px 14px;
    rotate: -6deg;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--state-thulla);
    border-width: 4px;
    border-color: var(--state-thulla);
    border-radius: 8px;
}

.chip--fair {
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--accent-teal);
    color: var(--accent-teal);
}

.results__again {
    flex-direction: row;
    align-items: center;
}

.results__play {
    flex-grow: 1;
}

.podium__votes {
    flex-direction: row;
    margin-left: var(--space-1);
}

.podium__avatar--vote {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-left: -12px;
}

.podium__avatar--vote .seat__initial {
    font-size: 30px;
}

.results__quiet {
    flex-direction: row;
    justify-content: center;
}

/* The look (design §3, until the art lands): two typefaces, a textured ground, felt and rail,
   gradients and a bottom shadow on controls, shaded avatars, drawn card faces, a rubber stamp. */
:root {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Nunito.ttf");
}

.title, .code, .toast, .results__stamp, .home__title, .seat__initial, .card__rank, .card__court, .nav__glyph, .podium__rank, .turn, .hero, .button--primary, .countdown, .results__title, .coach__text, .daily__text {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
}

.title, .home__title, .code {
    text-shadow: 0 6px 0 rgba(0, 0, 0, 0.55);
}

.home__title {
    font-size: 128px;
    letter-spacing: 6px;
    color: var(--accent-saffron);
}

.screen {
    background-color: var(--surface-ui);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.rail {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: var(--space-1) 0;
    padding: 18px;
    border-radius: 400px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/rail.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.felt {
    flex-grow: 1;
    margin: 0;
    border-width: 0;
    border-radius: 380px;
    background-color: var(--felt);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/felt.png");
    -unity-background-scale-mode: scale-and-crop;
}

.button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 6px;
    border-bottom-color: #121316;
    border-radius: 18px;
}

.button--primary {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    border-bottom-color: #8F6200;
    color: #2A1A00;
    font-size: 40px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

.button--secondary {
    background-image: none;
    background-color: rgba(22, 160, 133, 0.08);
    border-bottom-width: 3px;
    border-bottom-color: var(--accent-teal);
}

.button--quiet {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

.button:disabled {
    opacity: 0.45;
}

.chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 4px;
    border-bottom-color: #121316;
}

.chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    border-bottom-color: #8F6200;
    color: #2A1A00;
}

.chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-teal.png");
    border-bottom-color: #0B5A4B;
}

.chip--emote, .chip--fair, .quick-strip__more {
    background-image: none;
}

.panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/panel9.png");
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 1px;
    padding: 36px 40px 44px 40px;
    margin: -8px 0 4px 0;
}

.lobby-seat, .settings__row, .leaderboard__row {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.seat__avatar, .home__avatar, .party__avatar, .podium__avatar {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/sphere.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #607D8B;
    border-color: rgba(255, 255, 255, 0.35);
}

.seat__avatar--a { -unity-background-image-tint-color: #9B59B6; background-color: #9B59B6; }
.seat__avatar--b { -unity-background-image-tint-color: #2E86C1; background-color: #2E86C1; }
.seat__avatar--c { -unity-background-image-tint-color: #E67E22; background-color: #E67E22; }
.seat__avatar--d { -unity-background-image-tint-color: #17A589; background-color: #17A589; }
.seat__avatar--e { -unity-background-image-tint-color: #CB4335; background-color: #CB4335; }
.seat__avatar--f { -unity-background-image-tint-color: #7F8C8D; background-color: #7F8C8D; }

.seat--empty .seat__avatar {
    background-image: none;
}

.seat__initial {
    font-size: 60px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

.seat__back {
    width: 24px;
    height: 34px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/card-back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.seat__chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-color: rgba(255, 255, 255, 0.35);
}

.nav {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
    border-top-color: rgba(244, 163, 0, 0.35);
}

.nav__tab--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/glow-saffron.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.3);
}

.card {
    border-width: 2px;
    border-bottom-width: 8px;
    border-color: #E6DFD0;
    border-bottom-color: #9C9280;
    border-radius: 16px;
}

.card__field {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 50px;
    bottom: 50px;
}

.card__court {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 88px;
    color: var(--suit-black);
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
}

.card--red .card__court {
    color: var(--suit-red);
}

.deck--four .card--suit-d .card__court {
    color: var(--suit-blue);
}

.deck--four .card--suit-c .card__court {
    color: var(--suit-green);
}

.cards--large .card__field {
    left: 28px;
    right: 28px;
    top: 60px;
    bottom: 60px;
}

.cards--large .card__court {
    font-size: 104px;
}

.card__rank {
    font-size: 46px;
}

.card--legal {
    border-color: var(--accent-saffron);
    border-bottom-color: #B07500;
}

.toast {
    font-size: 124px;
    padding: 18px 54px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/stamp9.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 1px;
    -unity-text-outline-width: 0;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 4px;
}

.results__stamp {
    border-width: 0;
    padding: 10px 28px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/stamp9.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.6px;
    letter-spacing: 2px;
}

.hero {
    min-height: 190px;
    font-size: 48px;
    white-space: normal;
}

.turn {
    font-size: 36px;
    letter-spacing: 1px;
}

.turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    -unity-background-scale-mode: stretch-to-fill;
    color: #2A1A00;
}

.code {
    letter-spacing: 16px;
}

.seat--turn .seat__avatar {
    border-color: var(--accent-saffron);
}

.timer-ring {
    opacity: 0.95;
}

.daily {
    padding: var(--space-2);
    border-radius: var(--radius);
    background-color: rgba(244, 163, 0, 0.08);
    border-width: 2px;
    border-color: rgba(244, 163, 0, 0.35);
}

.results__panel {
    max-height: 92%;
}

.settings__heading {
    color: var(--accent-saffron);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.screen, .table, .nav {
    background-size: 768px 768px;
}

.chip {
    min-width: 150px;
    border-radius: 30px;
    padding: 0 28px;
    -unity-text-align: middle-center;
}

.chip--seat {
    min-width: 132px;
}

.seat__flag {
    top: -44px;
}

.card__court {
    font-size: 72px;
}

.cards--large .card__court {
    font-size: 88px;
}

.card__field {
    top: 54px;
    bottom: 54px;
}

.hand {
    padding-bottom: 52px;
}

/* Avatars (GDD 15.6): a face from the set on the circle, the "You" tag on the player's own seat. */
.seat__avatar--image {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
}

.seat__you {
    position: absolute;
    bottom: -14px;
    align-self: center;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: var(--accent-saffron);
    color: #141518;
}

.seat--empty .seat__you {
    display: none;
}

.table__me {
    flex-shrink: 0;
}

.me-badge {
    width: auto;
    flex-direction: row;
    align-items: center;
    margin: 0 var(--space-2) 0 0;
}

.me-badge .seat__avatar {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
}

.me-badge .seat__initial {
    font-size: 30px;
}

.me-badge .seat__name {
    margin-top: 0;
    margin-left: 12px;
    max-width: 230px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.me-badge .seat__you {
    bottom: -12px;
    font-size: 16px;
    padding: 0 8px;
}

.seat--me .seat__name {
    margin-top: 20px;
}

.seat--turn.me-badge .seat__avatar {
    border-width: 4px;
    scale: 1 1;
}

.me-badge .seat__crown {
    top: -30px;
    font-size: 26px;
}

.share-card__avatar {
    justify-content: center;
    align-items: center;
}
