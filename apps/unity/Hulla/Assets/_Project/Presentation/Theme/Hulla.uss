/* Tokens from the GDD palette (15.2). The design system pass (#23) replaces this file with generated tokens. */
:root {
    --surface-table: #1F2A2E;
    --surface-ui: #141518;
    --accent-saffron: #F4A300;
    --accent-teal: #16A085;
    --ink-ivory: #F6F1E7;
    --ink-muted: #9AA0A6;
    --surface-panel: #1C1E22;
    --accent-magenta: #D81B60;
    --accent-mustard: #E0B000;
    --suit-blue: #1E6FD9;
    --suit-green: #2E7D32;
    --surface-raised: #2A2D33;
    --state-thulla: #E53935;
    --state-escape: #43A047;
    --suit-red: #D32F2F;
    --suit-black: #1B1B1F;
    --card-face: #FBF8F2;
    --felt: #1E6B48;
    --felt-deep: #0E2219;
    --rail: #6B4423;
    --gold: #FFC24A;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --radius: 14px;
    /* 48 dp at the 1080 px reference width (GDD 27). */
    --tap: 132px;
    --font-body: 38px;
    --font-small: 30px;
    --font-title: 96px;
    -unity-font-style: normal;
    color: var(--ink-ivory);
    font-size: var(--font-body);
}

.screen {
    flex-grow: 1;
    background-color: var(--surface-ui);
    padding: var(--space-3);
}

.screen--center {
    justify-content: center;
    align-items: stretch;
}

.title {
    font-size: var(--font-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.title--small {
    font-size: 56px;
}

.subtitle {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
}

.caption {
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.panel {
    background-color: var(--surface-panel);
    border-radius: var(--radius);
    padding: var(--space-3);
}

.divider {
    height: 2px;
    background-color: var(--surface-raised);
    margin: var(--space-2) 0;
}

.field {
    flex-direction: column;
    margin-bottom: var(--space-2);
}

.field > Label {
    color: var(--ink-muted);
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.field TextInput, .field .unity-base-text-field__input {
    min-height: var(--tap);
    font-size: var(--font-body);
    background-color: #0E0F11;
    color: var(--ink-ivory);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--surface-raised);
    padding: 0 var(--space-2);
}

.button {
    min-height: var(--tap);
    margin: var(--space-1) 0;
    border-radius: var(--radius);
    border-width: 0;
    background-color: var(--surface-raised);
    color: var(--ink-ivory);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.button:hover {
    background-color: #33373E;
}

.button:disabled {
    opacity: 0.4;
}

.button--primary {
    background-color: var(--accent-saffron);
    color: #141518;
}

.button--primary:hover {
    background-color: #FFB520;
}

.button--quiet {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-muted);
}

.button--small {
    min-height: var(--tap);
    padding: 0 var(--space-2);
}

.status {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-top: var(--space-2);
    white-space: normal;
}

.code-box {
    align-items: center;
    padding: var(--space-3);
}

.code {
    font-size: 120px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: var(--accent-saffron);
}

.seats {
    flex-grow: 1;
}

.lobby-seat {
    flex-direction: row;
    align-items: center;
    padding: var(--space-2);
    margin-bottom: var(--space-1);
    background-color: var(--surface-panel);
    border-radius: var(--radius);
}

.lobby-seat__name {
    flex-grow: 1;
}

.tag, .tag--ok, .tag--muted {
    font-size: var(--font-small);
    margin-left: var(--space-1);
    padding: 4px 12px;
    border-radius: 8px;
}

.tag {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.tag--ok {
    background-color: #123A2B;
    /* Brighter than --state-escape so "Done" and "Equipped" read at 4.5:1 (GDD 27). */
    color: #5BE37A;
}

.tag--muted {
    color: var(--ink-muted);
}

.actions {
    padding-top: var(--space-2);
}

/* Table */
.table {
    background-color: var(--felt-deep);
    padding: var(--space-2);
}

.table__top {
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
}

.table__info {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.opponents {
    flex-shrink: 0;
    height: 27%;
    min-height: 320px;
}

.seat--placed {
    position: absolute;
    translate: -50% -50%;
}

.seat {
    width: 210px;
    margin: var(--space-1);
    align-items: center;
}

.seat--turn .seat__avatar {
    border-color: var(--gold);
    border-width: 7px;
}

.seat--turn .seat__name {
    color: var(--gold);
}

.seat--out {
    opacity: 0.55;
}

/* An escaped seat: the avatar wears the escape colour and a tick, so "done, now watching" reads at a glance. */
.seat--out .seat__avatar {
    border-width: 4px;
    border-color: var(--state-escape);
}

.seat__avatar {
    width: 116px;
    height: 116px;
    border-radius: 58px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.18);
    justify-content: center;
    align-items: center;
    background-color: #455A64;
    transition-property: scale, border-color;
    transition-duration: 160ms;
}

.seat__avatar--a { background-color: #8E44AD; }
.seat__avatar--b { background-color: #2471A3; }
.seat__avatar--c { background-color: #CA6F1E; }
.seat__avatar--d { background-color: #138D75; }
.seat__avatar--e { background-color: #B03A2E; }
.seat__avatar--f { background-color: #5D6D7E; }

.seat__initial {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--ink-ivory);
}

.seat__chip {
    position: absolute;
    right: -52px;
    bottom: -4px;
    flex-direction: row;
    align-items: center;
    padding: 2px 12px 2px 8px;
    border-radius: 999px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: #141518;
}

.seat__back {
    width: 20px;
    height: 28px;
    margin-right: 6px;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--ink-ivory);
    background-color: #B71C1C;
}

.seat__name {
    margin-top: 12px;
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 200px;
}

.seat__count {
    font-size: 30px;
    -unity-font-style: bold;
}

.seat__state {
    margin-top: 4px;
    padding: 2px 14px;
    border-radius: 999px;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.4);
    color: var(--ink-ivory);
}

.seat__state--lead {
    background-color: var(--gold);
    color: #141518;
    -unity-font-style: bold;
}

.seat__state--away {
    background-color: #6D4C41;
}

.seat__state--out {
    background-color: var(--state-escape);
}

.felt {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: var(--space-1) 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    border-radius: 380px;
    border-width: 14px;
    border-color: var(--rail);
    background-color: var(--felt);
}

.pile {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pile__slot {
    align-items: center;
    margin: 0 -20px;
}

.pile__owner {
    margin-top: 6px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0.35);
    color: var(--ink-ivory);
}

.pile__note {
    margin-top: var(--space-2);
    font-size: var(--font-small);
    color: rgba(246, 241, 231, 0.7);
}

/* The discard stack at the felt's edge: face-down cards and the count of cards out of play. */
.discard {
    display: none;
    position: absolute;
    left: 12%;
    bottom: 10%;
    flex-direction: row;
    align-items: center;
}

.discard__text {
    margin-left: 14px;
}

.discard__stack {
    width: 66px;
    height: 92px;
}

.discard__card {
    position: absolute;
    left: 0;
    top: 0;
    width: 66px;
    height: 92px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(246, 241, 231, 0.55);
    background-color: #2C3E6B;
}

.discard__card--2 {
    translate: 3px -3px;
    rotate: -5deg;
}

.discard__card--3 {
    translate: 6px -6px;
    rotate: 4deg;
}

.discard__stack--empty .discard__card {
    opacity: 0.25;
}

.discard__count {
    margin-top: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink-ivory);
    transition-property: scale;
    transition-duration: 120ms;
}

.discard__count--bump {
    scale: 1.3 1.3;
}

.discard__label {
    font-size: 20px;
    color: rgba(246, 241, 231, 0.7);
}

.toast {
    display: none;
    position: absolute;
    font-size: 110px;
    -unity-font-style: bold;
    color: var(--state-thulla);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #141518;
}

.table__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 80px;
}

.turn {
    padding: 8px 26px;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-font-style: bold;
    color: var(--ink-ivory);
}

.turn--mine {
    background-color: var(--gold);
    color: #141518;
}

.hand {
    flex-shrink: 0;
    padding: 44px 0 var(--space-2) 0;
}

.hand__row {
    flex-direction: row;
    justify-content: center;
}

.hand__row--stacked {
    margin-bottom: -60px;
}

.hand .card {
    transition-property: translate, scale;
    transition-duration: 120ms;
}

.card {
    width: 150px;
    height: 210px;
    background-color: var(--card-face);
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: #D8D0C0;
    border-bottom-color: #A99F8B;
}

.card__corner {
    position: absolute;
    left: 10px;
    top: 6px;
    align-items: center;
}

.card__corner--bottom {
    left: auto;
    top: auto;
    right: 10px;
    bottom: 4px;
    rotate: 180deg;
}

.card__pip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 76px;
}

.card__rank, .card__suit, .card__index-suit, .card__pip {
    color: var(--suit-black);
}

.card--red .card__rank, .card--red .card__suit, .card--red .card__index-suit, .card--red .card__pip {
    color: var(--suit-red);
}

.card__rank {
    font-size: 42px;
    -unity-font-style: bold;
}

.card__suit, .card__index-suit {
    font-size: 32px;
    margin-top: -8px;
}

.card--legal {
    border-color: var(--gold);
    border-width: 4px;
    border-bottom-width: 6px;
    border-bottom-color: #C98F10;
    translate: 0 -20px;
}

.card--raised {
    translate: 0 -34px;
}

.card--hover {
    scale: 1.15 1.15;
    translate: 0 -24px;
}

/* A card that cannot be played, or the last trick at rest: a shade over the face, never transparency,
   so overlapping cards do not show through each other. */
.card__shade {
    display: none;
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -8px;
    border-radius: 16px;
    background-color: rgba(18, 16, 26, 0.42);
}

.card--dim > .card__shade {
    display: flex;
}

.card--faded > .card__shade {
    display: flex;
    background-color: rgba(18, 16, 26, 0.3);
}

.results {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    padding: var(--space-3);
}

.results__order {
    margin: var(--space-2) 0;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: var(--space-1);
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.table__bar-actions {
    flex-direction: row;
}

.table__bar-actions > .button {
    margin-left: var(--space-1);
}

.bubble {
    margin-top: 6px;
    padding: 6px 12px;
    border-radius: 12px;
    background-color: var(--ink-ivory);
    color: #141518;
    font-size: var(--font-small);
    white-space: normal;
    max-width: 200px;
    -unity-text-align: middle-center;
}

.bubble--mine {
    display: none;
    align-self: center;
    max-width: 600px;
    font-size: var(--font-body);
}

.chat-panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    padding: var(--space-2);
}

.chat-panel__scroll {
    flex-grow: 1;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
}

.chip {
    min-height: var(--tap);
    margin: 6px;
    padding: 10px 18px;
    border-radius: 999px;
    border-width: 0;
    background-color: var(--surface-raised);
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

.chip--emote {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.chips--seats {
    margin-bottom: var(--space-1);
}

.chip--seat {
    min-width: 96px;
    -unity-text-align: middle-center;
}

.chip--on {
    background-color: var(--accent-saffron);
    color: #141518;
}

.countdown {
    -unity-text-align: middle-center;
    font-size: 48px;
}

.recap {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 30%;
}

.recap__text {
    white-space: normal;
    margin: var(--space-1) 0;
}

.elapsed {
    -unity-text-align: middle-center;
}

.table__turn {
    flex-direction: row;
    align-items: center;
}

.timer {
    width: 56px;
    height: 56px;
    margin-right: var(--space-1);
}

.timer-ring {
    flex-grow: 1;
}

.hint {
    display: none;
    align-self: center;
    padding: 8px 18px;
    border-radius: 999px;
    background-color: #3A1F1F;
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

/* A played card travels from the hand or the seat to the trick, growing or shrinking to its size there. */
.pile__slot--fly {
    transition-property: translate, scale, rotate;
    transition-duration: 340ms;
    transition-timing-function: ease-out-cubic;
}

.pile__slot--flying > .pile__owner {
    opacity: 0;
}

.pile__slot--fade-start {
    opacity: 0;
}

.pile__slot--fade {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 200ms;
}

/* Settings (GDD 14.12, 27): classes on the shell root, applied live. */
.theme--contrast {
    --surface-ui: #000000;
    --surface-table: #000000;
    --ink-muted: #E8E8E8;
    --card-face: #FFFFFF;
}

.theme--contrast .card {
    border-color: #FFFFFF;
    border-width: 3px;
}

.theme--contrast .seat, .theme--contrast .panel, .theme--contrast .lobby-seat {
    border-width: 2px;
    border-color: #FFFFFF;
}

/* The root font size is resolved once at :root, so the scaled element sets it again for its subtree. */
.text--125, .text--150, .text--200 {
    font-size: var(--font-body);
}

.text--125 {
    --font-body: 47px;
    --font-small: 37px;
    --font-title: 110px;
}

.text--150 {
    --font-body: 57px;
    --font-small: 45px;
    --font-title: 120px;
}

.text--200 {
    --font-body: 76px;
    --font-small: 60px;
    --font-title: 128px;
}

.deck--four .card--suit-d .card__rank, .deck--four .card--suit-d .card__suit, .deck--four .card--suit-d .card__index-suit, .deck--four .card--suit-d .card__pip {
    color: #1E6FD9;
}

.deck--four .card--suit-c .card__rank, .deck--four .card--suit-c .card__suit, .deck--four .card--suit-c .card__index-suit, .deck--four .card--suit-c .card__pip {
    color: #2E7D32;
}

.cards--large .card {
    width: 180px;
    height: 252px;
}

.cards--large .card__pip {
    font-size: 92px;
}

.cards--large .card__rank {
    font-size: 52px;
}

.cards--large .card__suit, .cards--large .card__index-suit {
    font-size: 38px;
}

.hand--left .table__bar {
    flex-direction: row-reverse;
}

.hand--left .table__turn {
    flex-direction: row-reverse;
}

.table__top-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.settings__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.settings__scroll {
    flex-grow: 1;
}

.settings__heading {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
}

.settings__row {
    min-height: var(--tap);
    padding: 0 var(--space-2);
    margin-bottom: var(--space-1);
    background-color: var(--surface-panel);
    border-radius: var(--radius);
    justify-content: center;
}

.settings__row.unity-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings__row.unity-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.settings__row > Label, .settings__row Label {
    font-size: var(--font-body);
    color: var(--ink-ivory);
    white-space: normal;
}

.settings__choice {
    padding: var(--space-1) var(--space-2);
}

.settings__row .unity-toggle__checkmark {
    width: 48px;
    height: 48px;
}

.rulebook__section {
    margin-bottom: var(--space-3);
}

.rulebook__line {
    white-space: normal;
    margin-top: var(--space-1);
}

.hint {
    cursor: link;
}

.chat-panel__compose {
    flex-direction: row;
    align-items: center;
}

.chat-panel__input {
    flex-grow: 1;
    margin-bottom: 0;
    margin-right: var(--space-1);
}

.chat-log {
    margin-bottom: var(--space-2);
}

.chat-log__line {
    white-space: normal;
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.friend-row {
    flex-wrap: wrap;
}

.friend-row > .chip {
    margin: 4px;
}

.home__links {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.home__links > .button {
    margin: 0 var(--space-1);
}

.lobby-chat {
    margin-top: var(--space-1);
}

.hero {
    display: none;
    margin-bottom: var(--space-1);
}

.lobby-rules {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.lobby-rules__text {
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink-muted);
}

.coach {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 32%;
    padding: var(--space-2);
    border-radius: var(--radius);
    background-color: #2B2412;
    border-width: 3px;
    border-color: var(--accent-saffron);
}

.coach__text {
    white-space: normal;
    color: var(--ink-ivory);
    margin-bottom: var(--space-1);
}

.settings__action {
    margin-bottom: var(--space-1);
}

.player-sheet {
    top: 30%;
}

.progress-line {
    margin-top: 0;
    margin-bottom: var(--space-1);
    white-space: normal;
}

.result-reward {
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Share card (GDD 10.9), drawn off screen at 1080 px wide. */
.share-card {
    flex-grow: 1;
    background-color: var(--surface-table);
    padding: 96px 80px 72px 80px;
    align-items: stretch;
}

.share-card--story {
    padding-top: 240px;
    padding-bottom: 160px;
}

.share-card__brand {
    font-size: 120px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__game {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: 48px;
}

.share-card__stamp {
    align-self: center;
    border-width: 10px;
    border-color: var(--state-thulla);
    border-radius: 24px;
    padding: 24px 56px;
    rotate: -6deg;
    margin-bottom: 56px;
}

.share-card__stamp-title {
    font-size: 104px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--state-thulla);
}

.share-card__stamp-name {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__order {
    background-color: #182226;
    border-radius: 32px;
    padding: 24px 40px;
}

.share-card__row {
    flex-direction: row;
    align-items: center;
    height: 112px;
}

.share-card__row--me .share-card__name {
    color: var(--accent-saffron);
    -unity-font-style: bold;
}

.share-card__place {
    width: 64px;
    font-size: 48px;
    color: var(--ink-muted);
}

.share-card__avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-right: 32px;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
    background-color: var(--accent-teal);
}

.share-card__avatar--1 { background-color: #8E44AD; }
.share-card__avatar--2 { background-color: #C0392B; }
.share-card__avatar--3 { background-color: #2E86C1; }
.share-card__avatar--4 { background-color: #D68910; }
.share-card__avatar--5 { background-color: #27AE60; }

.share-card__name {
    font-size: 52px;
    color: var(--ink-ivory);
}

.share-card__highlight {
    margin-top: 48px;
    font-size: 44px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__footer {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__row--loser .share-card__name {
    color: var(--state-thulla);
}

.share-card--story .share-card__brand {
    font-size: 150px;
}

.share-card--story .share-card__stamp {
    margin-top: 40px;
    margin-bottom: 96px;
}

.share-card--story .share-card__row {
    height: 140px;
}

.share-card--story .share-card__name {
    font-size: 60px;
}

.share-card--story .share-card__footer {
    font-size: 52px;
}

.daily {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}

.daily__text {
    flex-shrink: 1;
    white-space: normal;
    margin-right: var(--space-2);
    color: var(--accent-saffron);
}

.leaderboard__row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    padding: 0 var(--space-2);
    border-bottom-width: 1px;
    border-color: var(--surface-raised);
}

.leaderboard__row--me {
    background-color: #2B2412;
    border-radius: var(--radius);
}

.leaderboard__rank {
    width: 96px;
    color: var(--ink-muted);
}

.leaderboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard__points {
    color: var(--accent-saffron);
}

.leaderboard__me {
    margin-top: var(--space-1);
    padding: 0;
}

.leaderboard__me > .leaderboard__row {
    flex-grow: 1;
    border-bottom-width: 0;
}

.achievement--locked {
    opacity: 0.6;
}

.shop__balances {
    color: var(--accent-saffron);
}

.shop__tabs {
    flex-shrink: 0;
    margin-bottom: var(--space-1);
}

.shop__chips {
    flex-wrap: nowrap;
}

.shop__chips .chip {
    flex-shrink: 0;
}

.shop__swatch {
    width: 72px;
    height: 96px;
    border-radius: 10px;
    margin-right: var(--space-2);
    border-width: 4px;
    border-color: var(--card-face);
}

.shop__swatch--table {
    width: 120px;
    height: 72px;
    border-radius: 36px;
    border-color: #5D4037;
}

.rarity--rare { color: #4FC3F7; }
.rarity--epic { color: #BA68C8; }
.rarity--legendary { color: var(--accent-saffron); }

.pass__row {
    flex-direction: row;
    align-items: stretch;
    min-height: 112px;
    border-bottom-width: 1px;
    border-color: var(--surface-raised);
}

.pass__row--ahead {
    opacity: 0.55;
}

.pass__tier {
    width: 80px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--accent-saffron);
}

.pass__side {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-1);
}

.pass__side--premium {
    background-color: rgba(255, 200, 80, 0.07);
    border-left-width: 2px;
    border-color: rgba(255, 200, 80, 0.35);
}

.pass__header {
    align-items: center;
    margin-bottom: var(--space-2);
}

.pass__header > .meter {
    align-self: stretch;
    margin: 12px 0 16px 0;
}

/* A thin progress bar (Meter): XP on Home, each mission, the pass tier. */
.meter {
    height: 14px;
    margin-top: 10px;
    border-radius: 7px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.14);
}

.meter__fill {
    height: 100%;
    border-radius: 7px;
    background-color: var(--accent-saffron);
}

.meter--full > .meter__fill {
    background-color: #5BE37A;
}

.leaderboard__rank--1 {
    color: #FFD34D;
    -unity-font-style: bold;
}

.leaderboard__rank--2 {
    color: #D9E1EA;
    -unity-font-style: bold;
}

.leaderboard__rank--3 {
    color: #E0995E;
    -unity-font-style: bold;
}

.pass__reward {
    flex-shrink: 1;
    white-space: normal;
    font-size: var(--font-small);
}

/* UX pass (docs/design/ux-ui-pass.md): the crown, the thulla flag, void chips, the pick-up flight, the
   quick-chat strip, the timer on a seat, the reconnect pill, a pressed and a newly arrived card. */
.seat__crown {
    position: absolute;
    top: -46px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 44px;
    color: var(--accent-saffron);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #141518;
}

.seat--leader .seat__avatar {
    border-color: var(--accent-saffron);
}

.seat__flag {
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    align-self: center;
    padding: 2px 12px;
    border-radius: 999px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
}

.seat__voids {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
}

.seat__void {
    min-width: 34px;
    margin: 0 2px;
    padding: 0 6px;
    border-radius: 8px;
    font-size: 22px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.45);
    color: var(--ink-muted);
}

.seat__timer {
    position: absolute;
    left: -10px;
    top: -10px;
    right: -10px;
    bottom: -10px;
}

.seat__chip--bump {
    scale: 1.25 1.25;
}

/* A resolved trick travels to the discard or the picker and stays solid until it is there. */
.pile__slot--pickup {
    transition-property: translate, scale, rotate, opacity;
    transition-duration: 460ms, 460ms, 460ms, 100ms;
    transition-delay: 0ms, 0ms, 0ms, 380ms;
    transition-timing-function: ease-in-out-cubic;
}

.pile__slot--gone {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 300ms;
}

/* A picked-up card gliding into my hand keeps its size and only fades in the last stretch, as the
   card in the fan takes over. */
.pile__slot--slot-in {
    transition-property: translate, rotate, opacity;
    transition-duration: 460ms, 460ms, 100ms;
    transition-delay: 0ms, 0ms, 380ms;
    transition-timing-function: ease-in-out-cubic;
}

/* A card in the hand whose flight from the table has not landed yet. */
.card--arriving {
    opacity: 0;
}

.quick-strip {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin: 0 0 var(--space-1) 0;
}

.quick-strip__chip {
    margin: 4px;
}

.quick-strip__more {
    min-width: var(--tap);
    -unity-text-align: middle-center;
}

.hand--left .quick-strip {
    flex-direction: row-reverse;
}

.card--pressed {
    translate: 0 -12px;
    scale: 1.05 1.05;
}

.card--new {
    border-color: var(--accent-teal);
    border-width: 4px;
    border-bottom-color: var(--accent-teal);
}

.banner {
    left: auto;
    right: auto;
    top: var(--space-2);
    align-self: center;
    min-width: 0;
    padding: 8px 26px;
    border-radius: 999px;
    background-color: var(--accent-mustard);
    color: #141518;
    font-size: var(--font-small);
}

.settings__level {
    flex-direction: row;
    align-items: center;
}

.settings__level > .unity-label {
    flex-grow: 1;
    min-width: 0;
}

.settings__level .unity-base-slider__input {
    min-width: 360px;
}

.settings__level .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: var(--surface-raised);
}

.settings__level .unity-base-slider__dragger {
    width: 48px;
    height: 48px;
    margin-top: -22px;
    border-radius: 24px;
    border-width: 0;
    background-color: var(--accent-saffron);
}

/* Shell and screens (design §2 to §6, §8): transitions, the bottom navigation, list states, the
   secondary button, the lobby ring, the podium, the party bar. */
.screen-anim {
    transition-property: opacity, translate;
    transition-duration: 240ms;
    transition-timing-function: ease-out-cubic;
}

.screen--enter {
    opacity: 0;
    translate: 0 24px;
}

.screen--enter-fade {
    opacity: 0;
    transition-duration: 120ms;
}

.button {
    transition-property: scale;
    transition-duration: 80ms;
}

.button:active, .chip:active {
    scale: 0.97 0.97;
}

.button--secondary {
    background-color: rgba(0, 0, 0, 0);
    border-width: 3px;
    border-color: var(--accent-teal);
    color: var(--accent-teal);
}

.button--secondary:hover {
    background-color: rgba(22, 160, 133, 0.12);
}

.nav {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-around;
    padding: 6px 0 10px 0;
    border-top-width: 2px;
    border-top-color: var(--surface-raised);
    background-color: var(--surface-ui);
}

.nav__tab {
    flex-grow: 1;
    min-height: var(--tap);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.nav__glyph {
    font-size: 44px;
    color: var(--ink-muted);
}

.nav__label {
    font-size: 22px;
    color: var(--ink-muted);
}

.nav__tab--on .nav__glyph, .nav__tab--on .nav__label {
    color: var(--accent-saffron);
}

.nav__badge {
    position: absolute;
    top: 6px;
    right: 22%;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 18px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
}

.skeleton {
    padding: var(--space-2) 0;
}

.skeleton__bar {
    height: 36px;
    margin-bottom: var(--space-2);
    border-radius: 10px;
    background-color: var(--surface-raised);
    opacity: 0.6;
}

.skeleton__bar--1 {
    width: 70%;
}

.skeleton__bar--2 {
    width: 45%;
}

.empty {
    align-items: center;
    padding: var(--space-3) var(--space-2);
}

.empty__text {
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
}

.empty--error .empty__text {
    color: var(--ink-ivory);
}

.home__hidden {
    display: none;
}

.home__online {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: var(--space-1);
}

.party {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
}

.party__avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin: 4px;
}

.party__initial {
    font-size: 40px;
}

.party__dot {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 4px;
    border-color: var(--surface-ui);
    background-color: var(--state-escape);
}

.party__dot--busy {
    background-color: var(--accent-saffron);
}

.lobby-share {
    justify-content: center;
    margin-top: var(--space-1);
}

.chip--share {
    background-color: var(--accent-teal);
    color: #141518;
    -unity-font-style: bold;
}

.lobby-ring {
    flex-shrink: 0;
    height: 660px;
    margin: var(--space-2) 0;
}

/* The lobby is the table before the deal: the theme's table under the seats. */
.lobby-table {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 4%;
    bottom: 10%;
    border-radius: 48px;
    background-color: var(--felt);
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .lobby-table {
    background-color: rgba(0, 0, 0, 0);
}

.lobby-watchers {
    flex-shrink: 0;
}

.seat--me .seat__name {
    color: var(--accent-saffron);
}

.seat--empty .seat__avatar {
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: var(--ink-muted);
}

.seat--empty .seat__initial, .seat--empty .seat__name {
    color: var(--ink-muted);
}

.seat--enter .seat__avatar {
    scale: 0.6 0.6;
}

.seat__avatar {
    transition-property: scale, border-color;
    transition-duration: 220ms;
    transition-timing-function: ease-out-back;
}

.seat__state--ready {
    background-color: var(--accent-teal);
    color: #141518;
    -unity-font-style: bold;
}

.results__scroll {
    flex-shrink: 1;
    min-height: 0;
    max-height: 60%;
}

.podium {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-bottom: var(--space-2);
}

.podium__stand {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.podium__place {
    align-items: center;
    width: 200px;
}

.podium__place--1 .podium__avatar {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-color: var(--accent-saffron);
    border-width: 6px;
}

.podium__place--1 .podium__name {
    -unity-font-style: bold;
}

.podium__place--loser {
    margin-left: var(--space-2);
}

.podium__place--loser .podium__avatar {
    border-color: var(--state-thulla);
    border-width: 6px;
}

.podium__avatar {
    width: 116px;
    height: 116px;
    border-radius: 58px;
}

.podium__avatar--me {
    border-color: var(--ink-ivory);
}

.podium__name {
    margin-top: 6px;
    font-size: var(--font-small);
    overflow: hidden;
    max-width: 190px;
}

.podium__rank {
    font-size: 22px;
    color: var(--ink-muted);
}

.results__loser {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.results__title {
    flex-shrink: 1;
    white-space: normal;
}

.results__stamp {
    margin-left: var(--space-2);
    padding: 4px 14px;
    rotate: -6deg;
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--state-thulla);
    border-width: 4px;
    border-color: var(--state-thulla);
    border-radius: 8px;
}

.chip--fair {
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: var(--accent-teal);
    color: var(--accent-teal);
}

.results__again {
    flex-direction: row;
    align-items: center;
}

.results__play {
    flex-grow: 1;
}

.podium__votes {
    flex-direction: row;
    margin-left: var(--space-1);
}

.podium__avatar--vote {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-left: -12px;
}

.podium__avatar--vote .seat__initial {
    font-size: 30px;
}

.results__quiet {
    flex-direction: row;
    justify-content: center;
}

/* The look (design §3, until the art lands): two typefaces, a textured ground, felt and rail,
   gradients and a bottom shadow on controls, shaded avatars, drawn card faces, a rubber stamp. */
:root {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Nunito.ttf");
    /* HarfBuzz shaping and bidi for Urdu, Hindi and Bengali (#132, docs/research/script-shaping.md). */
    -unity-text-generator: advanced;
}

.title, .code, .toast, .results__stamp, .home__title, .seat__initial, .card__rank, .card__court, .nav__glyph, .podium__rank, .turn, .hero, .button--primary, .countdown, .results__title, .coach__text, .daily__text {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
}

.title, .home__title, .code {
    text-shadow: 0 6px 0 rgba(0, 0, 0, 0.55);
}

.home__title {
    font-size: 128px;
    letter-spacing: 6px;
    color: var(--accent-saffron);
}

.screen {
    background-color: var(--surface-ui);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.rail {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: var(--space-1) 0;
    padding: 18px;
    border-radius: 400px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/rail.png");
    background-repeat: repeat;
    background-size: 512px 512px;
}

.felt {
    flex-grow: 1;
    margin: 0;
    border-width: 0;
    border-radius: 380px;
    background-color: var(--felt);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/felt.png");
    -unity-background-scale-mode: scale-and-crop;
}

.button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 6px;
    border-bottom-color: #121316;
    border-radius: 18px;
}

.button--primary {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    border-bottom-color: #8F6200;
    color: #2A1A00;
    font-size: 40px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

.button--secondary {
    background-image: none;
    background-color: rgba(22, 160, 133, 0.08);
    border-bottom-width: 3px;
    border-bottom-color: var(--accent-teal);
}

.button--quiet {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

.button:disabled {
    opacity: 0.45;
}

.chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 4px;
    border-bottom-color: #121316;
}

.chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    border-bottom-color: #8F6200;
    color: #2A1A00;
}

.chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-teal.png");
    border-bottom-color: #0B5A4B;
}

.chip--emote, .chip--fair, .quick-strip__more {
    background-image: none;
}

.panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/panel9.png");
    -unity-slice-left: 52;
    -unity-slice-right: 52;
    -unity-slice-top: 52;
    -unity-slice-bottom: 52;
    -unity-slice-scale: 1px;
    padding: 36px 40px 44px 40px;
    margin: -8px 0 4px 0;
}

.lobby-seat, .settings__row, .leaderboard__row {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.seat__avatar, .home__avatar, .party__avatar, .podium__avatar {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/sphere.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #607D8B;
    border-color: rgba(255, 255, 255, 0.35);
}

.seat__avatar--a { -unity-background-image-tint-color: #9B59B6; background-color: #9B59B6; }
.seat__avatar--b { -unity-background-image-tint-color: #2E86C1; background-color: #2E86C1; }
.seat__avatar--c { -unity-background-image-tint-color: #E67E22; background-color: #E67E22; }
.seat__avatar--d { -unity-background-image-tint-color: #17A589; background-color: #17A589; }
.seat__avatar--e { -unity-background-image-tint-color: #CB4335; background-color: #CB4335; }
.seat__avatar--f { -unity-background-image-tint-color: #7F8C8D; background-color: #7F8C8D; }

.seat--empty .seat__avatar {
    background-image: none;
}

.seat__initial {
    font-size: 60px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

.seat__back {
    width: 24px;
    height: 34px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Presentation/Theme/Art/card-back.png");
    -unity-background-scale-mode: scale-to-fit;
}

.seat__chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-raised.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-color: rgba(255, 255, 255, 0.35);
}

.nav {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/ground.png");
    background-repeat: repeat;
    background-size: 512px 512px;
    border-top-color: rgba(244, 163, 0, 0.35);
}

.nav__tab--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/glow-saffron.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.3);
}

.card {
    border-width: 2px;
    border-bottom-width: 8px;
    border-color: #E6DFD0;
    border-bottom-color: #9C9280;
    border-radius: 16px;
}

.card__field {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 50px;
    bottom: 50px;
}

.card__court {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 88px;
    color: var(--suit-black);
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
}

.card--red .card__court {
    color: var(--suit-red);
}

.deck--four .card--suit-d .card__court {
    color: var(--suit-blue);
}

.deck--four .card--suit-c .card__court {
    color: var(--suit-green);
}

.cards--large .card__field {
    left: 28px;
    right: 28px;
    top: 60px;
    bottom: 60px;
}

.cards--large .card__court {
    font-size: 104px;
}

.card__rank {
    font-size: 46px;
}

.card--legal {
    border-color: var(--accent-saffron);
    border-bottom-color: #B07500;
}

.toast {
    font-size: 124px;
    padding: 18px 54px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/stamp9.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 1px;
    -unity-text-outline-width: 0;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 4px;
}

.results__stamp {
    border-width: 0;
    padding: 10px 28px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/stamp9.png");
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 34;
    -unity-slice-bottom: 34;
    -unity-slice-scale: 0.6px;
    letter-spacing: 2px;
}

.hero {
    min-height: 190px;
    font-size: 48px;
    white-space: normal;
}

.turn {
    font-size: 36px;
    letter-spacing: 1px;
}

.turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/grad-saffron.png");
    -unity-background-scale-mode: stretch-to-fill;
    color: #2A1A00;
}

.code {
    letter-spacing: 16px;
}

.seat--turn .seat__avatar {
    border-color: var(--accent-saffron);
}

.timer-ring {
    opacity: 0.95;
}

.daily {
    padding: var(--space-2);
    border-radius: var(--radius);
    background-color: rgba(244, 163, 0, 0.08);
    border-width: 2px;
    border-color: rgba(244, 163, 0, 0.35);
}

.results__panel {
    max-height: 92%;
}

/* A two-answer question over any screen: the text wraps inside the panel at every text scale. */
.dialog {
    flex-shrink: 1;
    max-height: 92%;
}

.dialog__text {
    font-size: 48px;
    white-space: normal;
    flex-shrink: 1;
    margin-bottom: var(--space-2);
}

.dialog__button {
    margin-top: var(--space-1);
}

.settings__heading {
    color: var(--accent-saffron);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.screen, .table, .nav {
    background-size: 768px 768px;
}

.chip {
    min-width: 150px;
    border-radius: 30px;
    padding: 0 28px;
    -unity-text-align: middle-center;
}

.chip--seat {
    min-width: 132px;
}

.seat__flag {
    top: -44px;
}

.card__court {
    font-size: 72px;
}

.cards--large .card__court {
    font-size: 88px;
}

.card__field {
    top: 54px;
    bottom: 54px;
}

.hand {
    padding-bottom: 52px;
}

/* Avatars (GDD 15.6): a face from the set on the circle, the "You" tag on the player's own seat. */
.seat__avatar--image {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: #FFFFFF;
}

.seat__you {
    position: absolute;
    bottom: -14px;
    align-self: center;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: var(--accent-saffron);
    color: #141518;
}

.seat--empty .seat__you {
    display: none;
}

.table__me {
    flex-shrink: 0;
}

.me-badge {
    width: auto;
    flex-direction: row;
    align-items: center;
    margin: 0 var(--space-2) 0 0;
}

.me-badge .seat__avatar {
    width: 84px;
    height: 84px;
    min-width: 84px;
    flex-shrink: 0;
    border-radius: 42px;
    border-width: 3px;
}

.me-badge .seat__initial {
    font-size: 34px;
}

.me-badge .seat__name {
    margin-top: 0;
    margin-left: 12px;
    max-width: 230px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.me-badge .seat__you {
    bottom: -12px;
    font-size: 16px;
    padding: 0 8px;
}

.seat--me .seat__name {
    margin-top: 20px;
}

.seat--turn.me-badge .seat__avatar {
    border-width: 4px;
    scale: 1 1;
}

.me-badge .seat__crown {
    top: -30px;
    font-size: 26px;
}

.share-card__avatar {
    justify-content: center;
    align-items: center;
}

/* Table, final pass (design 7.1): a top bar of small pills, the felt filling the middle with the
   opponents on its rail and the player's badge docked on the near edge, quick chat as small pills in
   one row with chat, then the hand. */
.table {
    padding: 0;
}

.table__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 112px;
    flex-shrink: 0;
    padding: 0 var(--space-2);
    background-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.table__pill {
    min-height: 72px;
    min-width: 72px;
    margin: 0 4px;
    padding: 0 22px;
    border-radius: 36px;
    font-size: var(--font-small);
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--ink-ivory);
}

.table__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 var(--space-1);
    -unity-text-align: middle-center;
    font-size: var(--font-small);
    letter-spacing: 2px;
    color: var(--ink-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.table__top-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.table__zone {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.table__zone > .rail {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 9%;
    bottom: 10%;
    margin: 0;
    padding: 20px;
    border-radius: 300px;
}

.table__zone > .rail > .felt {
    border-radius: 280px;
}

.opponents {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    height: auto;
    min-height: 0;
}

.seat {
    width: 220px;
    margin: 0;
}

.seat__name {
    margin-top: 10px;
    padding: 2px 16px;
    border-radius: 999px;
    background-color: rgba(10, 12, 14, 0.72);
    font-size: 26px;
}

.seat--turn .seat__name {
    background-color: var(--gold);
    color: #141518;
}

.seat__flag {
    top: -40px;
    left: 30px;
    right: 30px;
    font-size: 22px;
    letter-spacing: 2px;
}

.table__me {
    position: absolute;
    left: 50%;
    bottom: 10%;
    translate: -50% 50%;
}

.me-badge {
    margin: 0;
    padding: 10px 34px 10px 14px;
    border-radius: 999px;
    background-color: rgba(10, 12, 14, 0.82);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
}

.seat--turn.me-badge {
    border-color: var(--gold);
}

.me-badge .seat__name {
    margin-left: 20px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 34px;
    -unity-font-style: bold;
}

.seat--turn.me-badge .seat__name {
    background-color: rgba(0, 0, 0, 0);
    color: var(--gold);
}

.table__notes {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 17%;
    align-items: center;
}

.pile__owner {
    margin-top: 10px;
    font-size: 20px;
}

.table__bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    flex-shrink: 0;
    padding: 0 var(--space-2);
}

.quick-strip {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow: hidden;
    margin: 0;
}

.quick-strip__chip, .quick-strip__more {
    min-height: 72px;
    min-width: 0;
    margin: 0 10px 0 0;
    padding: 0 24px;
    border-radius: 36px;
    border-bottom-width: 0;
    background-image: none;
    background-color: rgba(255, 255, 255, 0.1);
    font-size: 26px;
    -unity-font-style: bold;
    white-space: nowrap;
    flex-shrink: 1;
}

.quick-strip__more {
    min-width: 72px;
    flex-shrink: 0;
}

.table__bar-actions {
    flex-shrink: 0;
    align-items: center;
}

.table__bar-actions > .button {
    min-height: 72px;
    padding: 0 26px;
    border-radius: 36px;
    font-size: 28px;
}

.table__chat {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.1);
    border-bottom-width: 0;
    color: var(--ink-ivory);
}

.hand {
    padding: 36px 0 44px 0;
}

.hand--left .table__bar {
    flex-direction: row-reverse;
}

/* The phone number screen (GDD 10.2). */
.phone__text {
    white-space: normal;
    margin-top: var(--space-1);
    margin-bottom: var(--space-2);
}

.games {
    flex-shrink: 0;
    margin: 20px 0 8px 0;
}

.game__back {
    width: 130px;
    height: 182px;
    margin: 0 -22px;
    border-radius: 12px;
    background-color: #2C3E6B;
    -unity-background-scale-mode: stretch-to-fill;
}

.nav__icon {
    width: 60px;
    height: 60px;
    align-self: center;
}

/* An icon in place of a word (the gear for settings); the tooltip and the label carry the name. */
.button--icon {
    width: 88px;
    min-width: 88px;
    height: 88px;
    padding: 0;
}

.line-icon {
    width: 52px;
    height: 52px;
    align-self: center;
}

/*
 * Home after the concept art (docs/design/rooftop-redesign.md): a name sign hanging from the top with
 * the level badge under it and the coin pouch beside it, the game card with its title, a fan of cards,
 * seat medallions and Casual or Ranked, Play now on a plaque over the card's foot, two boards and the
 * reward chest. These rules draw it plainly in any theme; a theme with painted pieces (Skins.uss) puts
 * its art on the same elements.
 */
.home {
    padding: 0 var(--space-2);
}

.home__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-bottom: var(--space-3);
}

.home__header {
    height: 244px;
    margin-top: 80px;
    align-items: center;
    flex-shrink: 0;
}

.home__rope {
    position: absolute;
    display: none;
}

.home__sign {
    width: 620px;
    height: 150px;
    justify-content: center;
    align-items: center;
    padding: 0 110px 14px 110px;
    border-radius: 28px;
    background-color: var(--surface-panel);
}

.home__name {
    font-size: 58px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
}

.home__shield {
    position: absolute;
    top: 118px;
    left: 50%;
    translate: -66px 0;
    width: 132px;
    height: 132px;
    margin: 0;
    padding: 0 0 12px 0;
    border-width: 0;
    border-radius: 66px;
    background-color: var(--surface-raised);
    color: var(--accent-saffron);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.home__pouch {
    position: absolute;
    top: -6px;
    right: 36px;
    width: 170px;
    height: 170px;
    justify-content: flex-end;
    align-items: center;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Props/potli_currency_bag.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home__coins {
    margin: 0;
    padding: 2px 16px;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0.6);
    color: var(--accent-mustard);
    font-size: 30px;
    -unity-font-style: bold;
}

.home__progress {
    display: none;
}

.games {
    flex-shrink: 0;
    align-items: center;
    margin: 10px 0 0 0;
}

.game {
    width: 740px;
    padding: 70px 70px 120px 70px;
    align-items: stretch;
    border-radius: 40px;
    background-color: var(--surface-panel);
}

.game__name {
    font-size: 132px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    color: var(--accent-saffron);
    white-space: normal;
}

.game__line {
    margin-top: -14px;
    font-size: 42px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    color: var(--ink-ivory);
    white-space: normal;
}

.game__art {
    height: 210px;
    margin-top: 6px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.game__card {
    margin: 0 -42px;
    scale: 0.74 0.74;
    transform-origin: 50% 0;
}

.game__seats-label {
    display: none;
}

.game__seats {
    justify-content: center;
    margin: -60px 0 0 0;
}

/* A medallion draws at 100px but takes a full touch target (132px, 48 dp). */
.home .medal {
    width: 132px;
    min-width: 132px;
    max-width: 132px;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    margin: 0 -8px;
    padding: 0 0 4px 0;
    border-radius: 66px;
    font-size: 54px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-text-align: middle-center;
}

.home .medal.chip--on {
    scale: 1.14 1.14;
}

.game__seats:disabled {
    opacity: 0.45;
}

.game__mode {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 22px;
}

.game__mode-label {
    font-size: 46px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    color: var(--ink-muted);
    padding: 0 20px;
}

.game__mode-label--on {
    color: var(--ink-ivory);
}

.switch {
    width: 140px;
    height: 68px;
    border-radius: 34px;
    background-color: var(--surface-raised);
    justify-content: center;
}

.switch__knob {
    width: 54px;
    height: 54px;
    margin-left: 8px;
    border-radius: 27px;
    background-color: var(--ink-ivory);
    transition-property: translate;
    transition-duration: 160ms;
    transition-timing-function: ease-out-cubic;
}

.switch--on {
    background-color: var(--state-thulla);
}

.switch--on > .switch__knob {
    translate: 70px 0;
}

.game__help {
    position: absolute;
    top: 24px;
    right: 24px;
}

.game__play {
    width: 520px;
    height: 150px;
    margin-top: -90px;
    font-size: 84px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
}

.home__lower {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-top: 8px;
}

.home .hero {
    align-self: center;
    width: 720px;
    margin: 0 0 8px 0;
    white-space: normal;
}

.home .party {
    margin-top: var(--space-2);
}

.home__boards {
    width: 420px;
    margin-right: 24px;
}

.plank {
    height: 112px;
    margin: 8px 0;
    font-size: 54px;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    white-space: nowrap;
}

/* The chest stands in front of its board, overlapping its top edge. */
.daily {
    width: 360px;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 200px 0 0 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.daily__chest {
    position: absolute;
    top: 0;
    left: 30px;
    width: 300px;
    height: 245px;
    transition-property: scale;
    transition-duration: 180ms;
    transition-timing-function: ease-out-back;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Props/chest_daily_reward_closed.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(190, 175, 170);
}

.daily--ready .daily__chest {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.daily__chest--pop {
    scale: 1.15 1.15;
}

.daily__board {
    width: 100%;
    margin: 0 0 12px 0;
    font-size: 48px;
}

/* A coin from the opened chest on its way to the potli (DailyRewardCard). */
.coin-fly {
    position: absolute;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/Rooftop/Props/coin_gold.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home__pouch {
    transition-property: scale;
    transition-duration: 90ms;
}

.home__pouch--bump {
    scale: 1.1 1.1;
}

.daily__text {
    margin: 0;
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.inventory {
    align-items: center;
    padding-top: var(--space-2);
}

.inventory__entry {
    align-self: center;
    width: 640px;
    margin: 14px 0;
}

.inventory .inventory__badge {
    top: -10px;
    right: -10px;
    background-color: #C62828;
    color: #FFFFFF;
}

.nav__art {
    display: none;
}

/* The shop as a bazaar (docs/design/rooftop-redesign.md): a spotlight card, then tiles two to a row. */
.shop__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.shop__tile {
    width: 48.5%;
    flex-direction: column;
    align-items: center;
    padding: var(--space-2);
}

.shop__tile-name {
    margin: var(--space-1) 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop__preview {
    margin: 0;
}

.shop__preview--small {
    width: 120px;
    height: 160px;
    margin-top: var(--space-1);
}

.shop__preview--large {
    width: 200px;
    height: 270px;
}

.shop__swatch--table.shop__preview--small {
    width: 200px;
    height: 120px;
    border-radius: 60px;
}

.shop__swatch--table.shop__preview--large {
    width: 260px;
    height: 160px;
    border-radius: 80px;
}

.shop__action, .shop__equipped {
    align-self: stretch;
    -unity-text-align: middle-center;
}

.shop__spotlight {
    padding: var(--space-3);
    margin-bottom: var(--space-2);
    border-radius: var(--radius);
    background-color: var(--surface-panel);
}

.shop__spotlight-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.shop__spotlight-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--space-3);
}

.shop__spotlight-name {
    font-size: 52px;
    -unity-font-style: bold;
    white-space: normal;
}

.shop__price {
    margin-top: var(--space-1);
    color: var(--accent-mustard);
    -unity-font-style: bold;
}

/* The season pass as a road: tiers run sideways, the free reward over the tier bar and the premium under it. */
.pass__lanes {
    flex-direction: row;
    align-items: flex-start;
}

.pass__lane-labels {
    width: 190px;
    height: 520px;
    flex-shrink: 0;
    justify-content: space-between;
    padding: 70px 0;
}

.pass__lane {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--ink-ivory);
    padding: 8px 0;
    border-radius: var(--radius);
    background-color: var(--surface-raised);
}

.pass__track {
    flex-grow: 1;
    flex-shrink: 1;
}

.pass__track .unity-scroll-view__content-container {
    flex-direction: row;
}

.pass__lanes .pass__track .pass__row {
    flex-direction: column;
    align-items: stretch;
    width: 250px;
    min-height: 0;
    border-bottom-width: 0;
}

.pass__lanes .pass__track .pass__side {
    flex-grow: 0;
    flex-basis: auto;
    height: 220px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 0 6px;
    padding: var(--space-1);
    border-left-width: 0;
    border-radius: var(--radius);
}

.pass__track .pass__reward {
    -unity-text-align: middle-center;
    margin-bottom: var(--space-1);
}

.pass__track .pass__tier {
    width: auto;
    height: 72px;
    margin: 4px 0;
    font-size: 34px;
    background-color: var(--surface-raised);
    color: var(--ink-muted);
}

.pass__track .pass__tier--reached {
    background-color: var(--accent-saffron);
    color: #1F0E05;
}

/* Profile as a dossier: the face, name and handle, the friend code, four stats, the bio. */
.profile__dossier {
    align-items: center;
    margin: var(--space-2) 0;
}

.profile__avatar {
    width: 220px;
    height: 220px;
    border-radius: 110px;
}

.profile__avatar .seat__initial {
    font-size: 110px;
}

.seat__frame {
    display: none;
}

.skinned .seat__frame {
    display: flex;
}

.profile__name {
    margin-top: var(--space-2);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.profile__handle {
    -unity-text-align: middle-center;
}

.profile__stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: var(--space-2) 0;
}

.profile__stat {
    width: 48.5%;
    align-items: center;
    padding: var(--space-2);
    margin-bottom: var(--space-1);
    border-radius: var(--radius);
    background-color: var(--surface-panel);
}

.profile__stat-value {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--accent-mustard);
}

.profile__stat--loss .profile__stat-value {
    color: var(--state-thulla);
}

.profile__stat-label {
    font-size: var(--font-small);
    -unity-text-align: middle-center;
}

.profile__stats-line {
    display: none;
}

.profile__bio {
    margin: var(--space-1) 0 var(--space-2) 0;
    padding: var(--space-2) var(--space-3);
    white-space: normal;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.friend-row__avatar {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin-right: var(--space-2);
    flex-shrink: 0;
}

.friend-row__avatar .seat__initial {
    font-size: 44px;
}

/* Tablet landscape (art pack, responsive guide): the tabs become a rail down the left edge. */
.size--expanded > .nav {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 220px;
    height: auto;
    flex-direction: column;
    justify-content: center;
    padding: 40px 0;
    border-top-width: 0;
    border-right-width: 2px;
    border-right-color: var(--surface-raised);
}

.size--expanded > .nav > .nav__tab {
    flex-grow: 0;
    height: 210px;
    margin: 8px 0;
}

.size--expanded.shell--with-nav > TemplateContainer {
    margin-left: 220px;
}

/* Voice (GDD 11.4): the mic beside chat, hold-to-talk on push-to-talk tables, a pill for the voice
   state at the top of the felt, and a teal ring on whoever is heard. */
.table__mic,
.table__talk {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.1);
    border-bottom-width: 0;
    color: var(--ink-ivory);
    margin-right: 12px;
}

.table__mic--on {
    background-color: var(--accent-teal);
}

.table__mic--retry {
    background-color: rgba(229, 57, 53, 0.35);
}

.table__talk--held {
    background-color: var(--accent-teal);
    scale: 1.06 1.06;
}

.voice-pill__row {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
}

.voice-pill {
    max-width: 90%;
    padding: 8px 22px;
    border-radius: 30px;
    background-color: rgba(0, 0, 0, 0.55);
    color: var(--ink-ivory);
    font-size: var(--font-small);
    white-space: normal;
    -unity-text-align: middle-center;
    display: none;
}

/* Hear the table or not (GDD 11.4); under the pill so it never covers the felt. */
.voice-speaker {
    display: none;
    margin-top: 6px;
    min-height: 48px;
    font-size: var(--font-small);
}

.voice-speaker--off {
    opacity: 0.75;
}

/* A player's voice level in the player sheet. */
.sheet__level {
    width: 100%;
    margin-bottom: 8px;
}

.seat--speaking .seat__avatar {
    border-color: var(--accent-teal);
    border-width: 5px;
}
