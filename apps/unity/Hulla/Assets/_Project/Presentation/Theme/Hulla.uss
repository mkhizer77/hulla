/* Tokens from the GDD palette (15.2). The design system pass (#23) replaces this file with generated tokens. */
:root {
    --surface-table: #1F2A2E;
    --surface-ui: #141518;
    --accent-saffron: #F4A300;
    --accent-teal: #16A085;
    --ink-ivory: #F6F1E7;
    --ink-muted: #9AA0A6;
    --state-thulla: #E53935;
    --state-escape: #43A047;
    --suit-red: #D32F2F;
    --suit-black: #1B1B1F;
    --card-face: #FBF8F2;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --radius: 14px;
    /* 48 dp at the 1080 px reference width (GDD 27). */
    --tap: 132px;
    --font-body: 34px;
    --font-small: 26px;
    --font-title: 96px;
    -unity-font-style: normal;
    color: var(--ink-ivory);
    font-size: var(--font-body);
}

.screen {
    flex-grow: 1;
    background-color: var(--surface-ui);
    padding: var(--space-3);
}

.screen--center {
    justify-content: center;
    align-items: stretch;
}

.title {
    font-size: var(--font-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.title--small {
    font-size: 56px;
}

.subtitle {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
}

.caption {
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.panel {
    background-color: #1C1E22;
    border-radius: var(--radius);
    padding: var(--space-3);
}

.divider {
    height: 2px;
    background-color: #2A2D33;
    margin: var(--space-2) 0;
}

.field {
    flex-direction: column;
    margin-bottom: var(--space-2);
}

.field > Label {
    color: var(--ink-muted);
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.field TextInput, .field .unity-base-text-field__input {
    min-height: var(--tap);
    font-size: var(--font-body);
    background-color: #0E0F11;
    color: var(--ink-ivory);
    border-radius: 10px;
    border-width: 2px;
    border-color: #2A2D33;
    padding: 0 var(--space-2);
}

.button {
    min-height: var(--tap);
    margin: var(--space-1) 0;
    border-radius: var(--radius);
    border-width: 0;
    background-color: #2A2D33;
    color: var(--ink-ivory);
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.button:hover {
    background-color: #33373E;
}

.button:disabled {
    opacity: 0.4;
}

.button--primary {
    background-color: var(--accent-saffron);
    color: #141518;
}

.button--primary:hover {
    background-color: #FFB520;
}

.button--quiet {
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-muted);
}

.button--small {
    min-height: var(--tap);
    padding: 0 var(--space-2);
}

.status {
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-top: var(--space-2);
    white-space: normal;
}

.code-box {
    align-items: center;
    padding: var(--space-3);
}

.code {
    font-size: 120px;
    -unity-font-style: bold;
    letter-spacing: 12px;
    color: var(--accent-saffron);
}

.seats {
    flex-grow: 1;
}

.lobby-seat {
    flex-direction: row;
    align-items: center;
    padding: var(--space-2);
    margin-bottom: var(--space-1);
    background-color: #1C1E22;
    border-radius: var(--radius);
}

.lobby-seat__name {
    flex-grow: 1;
}

.tag, .tag--ok, .tag--muted {
    font-size: var(--font-small);
    margin-left: var(--space-1);
    padding: 4px 12px;
    border-radius: 8px;
}

.tag {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.tag--ok {
    background-color: #123A2B;
    color: var(--state-escape);
}

.tag--muted {
    color: var(--ink-muted);
}

.actions {
    padding-top: var(--space-2);
}

/* Table */
.table {
    background-color: var(--surface-table);
    padding: var(--space-2);
}

.table__top {
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
}

.table__info {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.opponents {
    flex-shrink: 0;
    height: 24%;
    min-height: 280px;
}

.seat--placed {
    position: absolute;
    translate: -50% -50%;
}

.seat {
    width: 180px;
    margin: var(--space-1);
    padding: var(--space-1);
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: var(--radius);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.seat--turn {
    border-color: var(--accent-saffron);
}

.seat__name {
    font-size: var(--font-small);
    overflow: hidden;
    max-width: 160px;
}

.seat__count {
    font-size: 48px;
    -unity-font-style: bold;
}

.seat__state {
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.felt {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.pile {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.pile__slot {
    align-items: center;
    margin: 6px;
}

.pile__owner {
    font-size: var(--font-small);
    color: var(--ink-muted);
}

.pile__note {
    margin-top: var(--space-2);
    color: var(--ink-muted);
}

.toast {
    display: none;
    position: absolute;
    font-size: 110px;
    -unity-font-style: bold;
    color: var(--state-thulla);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #141518;
}

.table__bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 80px;
}

.turn {
    -unity-font-style: bold;
    color: var(--accent-saffron);
}

.hand {
    flex-shrink: 0;
    padding: 30px 0 var(--space-3) 0;
}

.hand__row {
    flex-direction: row;
    justify-content: center;
}

.hand__row--stacked {
    margin-bottom: -60px;
}

.hand .card {
    transition-property: translate, scale;
    transition-duration: 120ms;
}

.card {
    width: 120px;
    height: 168px;
    background-color: var(--card-face);
    border-radius: 10px;
    border-width: 2px;
    border-color: #C9C2B4;
    padding: 6px 8px;
}

.card__rank, .card__suit {
    color: var(--suit-black);
}

.card--red .card__rank, .card--red .card__suit {
    color: var(--suit-red);
}

.card__rank {
    font-size: 40px;
    -unity-font-style: bold;
}

.card__suit {
    font-size: 44px;
}

.card--legal {
    border-color: var(--accent-saffron);
    border-width: 4px;
}

.card--raised {
    translate: 0 -34px;
}

.card--hover {
    scale: 1.15 1.15;
    translate: 0 -24px;
}

.card--dim {
    opacity: 0.45;
}

.card--faded {
    opacity: 0.6;
}

.results {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    padding: var(--space-3);
}

.results__order {
    margin: var(--space-2) 0;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: var(--space-1);
    background-color: var(--state-thulla);
    color: var(--ink-ivory);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.table__bar-actions {
    flex-direction: row;
}

.table__bar-actions > .button {
    margin-left: var(--space-1);
}

.bubble {
    margin-top: 6px;
    padding: 6px 12px;
    border-radius: 12px;
    background-color: var(--ink-ivory);
    color: #141518;
    font-size: var(--font-small);
    white-space: normal;
    max-width: 200px;
    -unity-text-align: middle-center;
}

.bubble--mine {
    display: none;
    align-self: center;
    max-width: 600px;
    font-size: var(--font-body);
}

.chat-panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background-color: #1C1E22;
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    padding: var(--space-2);
}

.chat-panel__scroll {
    flex-grow: 1;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
}

.chip {
    min-height: var(--tap);
    margin: 6px;
    padding: 10px 18px;
    border-radius: 999px;
    border-width: 0;
    background-color: #2A2D33;
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

.chip--emote {
    background-color: #3A2F12;
    color: var(--accent-saffron);
}

.chips--seats {
    margin-bottom: var(--space-1);
}

.chip--seat {
    min-width: 96px;
    -unity-text-align: middle-center;
}

.chip--on {
    background-color: var(--accent-saffron);
    color: #141518;
}

.countdown {
    -unity-text-align: middle-center;
    font-size: 48px;
}

.recap {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 30%;
}

.recap__text {
    white-space: normal;
    margin: var(--space-1) 0;
}

.elapsed {
    -unity-text-align: middle-center;
}

.table__turn {
    flex-direction: row;
    align-items: center;
}

.timer {
    width: 56px;
    height: 56px;
    margin-right: var(--space-1);
}

.timer-ring {
    flex-grow: 1;
}

.hint {
    display: none;
    align-self: center;
    padding: 8px 18px;
    border-radius: 999px;
    background-color: #3A1F1F;
    color: var(--ink-ivory);
    font-size: var(--font-small);
}

.pile__slot--fly {
    transition-property: translate;
    transition-duration: 220ms;
    transition-timing-function: ease-out-cubic;
}

.pile__slot--fade-start {
    opacity: 0;
}

.pile__slot--fade {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 200ms;
}

/* Settings (GDD 14.12, 27): classes on the shell root, applied live. */
.theme--contrast {
    --surface-ui: #000000;
    --surface-table: #000000;
    --ink-muted: #E8E8E8;
    --card-face: #FFFFFF;
}

.theme--contrast .card {
    border-color: #FFFFFF;
    border-width: 3px;
}

.theme--contrast .seat, .theme--contrast .panel, .theme--contrast .lobby-seat {
    border-width: 2px;
    border-color: #FFFFFF;
}

/* The root font size is resolved once at :root, so the scaled element sets it again for its subtree. */
.text--125, .text--150, .text--200 {
    font-size: var(--font-body);
}

.text--125 {
    --font-body: 42px;
    --font-small: 32px;
    --font-title: 110px;
}

.text--150 {
    --font-body: 51px;
    --font-small: 39px;
    --font-title: 120px;
}

.text--200 {
    --font-body: 68px;
    --font-small: 52px;
    --font-title: 128px;
}

.deck--four .card--suit-d .card__rank, .deck--four .card--suit-d .card__suit {
    color: #1E6FD9;
}

.deck--four .card--suit-c .card__rank, .deck--four .card--suit-c .card__suit {
    color: #2E7D32;
}

.cards--large .card {
    width: 150px;
    height: 210px;
}

.cards--large .card__rank {
    font-size: 52px;
}

.cards--large .card__suit {
    font-size: 56px;
}

.hand--left .table__bar {
    flex-direction: row-reverse;
}

.hand--left .table__turn {
    flex-direction: row-reverse;
}

.table__top-actions {
    flex-direction: row;
    flex-shrink: 0;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.settings__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.settings__scroll {
    flex-grow: 1;
}

.settings__heading {
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
}

.settings__row {
    min-height: var(--tap);
    padding: 0 var(--space-2);
    margin-bottom: var(--space-1);
    background-color: #1C1E22;
    border-radius: var(--radius);
    justify-content: center;
}

.settings__row.unity-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.settings__row.unity-toggle > .unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.settings__row > Label, .settings__row Label {
    font-size: var(--font-body);
    color: var(--ink-ivory);
    white-space: normal;
}

.settings__choice {
    padding: var(--space-1) var(--space-2);
}

.settings__row .unity-toggle__checkmark {
    width: 48px;
    height: 48px;
}

.rulebook__section {
    margin-bottom: var(--space-3);
}

.rulebook__line {
    white-space: normal;
    margin-top: var(--space-1);
}

.hint {
    cursor: link;
}

.chat-panel__compose {
    flex-direction: row;
    align-items: center;
}

.chat-panel__input {
    flex-grow: 1;
    margin-bottom: 0;
    margin-right: var(--space-1);
}

.chat-log {
    margin-bottom: var(--space-2);
}

.chat-log__line {
    white-space: normal;
    font-size: var(--font-small);
    margin-bottom: 4px;
}

.friend-row {
    flex-wrap: wrap;
}

.friend-row > .chip {
    margin: 4px;
}

.home__links {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.home__links > .button {
    margin: 0 var(--space-1);
}

.lobby-chat {
    margin-top: var(--space-1);
}

.hero {
    display: none;
    margin-bottom: var(--space-1);
}

.lobby-rules {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.lobby-rules__text {
    flex-shrink: 1;
    white-space: normal;
    color: var(--ink-muted);
}

.coach {
    display: none;
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    top: 32%;
    padding: var(--space-2);
    border-radius: var(--radius);
    background-color: #2B2412;
    border-width: 3px;
    border-color: var(--accent-saffron);
}

.coach__text {
    white-space: normal;
    color: var(--ink-ivory);
    margin-bottom: var(--space-1);
}

.settings__action {
    margin-bottom: var(--space-1);
}

.player-sheet {
    top: 30%;
}

.progress-line {
    margin-top: 0;
    margin-bottom: var(--space-1);
}

.result-reward {
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Share card (GDD 10.9), drawn off screen at 1080 px wide. */
.share-card {
    flex-grow: 1;
    background-color: var(--surface-table);
    padding: 96px 80px 72px 80px;
    align-items: stretch;
}

.share-card--story {
    padding-top: 240px;
    padding-bottom: 160px;
}

.share-card__brand {
    font-size: 120px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__game {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--ink-muted);
    margin-bottom: 48px;
}

.share-card__stamp {
    align-self: center;
    border-width: 10px;
    border-color: var(--state-thulla);
    border-radius: 24px;
    padding: 24px 56px;
    rotate: -6deg;
    margin-bottom: 56px;
}

.share-card__stamp-title {
    font-size: 104px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--state-thulla);
}

.share-card__stamp-name {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__order {
    background-color: #182226;
    border-radius: 32px;
    padding: 24px 40px;
}

.share-card__row {
    flex-direction: row;
    align-items: center;
    height: 112px;
}

.share-card__row--me .share-card__name {
    color: var(--accent-saffron);
    -unity-font-style: bold;
}

.share-card__place {
    width: 64px;
    font-size: 48px;
    color: var(--ink-muted);
}

.share-card__avatar {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin-right: 32px;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
    background-color: var(--accent-teal);
}

.share-card__avatar--1 { background-color: #8E44AD; }
.share-card__avatar--2 { background-color: #C0392B; }
.share-card__avatar--3 { background-color: #2E86C1; }
.share-card__avatar--4 { background-color: #D68910; }
.share-card__avatar--5 { background-color: #27AE60; }

.share-card__name {
    font-size: 52px;
    color: var(--ink-ivory);
}

.share-card__highlight {
    margin-top: 48px;
    font-size: 44px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-ivory);
}

.share-card__footer {
    font-size: 44px;
    -unity-text-align: middle-center;
    color: var(--accent-saffron);
}

.share-card__row--loser .share-card__name {
    color: var(--state-thulla);
}

.share-card--story .share-card__brand {
    font-size: 150px;
}

.share-card--story .share-card__stamp {
    margin-top: 40px;
    margin-bottom: 96px;
}

.share-card--story .share-card__row {
    height: 140px;
}

.share-card--story .share-card__name {
    font-size: 60px;
}

.share-card--story .share-card__footer {
    font-size: 52px;
}

.daily {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}

.daily__text {
    flex-shrink: 1;
    white-space: normal;
    margin-right: var(--space-2);
    color: var(--accent-saffron);
}

.leaderboard__row {
    flex-direction: row;
    align-items: center;
    min-height: 96px;
    padding: 0 var(--space-2);
    border-bottom-width: 1px;
    border-color: #2A2D33;
}

.leaderboard__row--me {
    background-color: #2B2412;
    border-radius: var(--radius);
}

.leaderboard__rank {
    width: 96px;
    color: var(--ink-muted);
}

.leaderboard__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard__points {
    color: var(--accent-saffron);
}

.leaderboard__me {
    margin-top: var(--space-1);
}
