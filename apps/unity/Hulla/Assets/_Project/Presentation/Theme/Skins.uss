.skin--haveli .table__pill, .skin--haveli .quick-strip__chip, .skin--haveli .quick-strip__more, .skin--haveli .table__chat {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/pill.png");
}

.skin--haveli .unity-toggle__checkmark {
    border-color: #C9973F;
}

.skin--haveli .unity-base-slider__dragger {
    background-color: #C9973F;
}

.skin--haveli .field .unity-base-text-field__input {
    border-color: #C9973F;
}

.skin--mehndi .button, .skin--mehndi .button--secondary, .skin--mehndi .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/btn-ghost.png");
    color: #FFF3E0;
}

.skin--mehndi .chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/btn-ghost.png");
}

.skin--mehndi .button--primary, .skin--mehndi .chip--on, .skin--mehndi .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/btn-primary.png");
}

.skin--mehndi .chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/chip-on.png");
    color: #300520;
}

.skin--mehndi .button--quiet {
    background-image: none;
}

.skin--mehndi .table__pill, .skin--mehndi .quick-strip__chip, .skin--mehndi .quick-strip__more, .skin--mehndi .table__chat {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/pill.png");
}

.skin--mehndi .unity-toggle__checkmark {
    border-color: #FFC233;
}

.skin--mehndi .unity-base-slider__dragger {
    background-color: #FFC233;
}

.skin--mehndi .field .unity-base-text-field__input {
    border-color: #FFC233;
}

.skin--adda .button, .skin--adda .button--secondary, .skin--adda .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-ghost.png");
    color: #FFF4E2;
}

.skin--adda .chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-ghost.png");
}

.skin--adda .button--primary, .skin--adda .chip--on, .skin--adda .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-primary.png");
}

.skin--adda .chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/chip-on.png");
    color: #1E0E04;
}

.skin--adda .button--quiet {
    background-image: none;
}

.skin--adda .table__pill, .skin--adda .quick-strip__chip, .skin--adda .quick-strip__more, .skin--adda .table__chat {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/pill.png");
}

.skin--adda .unity-toggle__checkmark {
    border-color: #E8B25A;
}

.skin--adda .unity-base-slider__dragger {
    background-color: #E8B25A;
}

.skin--adda .field .unity-base-text-field__input {
    border-color: #E8B25A;
}

/* The dark text slabs on Profile and Friends become themed fields. */
.skinned .field .unity-base-text-field__input, .skinned .field TextInput {
    background-color: rgba(0, 0, 0, 0.32);
    border-width: 2px;
    border-radius: 20px;
    padding: 0 24px;
    color: #FFFFFF;
}

.skinned .field > Label {
    color: rgba(255, 255, 255, 0.72);
}

/* Checkboxes: a rounded box in the accent, filled when on. */
.skinned .unity-toggle__checkmark {
    width: 64px;
    height: 64px;
    border-width: 3px;
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0.3);
    -unity-background-image-tint-color: #141518;
}

.skinned .unity-toggle:checked .unity-toggle__checkmark {
    background-color: #FFE79A;
}

.skinned .unity-toggle > .unity-label, .skinned .unity-base-slider > .unity-label {
    color: #FFFFFF;
    font-size: var(--font-body);
}

/* Sliders: a soft track and a round handle in the accent. */
.skinned .unity-base-slider__tracker {
    height: 14px;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.18);
}

.skinned .unity-base-slider__dragger {
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: 26px;
    border-width: 0;
}

.skinned .unity-base-slider__dragger-border {
    display: none;
}

/* Lists scroll by touch; the desktop scroll bar looked like a stray white rail. */
.skinned .unity-scroller--vertical, .skinned .unity-scroller--horizontal {
    display: none;
}

/* Themes without painted card pieces: the plain felt, round medallions and a big Play now. */
.skinned .home .game__art {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.skinned .home .medal {
    background-image: none;
    background-color: var(--surface-raised);
    border-width: 3px;
    border-color: var(--accent-saffron);
    color: var(--ink-ivory);
    font-size: 50px;
}

.skinned .home .medal.chip--on {
    background-color: var(--accent-saffron);
    color: #141518;
}

.skinned .home .game__play {
    width: 620px;
    font-size: 60px;
}
