/*
 * The scene's shared rules (docs/design/rooftop-redesign.md): they hang off the always-on skinned class
 * on the shell root and set the stage the rooftop look (Rooftop.uss, loaded after this) builds on.
 * The ambient motion comes from AmbientLayer.
 */

.skinned .ambient__glow { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/glow.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__steam { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/steam.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__glass { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/glass.png"); -unity-background-scale-mode: stretch-to-fill; }

/* The scene fills the screen; the old lattice ground steps aside. */
.skinned .screen, .skinned .table {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-and-crop;
}

/* The table is one picture: rail, felt and watermark; the felt element is the play area inside it. */
.skinned .table__zone > .rail {
    padding: 9% 9% 12% 9%;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .table__zone > .rail > .felt {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

/* Seats: the brass frame over the face, a fan of card backs with the count beside it. */
.skinned .seat__avatar {
    border-width: 0;
    overflow: visible;
}

.skinned .seat__frame {
    position: absolute;
    left: -17px;
    top: -17px;
    width: 150px;
    height: 150px;
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .me-badge .seat__frame {
    left: -14px;
    top: -14px;
    width: 112px;
    height: 112px;
}

.skinned .seat__chip {
    right: -74px;
    bottom: 6px;
    width: 70px;
    height: 64px;
    padding: 0;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.skinned .seat--east .seat__chip {
    right: auto;
    left: -74px;
}

.skinned .seat__back {
    position: absolute;
    bottom: 8px;
    width: 34px;
    height: 48px;
    margin: 0;
    border-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: 50% 100%;
}

.skinned .seat__back--1 { left: 2px; rotate: -18deg; }
.skinned .seat__back--2 { left: 14px; rotate: -2deg; }
.skinned .seat__back--3 { left: 26px; rotate: 14deg; }

.skinned .seat__count {
    position: absolute;
    right: -6px;
    bottom: -4px;
    min-width: 34px;
    height: 34px;
    border-radius: 17px;
    font-size: 22px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: var(--gold);
    color: #141518;
}

.skinned .seat__name {
    margin-top: 12px;
    padding: 4px 22px 8px 22px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 26;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 1px;
}

.skinned .table__info, .skinned .table__pill {
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 1px;
}

.skinned .table__info {
    flex-grow: 0;
    align-self: center;
    padding: 10px 28px;
}

.skinned .button, .skinned .chip {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
    padding-bottom: 8px;
}

.skinned .button--quiet {
    background-image: none;
}

.skinned .turn--mine {
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .panel {
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 1px;
}

.skinned .nav {
    background-image: none;
}

/* The top bar floats over the scene. */
.skinned .table__top {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

/* Small controls take the pill art; the button art's corners are too big for them. */
.skinned .quick-strip__chip, .skinned .quick-strip__more, .skinned .table__chat, .skinned .table__pill, .skinned .me-badge {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 1px;
    -unity-background-scale-mode: stretch-to-fill;
    padding-bottom: 0;
}

.skinned .chip {
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 36;
    -unity-slice-bottom: 46;
}

.skinned .me-badge .seat__name {
    background-image: none;
    color: var(--ink-ivory);
}

.skinned .seat--turn.me-badge .seat__name {
    color: var(--gold);
}

.skinned .game {
    border-radius: 0;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 1px;
}

.skinned .home__title, .skinned #tagline {
    display: none;
}

/* Quiet text sits on busy scenes; a soft shadow keeps it readable. */
.skinned .caption, .skinned .subtitle, .skinned .lobby-rules__text, .skinned .button--quiet, .skinned .home__links > .button, .skinned .status, .skinned .podium__name, .skinned .podium__rank {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

/* The results panel fits what it holds instead of filling the screen. */
.skinned .results__panel {
    flex-grow: 0;
}

.skinned .results__scroll {
    flex-grow: 0;
    flex-shrink: 1;
    max-height: 1180px;
}

.skinned .results .chips > .chip {
    min-height: 104px;
    font-size: 28px;
    -unity-font-style: bold;
}

.skinned .result-reward {
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
}

/*
 * Pointer hover (desktop and the editor). Unity's default theme fills a hovered or pressed button with
 * flat grey and outranks the rules above, so a grey box showed behind the rounded button art and
 * turned the quiet buttons and pills into slabs. Themed controls keep their own background; a hover
 * lifts the art a touch instead, and a press still sinks it (Hulla.uss).
 */
.skinned .unity-button:hover:enabled,
.skinned .unity-button:active:enabled,
.skinned .unity-button:focus:enabled,
.skinned .unity-button:checked:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.skinned .button:hover:enabled, .skinned .chip:hover:enabled {
    translate: 0 -2px;
}

.skinned .button--quiet:hover:enabled {
    color: var(--ink-ivory);
}

/* ======================================================================================
 * The control kit (UI polish pass), under the rooftop look:
 * - one glossy primary action per screen (.button--primary);
 * - every other button is a see-through "ghost" with an accent outline;
 * - filter and choice chips are dark pills, the chosen one takes the primary art;
 * - small row actions read at full contrast; destructive ones are red text;
 * - fields, checkboxes, sliders and scroll bars are themed instead of Unity's defaults.
 * ====================================================================================== */

.skinned .button, .skinned .button--secondary, .skinned .chip--share {
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    padding-bottom: 0;
    color: #FFFFFF;
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.skinned .button--small {
    font-size: var(--font-small);
    padding: 0 28px;
}

.skinned .chip {
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 0 28px;
    font-size: var(--font-small);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.82);
}

.skinned .button--primary {
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    padding-bottom: 8px;
    color: #FFFFFF;
}

.skinned .chip--on {
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding-bottom: 0;
}

.skinned .button--danger {
    color: #FF8A80;
}

/* The dark text slabs on Profile and Friends become themed fields. */
.skinned .field .unity-base-text-field__input, .skinned .field TextInput {
    background-color: rgba(0, 0, 0, 0.32);
    border-width: 2px;
    border-radius: 20px;
    padding: 0 24px;
    color: #FFFFFF;
}

.skinned .field > Label {
    color: rgba(255, 255, 255, 0.72);
}

/* Checkboxes: a rounded box in the accent, filled when on. */
.skinned .unity-toggle__checkmark {
    width: 64px;
    height: 64px;
    border-width: 3px;
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0.3);
    -unity-background-image-tint-color: #141518;
}

.skinned .unity-toggle:checked .unity-toggle__checkmark {
    background-color: #FFE79A;
}

.skinned .unity-toggle > .unity-label, .skinned .unity-base-slider > .unity-label {
    color: #FFFFFF;
    font-size: var(--font-body);
}

/* Sliders: a soft track and a round handle in the accent. */
.skinned .unity-base-slider__tracker {
    height: 14px;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.18);
}

.skinned .unity-base-slider__dragger {
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: 26px;
    border-width: 0;
}

.skinned .unity-base-slider__dragger-border {
    display: none;
}

/* Lists scroll by touch; the desktop scroll bar looked like a stray white rail. */
.skinned .unity-scroller--vertical, .skinned .unity-scroller--horizontal {
    display: none;
}

/* Themes without painted card pieces: the plain felt, round medallions and a big Play now. */
.skinned .home .game__art {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.skinned .home .medal {
    background-image: none;
    background-color: var(--surface-raised);
    border-width: 3px;
    border-color: var(--accent-saffron);
    color: var(--ink-ivory);
    font-size: 50px;
}

.skinned .home .medal.chip--on {
    background-color: var(--accent-saffron);
    color: #141518;
}

.skinned .home .game__play {
    width: 620px;
    font-size: 60px;
}
