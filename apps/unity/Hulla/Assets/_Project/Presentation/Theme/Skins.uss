}

.skin--club .button--quiet {
    background-image: none;
}

.skin--club .table__pill, .skin--club .quick-strip__chip, .skin--club .quick-strip__more, .skin--club .table__chat {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/pill.png");
