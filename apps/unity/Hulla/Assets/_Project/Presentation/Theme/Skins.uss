.skin--haveli .title, .skin--haveli .code, .skin--haveli .home__title, .skin--haveli .seat__initial, .skin--haveli .card__rank, .skin--haveli .card__court, .skin--haveli .podium__rank, .skin--haveli .turn, .skin--haveli .hero, .skin--haveli .button--primary, .skin--haveli .countdown, .skin--haveli .results__title, .skin--haveli .results__stamp, .skin--haveli .coach__text, .skin--haveli .daily__text, .skin--haveli .toast, .skin--haveli .game__name {
