.skin--basant .caption, .skin--basant .subtitle, .skin--basant .lobby-rules__text, .skin--basant .button--quiet, .skin--basant .home__links > .button, .skin--basant .status, .skin--basant .podium__name, .skin--basant .podium__rank {
