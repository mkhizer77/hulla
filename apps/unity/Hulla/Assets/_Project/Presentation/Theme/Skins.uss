.skin--haveli .title, .skin--haveli .code, .skin--haveli .home__title, .skin--haveli .seat__initial, .skin--haveli .card__rank, .skin--haveli .card__court, .skin--haveli .podium__rank, .skin--haveli .turn, .skin--haveli .hero, .skin--haveli .button--primary, .skin--haveli .countdown, .skin--haveli .results__title, .skin--haveli .results__stamp, .skin--haveli .coach__text, .skin--haveli .daily__text, .skin--haveli .toast, .skin--haveli .game__name {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/RozhaOne.ttf");
}

.skin--haveli .title, .skin--haveli .home__title, .skin--haveli .code, .skin--haveli .results__title {
    color: #F6DC96;
    text-shadow: 0 4px 0 #2E170A;
}

.skin--haveli .button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/btn-secondary.png");
    color: #F7E6C4;
}

.skin--haveli .button--secondary, .skin--haveli .chip, .skin--haveli .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/btn-secondary.png");
    color: #F7E6C4;
}

.skin--haveli .button--primary, .skin--haveli .chip--on, .skin--haveli .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/btn-primary.png");
    color: #2E170A;
    text-shadow: 0 1px 0 rgba(255, 240, 200, 0.5);
}

.skin--haveli .button--quiet {
    background-image: none;
    color: #C9B08A;
}

.skin--haveli .panel {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/panel.png");
}

.skin--haveli .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/plate.png");
    color: #F7E6C4;
}

.skin--haveli .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/frame.png");
}

.skin--haveli .seat__avatar {
    border-radius: 999px;
}

.skin--haveli .game {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/panel.png");
    background-color: rgba(0, 0, 0, 0);
}

.skin--haveli .game__art, .skin--haveli .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/table.png");
}

.skin--haveli .game__name {
    color: #F6DC96;
    text-shadow: 0 4px 0 #2E170A;
}

.skin--haveli .seat__back, .skin--haveli .discard__card, .skin--haveli .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/back.png");
}

.skin--haveli .table__info, .skin--haveli .table__pill, .skin--haveli .quick-strip__chip, .skin--haveli .quick-strip__more, .skin--haveli .table__chat, .skin--haveli .me-badge {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/pill.png");
    color: #F7E6C4;
}

.skin--haveli .card--legal {
    border-color: #F2C76B;
}

.skin--haveli .nav {
    background-color: #1A0D07;
    border-top-color: #F2C76B;
}

.skin--haveli .nav__tab--on .nav__glyph, .skin--haveli .nav__tab--on .nav__label {
    color: #F6DC96;
}

.skin--haveli .toast {
    color: #FFE4A8;
    background-image: none;
    padding: 0;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #5A0E1C;
    text-shadow: 0 8px 0 #1A0805;
}

/* ---- Rooftop ---- */

.skin--dhaba {
    --surface-ui: #141A4A;
    --surface-panel: #161E52;
    --surface-raised: #1E2A6E;
    --accent-saffron: #FFD23F;
    --accent-teal: #2EE6A0;
    --ink-ivory: #FFFFFF;
    --ink-muted: #B9C0F0;
    --gold: #FFD23F;
    color: #FFFFFF;
}

.skin--dhaba .screen {
    background-color: #141A4A;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/menu.png");
}

/* The table keeps the backdrop with its floor; menus take the one without. */
.skin--dhaba .table {
    background-color: #141A4A;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/backdrop.png");
}

.skin--dhaba .table__zone > .rail {
