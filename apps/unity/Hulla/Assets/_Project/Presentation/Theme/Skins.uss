}

.skin--mehndi .nav {
    background-color: #300520;
    border-top-color: #FFC233;
}

.skin--mehndi .nav__tab--on .nav__glyph, .skin--mehndi .nav__tab--on .nav__label {
    color: #FFC233;
}

.skin--mehndi .toast {
    color: #FFE082;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/stamp-oval.png");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    padding: 60px 120px 70px 120px;
    -unity-text-outline-width: 0;
    text-shadow: 0 5px 0 #4A0A30;
}

/* ---- Chai Adda ---- */

.skin--adda {
    --surface-ui: #2A1608;
    --surface-panel: #1E0E04;
    --surface-raised: #2A1608;
    --accent-saffron: #FFB547;
    --accent-teal: #3FB8AD;
    --ink-ivory: #FFF4E2;
    --ink-muted: #D9B98E;
    --gold: #FFB547;
    color: #FFF4E2;
}

.skin--adda .screen {
    background-color: #2A1608;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/menu.png");
}

/* The table keeps the backdrop with its floor; menus take the one without. */
.skin--adda .table {
    background-color: #2A1608;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/backdrop.png");
}

.skin--adda .table__zone > .rail {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/table.png");
}

.skin--adda .title, .skin--adda .code, .skin--adda .home__title, .skin--adda .seat__initial, .skin--adda .card__rank, .skin--adda .card__court, .skin--adda .podium__rank, .skin--adda .turn, .skin--adda .hero, .skin--adda .button--primary, .skin--adda .countdown, .skin--adda .results__title, .skin--adda .results__stamp, .skin--adda .coach__text, .skin--adda .daily__text, .skin--adda .toast, .skin--adda .game__name {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
}

.skin--adda .title, .skin--adda .home__title, .skin--adda .code, .skin--adda .results__title {
    color: #FFE0A0;
    text-shadow: 0 4px 0 #3A1E0A;
}

.skin--adda .button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-secondary.png");
    color: #FFFFFF;
}

.skin--adda .button--secondary, .skin--adda .chip, .skin--adda .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-secondary.png");
    color: #FFFFFF;
}

.skin--adda .button--primary, .skin--adda .chip--on, .skin--adda .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/btn-primary.png");
    color: #3A1E0A;
    text-shadow: 0 1px 0 rgba(255, 245, 210, 0.5);
}

.skin--adda .button--quiet {
    background-image: none;
    color: #D9B98E;
}

.skin--adda .panel {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/panel.png");
}

.skin--adda .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/plate.png");
    color: #3A1E0A;
}

.skin--adda .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/frame.png");
}

.skin--adda .seat__avatar {
    border-radius: 999px;
}

.skin--adda .game {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/panel.png");
    background-color: rgba(0, 0, 0, 0);
}

.skin--adda .game__art, .skin--adda .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/table.png");
}

.skin--adda .game__name {
    color: #FFE0A0;
    text-shadow: 0 4px 0 #3A1E0A;
}

.skin--adda .seat__back, .skin--adda .discard__card, .skin--adda .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/back.png");
}

.skin--adda .table__info, .skin--adda .table__pill, .skin--adda .quick-strip__chip, .skin--adda .quick-strip__more, .skin--adda .table__chat, .skin--adda .me-badge {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/pill.png");
    color: #FFF4E2;
}

.skin--adda .card--legal {
    border-color: #FFB547;
}

.skin--adda .nav {
    background-color: #1E0E04;
    border-top-color: #FFB547;
}

.skin--adda .nav__tab--on .nav__glyph, .skin--adda .nav__tab--on .nav__label {
    color: #FFB547;
}

.skin--adda .toast {
    color: #FFE0A0;
    background-image: none;
    padding: 0;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #A8380E;
    text-shadow: 0 8px 0 #1A0805;
}

/* Rozha One is a display serif: titles only; buttons stay in a bold sans so they read at a glance. */
.skin--haveli .button--primary {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
}

/*
 * Pointer hover (desktop and the editor). Unity's default theme fills a hovered or pressed button with
 * flat grey and outranks the rules above, so a grey box showed behind the rounded button art and
 * turned the quiet buttons and pills into slabs. Themed controls keep their own background; a hover
 * lifts the art a touch instead, and a press still sinks it (Hulla.uss).
 */
.skinned .unity-button:hover:enabled,
.skinned .unity-button:active:enabled,
.skinned .unity-button:focus:enabled,
.skinned .unity-button:checked:enabled {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.skinned .button:hover:enabled, .skinned .chip:hover:enabled {
    translate: 0 -2px;
}

.skinned .button--quiet:hover:enabled {
    color: var(--ink-ivory);
}

/* The theme tiles keep their frame under the pointer; the chosen one stays gold. */
.skinned .theme-tile:hover:enabled {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
}

.skinned .theme-tile--on:hover:enabled {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--accent-saffron);
}


/* ======================================================================================
 * The control kit (UI polish pass). One look across the five themes:
 * - one glossy primary action per screen (.button--primary);
 * - every other button is a see-through "ghost" with the theme's accent outline;
 * - filter and choice chips are dark pills, the chosen one takes the primary art;
 * - small row actions read at full contrast; destructive ones are red text;
 * - fields, checkboxes, sliders and scroll bars are themed instead of Unity's defaults.
 * ====================================================================================== */

.skinned .button, .skinned .button--secondary, .skinned .chip--share {
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    padding-bottom: 0;
    color: #FFFFFF;
    font-size: var(--font-body);
    -unity-font-style: bold;
}

.skinned .button--small {
    font-size: var(--font-small);
    padding: 0 28px;
}

.skinned .chip {
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 0 28px;
    font-size: var(--font-small);
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.82);
}

.skinned .button--primary {
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    padding-bottom: 8px;
    color: #FFFFFF;
}

.skinned .chip--on {
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding-bottom: 0;
}

.skinned .button--danger {
    color: #FF8A80;
}

.skin--club .button, .skin--club .button--secondary, .skin--club .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/btn-ghost.png");
    color: #FFFFFF;
}

.skin--club .chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/btn-ghost.png");
}

.skin--club .button--primary, .skin--club .chip--on, .skin--club .turn--mine {
