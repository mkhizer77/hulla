.skin--dhaba .title, .skin--dhaba .code, .skin--dhaba .home__title, .skin--dhaba .seat__initial, .skin--dhaba .card__rank, .skin--dhaba .card__court, .skin--dhaba .podium__rank, .skin--dhaba .turn, .skin--dhaba .hero, .skin--dhaba .button--primary, .skin--dhaba .countdown, .skin--dhaba .results__title, .skin--dhaba .results__stamp, .skin--dhaba .coach__text, .skin--dhaba .daily__text, .skin--dhaba .toast, .skin--dhaba .game__name {
