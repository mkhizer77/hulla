/*
 * The five table themes (docs/design/table-themes.md). Each hangs off a class on the shell root
 * (ThemeClasses: skin--club and so on) and restyles the shared screens: the scene behind every
 * screen, the table, buttons, panels, name plates, seat frames, card backs, the thulla stamp and
 * the display face. Art comes from tools/artkit/skins.py; the ambient motion from AmbientLayer.
 * Kept after Hulla.uss in the runtime theme so these rules win.
 */

/* ---- Shared by every theme ---- */

.skinned .ambient__glow { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/glow.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__mote { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/mote.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__bulb { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/bulb.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__lamp { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/lamp.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__marigolds { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/marigolds.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__petal { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/petal.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__steam { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/steam.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__cone { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/cone.png"); -unity-background-scale-mode: stretch-to-fill; }
.skinned .ambient__glass { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/glass.png"); -unity-background-scale-mode: stretch-to-fill; }

/* The scene fills the screen; the old lattice ground steps aside. */
.skinned .screen, .skinned .table {
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-and-crop;
}

/* The table is one picture: rail, felt and watermark; the felt element is the play area inside it. */
.skinned .table__zone > .rail {
    padding: 9% 9% 12% 9%;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .table__zone > .rail > .felt {
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

/* Seats: the theme's frame over the face, a fan of card backs with the count beside it. */
.skinned .seat__avatar {
    border-width: 0;
    overflow: visible;
}

.skinned .seat__frame {
    position: absolute;
    left: -17px;
    top: -17px;
    width: 150px;
    height: 150px;
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .me-badge .seat__frame {
    left: -14px;
    top: -14px;
    width: 112px;
    height: 112px;
}

.skinned .seat__chip {
    right: -74px;
    bottom: 6px;
    width: 70px;
    height: 64px;
    padding: 0;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.skinned .seat--east .seat__chip {
    right: auto;
    left: -74px;
}

.skinned .seat__back {
    position: absolute;
    bottom: 8px;
    width: 34px;
    height: 48px;
    margin: 0;
    border-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: 50% 100%;
}

.skinned .seat__back--1 { left: 2px; rotate: -18deg; }
.skinned .seat__back--2 { left: 14px; rotate: -2deg; }
.skinned .seat__back--3 { left: 26px; rotate: 14deg; }

.skinned .seat__count {
    position: absolute;
    right: -6px;
    bottom: -4px;
    min-width: 34px;
    height: 34px;
    border-radius: 17px;
    font-size: 22px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: var(--gold);
    color: #141518;
}

.skinned .seat__name {
    margin-top: 12px;
    padding: 4px 22px 8px 22px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    -unity-slice-top: 26;
    -unity-slice-bottom: 28;
    -unity-slice-scale: 1px;
}

.skinned .table__info, .skinned .table__pill {
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 1px;
}

.skinned .table__info {
    flex-grow: 0;
    align-self: center;
    padding: 10px 28px;
}

.skinned .button, .skinned .chip {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
    padding-bottom: 8px;
}

.skinned .button--quiet {
    background-image: none;
}

.skinned .turn--mine {
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 44;
    -unity-slice-bottom: 54;
    -unity-slice-scale: 1px;
    -unity-background-scale-mode: stretch-to-fill;
}

.skinned .panel {
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 1px;
}

.skinned .nav {
    background-image: none;
}

/* The top bar floats over the scene. */
.skinned .table__top {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

/* Small controls take the pill art; the button art's corners are too big for them. */
.skinned .quick-strip__chip, .skinned .quick-strip__more, .skinned .table__chat, .skinned .table__pill, .skinned .me-badge {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 1px;
    -unity-background-scale-mode: stretch-to-fill;
    padding-bottom: 0;
}

.skinned .chip {
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 36;
    -unity-slice-bottom: 46;
}

.skinned .me-badge .seat__name {
    background-image: none;
    color: var(--ink-ivory);
}

.skinned .seat--turn.me-badge .seat__name {
    color: var(--gold);
}

.skinned .game {
    border-radius: 0;
    -unity-slice-left: 72;
    -unity-slice-right: 72;
    -unity-slice-top: 72;
    -unity-slice-bottom: 72;
    -unity-slice-scale: 1px;
}

.skinned .home__title, .skinned #tagline {
    display: none;
}

/* Quiet text sits on busy scenes; a soft shadow keeps it readable. */
.skinned .caption, .skinned .subtitle, .skinned .lobby-rules__text, .skinned .button--quiet, .skinned .home__links > .button, .skinned .status, .skinned .podium__name, .skinned .podium__rank {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

/* The results panel fits what it holds instead of filling the screen. */
.skinned .results__panel {
    flex-grow: 0;
}

.skinned .results__scroll {
    flex-grow: 0;
    flex-shrink: 1;
    max-height: 1180px;
}

.skinned .results .chips > .chip {
    min-height: 104px;
    font-size: 28px;
    -unity-font-style: bold;
}

.skinned .result-reward {
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5);
}

/* The theme picker in settings. */
.skinned .theme-picker {
    flex-direction: row;
    justify-content: space-between;
    margin: 8px 0 24px 0;
}

.skinned .theme-tile {
    width: 19%;
    margin: 0;
    padding: 10px 6px 14px 6px;
    align-items: center;
    background-image: none;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 22px;
}

.skinned .theme-tile--on {
    border-color: var(--accent-saffron);
    background-color: rgba(255, 255, 255, 0.1);
}

.skinned .theme-tile__preview {
    width: 100%;
    height: 230px;
    border-radius: 14px;
    -unity-background-scale-mode: scale-and-crop;
}

.skinned .theme-tile__name {
    margin-top: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.theme-tile__preview--club { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/preview.png"); }
.theme-tile__preview--haveli { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/preview.png"); }
.theme-tile__preview--dhaba { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/preview.png"); }
.theme-tile__preview--mehndi { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/mehndi/preview.png"); }
.theme-tile__preview--adda { background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/adda/preview.png"); }

/* ---- Club Classic ---- */

.skin--club {
    --surface-ui: #0A0F26;
    --surface-panel: #121A3E;
    --surface-raised: #1A2350;
    --accent-saffron: #F2C14E;
    --accent-teal: #4C8DFF;
    --ink-ivory: #FFFFFF;
    --ink-muted: #A9B7E0;
    --gold: #FFE79A;
    color: #FFFFFF;
}

.skin--club .screen {
    background-color: #0A0F26;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/menu.png");
}

/* The table keeps the backdrop with its floor; menus take the one without. */
.skin--club .table {
    background-color: #0A0F26;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/backdrop.png");
}

.skin--club .table__zone > .rail {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/table.png");
}

.skin--club .title, .skin--club .code, .skin--club .home__title, .skin--club .seat__initial, .skin--club .card__rank, .skin--club .card__court, .skin--club .podium__rank, .skin--club .turn, .skin--club .hero, .skin--club .button--primary, .skin--club .countdown, .skin--club .results__title, .skin--club .results__stamp, .skin--club .coach__text, .skin--club .daily__text, .skin--club .toast, .skin--club .game__name {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/TitanOne.ttf");
}

.skin--club .title, .skin--club .home__title, .skin--club .code, .skin--club .results__title {
    color: #FFE79A;
    text-shadow: 0 4px 0 #12347A;
}

.skin--club .button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/btn-secondary.png");
    color: #FFFFFF;
}

.skin--club .button--secondary, .skin--club .chip, .skin--club .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/btn-secondary.png");
    color: #FFFFFF;
}

.skin--club .button--primary, .skin--club .chip--on, .skin--club .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/btn-primary.png");
    color: #FFFFFF;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
}

.skin--club .button--quiet {
    background-image: none;
    color: #A9B7E0;
}

.skin--club .panel {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/panel.png");
}

.skin--club .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/plate.png");
    color: #FFFFFF;
}

.skin--club .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/frame.png");
}

.skin--club .seat__avatar {
    border-radius: 999px;
}

.skin--club .game {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/panel.png");
    background-color: rgba(0, 0, 0, 0);
}

.skin--club .game__art, .skin--club .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/table.png");
}

.skin--club .game__name {
    color: #FFE79A;
    text-shadow: 0 4px 0 #12347A;
}

.skin--club .seat__back, .skin--club .discard__card, .skin--club .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/back.png");
}

.skin--club .table__info, .skin--club .table__pill, .skin--club .quick-strip__chip, .skin--club .quick-strip__more, .skin--club .table__chat, .skin--club .me-badge {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/club/pill.png");
    color: #FFFFFF;
}

.skin--club .card--legal {
    border-color: #5BE37A;
}

.skin--club .nav {
    background-color: #070B1E;
    border-top-color: #F2C14E;
}

.skin--club .nav__tab--on .nav__glyph, .skin--club .nav__tab--on .nav__label {
    color: #FFE79A;
}

.skin--club .toast {
    color: #FFF3C4;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/shared/stamp-ribbon.png");
    -unity-slice-left: 70;
    -unity-slice-right: 70;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    padding: 6px 110px 24px 110px;
    -unity-text-outline-width: 0;
    text-shadow: 0 5px 0 #7A0E14;
}

/* ---- Haveli Evening ---- */

.skin--haveli {
    --surface-ui: #1A0A05;
    --surface-panel: #24130A;
    --surface-raised: #45260F;
    --accent-saffron: #F2C76B;
    --accent-teal: #9FD9B5;
    --ink-ivory: #F7E6C4;
    --ink-muted: #C9B08A;
    --gold: #F6DC96;
    color: #F7E6C4;
}

.skin--haveli .screen {
    background-color: #1A0A05;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/menu.png");
}

/* The table keeps the backdrop with its floor; menus take the one without. */
.skin--haveli .table {
