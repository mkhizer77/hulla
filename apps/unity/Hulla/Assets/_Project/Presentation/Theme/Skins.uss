    text-shadow: 4px 4px 0 #111111;
}

.skin--dhaba .button {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/btn-secondary.png");
    color: #111111;
}

.skin--dhaba .button--secondary, .skin--dhaba .chip, .skin--dhaba .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/btn-secondary.png");
    color: #111111;
}

.skin--dhaba .button--primary, .skin--dhaba .chip--on, .skin--dhaba .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/btn-primary.png");
    color: #111111;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--dhaba .button--quiet {
    background-image: none;
    color: #B9C0F0;
}

.skin--dhaba .panel {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/panel.png");
}

.skin--dhaba .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/plate.png");
    color: #111111;
}

.skin--dhaba .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/frame.png");
}

.skin--dhaba .seat__avatar {
    border-radius: 34px;
}

.skin--dhaba .game {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/panel.png");
    background-color: rgba(0, 0, 0, 0);
}

.skin--dhaba .game__art, .skin--dhaba .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/table.png");
}

.skin--dhaba .game__name {
    color: #FFD23F;
    text-shadow: 4px 4px 0 #111111;
}

.skin--dhaba .seat__back, .skin--dhaba .discard__card, .skin--dhaba .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/dhaba/back.png");
}

.skin--dhaba .table__info, .skin--dhaba .table__pill, .skin--dhaba .quick-strip__chip, .skin--dhaba .quick-strip__more, .skin--dhaba .table__chat, .skin--dhaba .me-badge {
