/* The dark text slabs on Profile and Friends become themed fields. */
.skinned .field .unity-base-text-field__input, .skinned .field TextInput {
    background-color: rgba(0, 0, 0, 0.32);
    border-width: 2px;
    border-radius: 20px;
    padding: 0 24px;
    color: #FFFFFF;
}

.skinned .field > Label {
    color: rgba(255, 255, 255, 0.72);
}

/* Checkboxes: a rounded box in the accent, filled when on. */
.skinned .unity-toggle__checkmark {
    width: 64px;
    height: 64px;
    border-width: 3px;
    border-radius: 16px;
    background-color: rgba(0, 0, 0, 0.3);
    -unity-background-image-tint-color: #141518;
}

.skinned .unity-toggle:checked .unity-toggle__checkmark {
    background-color: #FFE79A;
}

.skinned .unity-toggle > .unity-label, .skinned .unity-base-slider > .unity-label {
    color: #FFFFFF;
    font-size: var(--font-body);
}

/* Sliders: a soft track and a round handle in the accent. */
.skinned .unity-base-slider__tracker {
    height: 14px;
    margin-top: -7px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.18);
}

.skinned .unity-base-slider__dragger {
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border-radius: 26px;
    border-width: 0;
}

.skinned .unity-base-slider__dragger-border {
    display: none;
}

/* Lists scroll by touch; the desktop scroll bar looked like a stray white rail. */
.skinned .unity-scroller--vertical, .skinned .unity-scroller--horizontal {
    display: none;
}

/* ======================================================================================
 * Basant and Pop: the two looks in the playtest (art-design/concepts, concepts 2 and 4).
 * Basant is the only light scene, so its ink is dark brown everywhere; Pop keeps white ink
 * on its gradient and turns it dark inside its white cards.
 * ====================================================================================== */

/* ---- Basant ---- */

.skin--basant {
    --surface-ui: #86D5F8;
    --surface-panel: #FFF3DA;
    --surface-raised: #FCE6BE;
    --accent-saffron: #FF8A1F;
    --accent-teal: #17A39D;
    --ink-ivory: #4A2511;
    --ink-muted: #85593A;
    --gold: #FF8A1F;
    --felt: #2BA36B;
    color: #4A2511;
}

.skin--basant .screen {
    background-color: #86D5F8;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/basant/menu.png");
}

.skin--basant .table {
    background-color: #E8A06E;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/basant/backdrop.png");
}

.skin--basant .table__zone > .rail, .skin--basant .game__art, .skin--basant .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/basant/table.png");
}

.skin--basant .title, .skin--basant .code, .skin--basant .home__title, .skin--basant .seat__initial, .skin--basant .card__rank, .skin--basant .card__court, .skin--basant .podium__rank, .skin--basant .turn, .skin--basant .hero, .skin--basant .button--primary, .skin--basant .button--secondary, .skin--basant .countdown, .skin--basant .results__title, .skin--basant .results__stamp, .skin--basant .coach__text, .skin--basant .daily__text, .skin--basant .toast, .skin--basant .game__name {
