    color: #F7E6C4;
}

.skin--haveli .chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/btn-ghost.png");
}

.skin--haveli .button--primary, .skin--haveli .chip--on, .skin--haveli .turn--mine {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/btn-primary.png");
}

.skin--haveli .chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/haveli/chip-on.png");
    color: #2E170A;
}

.skin--haveli .button--quiet {
    background-image: none;
