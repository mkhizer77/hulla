/* ---- Pop ---- */

.skin--pop {
    --surface-ui: #3B1F7A;
    --surface-panel: #FFFFFF;
    --surface-raised: #4A2E92;
    --accent-saffron: #FFB35C;
    --accent-teal: #6A50E0;
    --ink-ivory: #FFFFFF;
    --ink-muted: #E3D9FF;
    --gold: #FFC24A;
    --felt: #3E2CA0;
    color: #FFFFFF;
}

.skin--pop .screen {
    background-color: #3B1F7A;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/menu.png");
}

.skin--pop .table {
    background-color: #3B1F7A;
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/backdrop.png");
}

.skin--pop .table__zone > .rail, .skin--pop .game__art, .skin--pop .lobby-table {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/table.png");
}

.skin--pop .title, .skin--pop .code, .skin--pop .home__title, .skin--pop .seat__initial, .skin--pop .podium__rank, .skin--pop .turn, .skin--pop .hero, .skin--pop .button--primary, .skin--pop .countdown, .skin--pop .results__title, .skin--pop .results__stamp, .skin--pop .coach__text, .skin--pop .daily__text, .skin--pop .toast, .skin--pop .game__name {
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/Baloo2.ttf");
    -unity-font-style: normal;
}

.skin--pop .title, .skin--pop .home__title, .skin--pop .code, .skin--pop .results__title {
    color: #FFFFFF;
    text-shadow: 0 4px 10px rgba(30, 10, 70, 0.45);
}

.skin--pop .caption, .skin--pop .subtitle, .skin--pop .lobby-rules__text, .skin--pop .button--quiet, .skin--pop .home__links > .button, .skin--pop .status, .skin--pop .podium__name, .skin--pop .podium__rank {
    text-shadow: 0 1px 3px rgba(30, 10, 70, 0.5);
}

/* White cards carry dark ink; everything inside them follows. */
.skin--pop .panel, .skin--pop .game, .skin--pop .lobby-seat, .skin--pop .settings__row, .skin--pop .leaderboard__row {
    --ink-ivory: #241B4A;
    --ink-muted: #6E6790;
    --accent-saffron: #E8590C;
    color: #241B4A;
}

.skin--pop .panel .title, .skin--pop .panel .results__title, .skin--pop .panel .code, .skin--pop .dialog__text {
    color: #241B4A;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--pop .panel, .skin--pop .game {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/panel.png");
    background-color: rgba(0, 0, 0, 0);
}

.skin--pop .panel .caption, .skin--pop .panel .subtitle, .skin--pop .panel .status, .skin--pop .game .caption, .skin--pop .panel .button--quiet, .skin--pop .settings__row .caption {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--pop .game__name {
    color: #241B4A;
}

.skin--pop .lobby-seat, .skin--pop .settings__row, .skin--pop .leaderboard__row {
    background-color: rgba(255, 255, 255, 0.94);
    border-color: rgba(255, 255, 255, 0);
    border-radius: 28px;
}

.skin--pop .button, .skin--pop .button--secondary, .skin--pop .chip--share {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/btn-ghost.png");
    color: #FFFFFF;
}

.skin--pop .panel .button, .skin--pop .game .button, .skin--pop .settings__row .button, .skin--pop .chip {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/chip.png");
    color: #241B4A;
}

.skin--pop .button--primary, .skin--pop .turn--mine, .skin--pop .panel .button--primary, .skin--pop .game .button--primary {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/btn-primary.png");
    color: #FFFFFF;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.skin--pop .chip--on, .skin--pop .panel .chip--on, .skin--pop .game .chip--on {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/chip-on.png");
    color: #FFFFFF;
}

.skin--pop .button--quiet, .skin--pop .panel .button--quiet, .skin--pop .game .button--quiet {
    background-image: none;
}

.skin--pop .panel .button--danger, .skin--pop .settings__row .button--danger {
    color: #D32F2F;
}

.skin--pop .seat__name {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/plate.png");
    color: #241B4A;
}

.skin--pop .seat__frame {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/frame.png");
}

.skin--pop .seat__avatar {
    border-radius: 999px;
}

.skin--pop .seat__back, .skin--pop .discard__card, .skin--pop .game__back {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/back.png");
}

.skin--pop .table__info, .skin--pop .table__pill, .skin--pop .quick-strip__chip, .skin--pop .quick-strip__more, .skin--pop .table__chat, .skin--pop .me-badge {
    background-image: url("/Assets/_Project/Presentation/Theme/Art/Skins/pop/pill.png");
    color: #FFFFFF;
}

.skin--pop .card--legal {
    border-color: #FF6F61;
}

.skin--pop .meter {
    background-color: rgba(36, 27, 74, 0.14);
}

.skin--pop .nav {
    background-color: #FFFFFF;
    border-top-color: rgba(255, 255, 255, 0);
}

.skin--pop .nav__glyph, .skin--pop .nav__label {
    color: #8E8AA6;
}

.skin--pop .nav__tab--on .nav__glyph, .skin--pop .nav__tab--on .nav__label {
    color: #3B2AA8;
}

.skin--pop .toast {
    color: #FFFFFF;
    background-image: none;
    padding: 0;
    text-shadow: 0 6px 0 #3B2AA8;
}

.skin--pop .unity-toggle__checkmark {
    border-color: #FFFFFF;
}

.skin--pop .settings__row .unity-toggle__checkmark, .skin--pop .panel .unity-toggle__checkmark {
    border-color: #6A50E0;
    background-color: #F1EEFB;
}

.skin--pop .unity-toggle:checked .unity-toggle__checkmark {
    background-color: #6A50E0;
}

.skin--pop .unity-toggle > .unity-label, .skin--pop .unity-base-slider > .unity-label, .skin--pop .field > Label {
    color: var(--ink-ivory);
}

.skin--pop .unity-base-slider__dragger {
    background-color: #FF6F61;
}

.skin--pop .settings__row .unity-base-slider__tracker {
    background-color: rgba(36, 27, 74, 0.14);
}

.skin--pop .field .unity-base-text-field__input {
    border-color: rgba(255, 255, 255, 0.7);
}

.skin--pop .panel .field .unity-base-text-field__input, .skin--pop .panel .field TextInput {
    border-color: #C9BDF5;
    background-color: #F5F3FC;
    color: #241B4A;
}

/* The look playtest: the Home card and the question after a round. */
.looks {
    margin-top: 24px;
    padding: 28px 28px 20px 28px;
}

.looks__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--ink-ivory);
}

.looks__row {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

.skinned .looks__tile {
    width: 40%;
    margin: 0 2%;
}

.skinned .looks__tile .theme-tile__name {
    font-size: 32px;
}

.look-sheet__chips {
    flex-wrap: wrap;
    justify-content: center;
    margin: 12px 0 8px 0;
}

.look-sheet__chips > .chip {
    margin: 8px;
    min-height: 96px;
}

.look-sheet .field {
    margin: 16px 0 8px 0;
}
