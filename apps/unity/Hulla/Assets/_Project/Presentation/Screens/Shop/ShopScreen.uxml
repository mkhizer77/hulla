<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="shop" class="screen settings">
        <ui:VisualElement class="settings__top">
            <ui:Label name="title" class="title title--small" />
            <ui:Button name="back" class="button button--quiet button--small" />
        </ui:VisualElement>
        <ui:Label name="balances" class="status shop__balances" />
        <ui:ScrollView name="tabs" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="shop__tabs">
            <ui:VisualElement name="categories" class="chips shop__chips" />
        </ui:ScrollView>
        <ui:Label name="status" class="status" />
        <ui:ScrollView class="settings__scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
