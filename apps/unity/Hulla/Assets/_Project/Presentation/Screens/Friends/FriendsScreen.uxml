<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="friends" class="screen settings">
        <ui:VisualElement class="settings__top">
            <ui:Label name="title" class="title title--small" />
            <ui:Button name="back" class="button button--quiet button--small" />
        </ui:VisualElement>
        <ui:VisualElement class="chat-panel__compose">
            <ui:TextField name="code" class="field chat-panel__input" />
            <ui:Button name="add" class="button button--primary button--small" />
        </ui:VisualElement>
        <ui:Label name="status" class="status" />
        <ui:ScrollView class="settings__scroll">
            <ui:VisualElement name="list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
