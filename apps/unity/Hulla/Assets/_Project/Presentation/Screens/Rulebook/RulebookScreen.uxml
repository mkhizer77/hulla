<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="rulebook" class="screen settings">
        <ui:VisualElement class="settings__top settings__top--start">
            <ui:Label name="title" class="title title--small top__title" />
            <ui:Button name="close" class="top__button top__left">
                <ui:VisualElement class="kit__icon kit__icon--close" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView mode="Horizontal" class="rulebook__contents-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="contents" class="rulebook__contents" />
        </ui:ScrollView>
        <ui:ScrollView name="scroll" class="settings__scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
