<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="phone" class="screen settings">
        <ui:VisualElement class="settings__top">
            <ui:Label name="title" class="title title--small top__title" />
            <ui:Button name="back" class="top__button top__left">
                <ui:VisualElement class="kit__icon kit__icon--back" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:ScrollView class="settings__scroll phone__scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <ui:VisualElement class="phone__plate">
            <ui:Label name="intro" class="caption phone__text" />
            <ui:VisualElement name="number-step">
                <ui:TextField name="number" class="field" />
                <ui:Button name="send" class="button button--primary" />
            </ui:VisualElement>
            <ui:VisualElement name="code-step">
                <ui:Label name="sent" class="caption phone__text" />
                <ui:TextField name="code" class="field" />
                <ui:Button name="verify" class="button button--primary" />
                <ui:Button name="other-number" class="button button--quiet" />
            </ui:VisualElement>
            <ui:VisualElement name="linked-step">
                <ui:Label name="linked" class="phone__text" />
                <ui:Button name="remove" class="button button--secondary" />
            </ui:VisualElement>
            <ui:VisualElement name="offer-step">
                <ui:Label name="offer" class="phone__text" />
                <ui:Button name="switch" class="button button--primary" />
                <ui:Button name="decline" class="button button--quiet" />
            </ui:VisualElement>
            <ui:Label name="status" class="status phone__text" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
