<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="lobby" class="screen">
        <ui:VisualElement class="code-box">
            <ui:Label name="code-label" class="caption" />
            <ui:Label name="code" class="code" />
            <ui:Button name="share" class="button button--small" />
            <ui:Button name="invite" class="button button--small" />
        </ui:VisualElement>
        <ui:VisualElement class="lobby-rules">
            <ui:Label name="rules" class="lobby-rules__text" />
            <ui:Button name="edit-rules" class="button button--quiet button--small" />
        </ui:VisualElement>
        <ui:Label name="rules-changed" class="caption" />
        <ui:ScrollView name="seats-scroll" class="seats">
            <ui:VisualElement name="seats" />
        </ui:ScrollView>
        <ui:VisualElement name="chat" class="lobby-chat">
            <ui:VisualElement name="chat-log" class="chat-log" />
            <ui:VisualElement class="chat-panel__compose">
                <ui:TextField name="chat-input" class="field chat-panel__input" />
                <ui:Button name="chat-send" class="button button--small" />
            </ui:VisualElement>
            <ui:Label name="chat-status" class="caption" />
        </ui:VisualElement>
        <ui:Label name="countdown" class="turn countdown" />
        <ui:Label name="status" class="status" />
        <ui:VisualElement class="actions">
            <ui:Button name="ready" class="button" />
            <ui:Button name="start" class="button button--primary" />
            <ui:Button name="leave" class="button button--quiet" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
