<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="quick-play" class="screen screen--center">
        <ui:Label name="title" class="title title--small" />
        <ui:Label name="elapsed" class="code elapsed" />
        <ui:Label name="status" class="status" />
        <ui:Button name="cancel" class="button button--quiet" />
    </ui:VisualElement>
</ui:UXML>
