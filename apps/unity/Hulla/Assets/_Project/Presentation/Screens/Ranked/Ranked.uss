/* The Ranked screen (GDD 7.5, 12.9); colours come from the theme tokens in Hulla.uss. */
.ranked__card {
    align-items: center;
    margin-bottom: var(--space-2);
}

.ranked__league {
    font-size: 72px;
    color: #601A1A;
    -unity-font-definition: url("/Assets/_Project/Presentation/Theme/Fonts/LilitaOne.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.ranked__rating {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--ink-ivory);
    margin-bottom: var(--space-1);
}

.ranked__bar {
    width: 84%;
    height: 48px;
    border-radius: 24px;
    border-width: 5px;
    border-color: rgb(92, 40, 22);
    background-color: rgb(222, 196, 170);
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
    overflow: hidden;
}

.ranked__fill {
    height: 100%;
    min-width: 30px;
    background-color: rgb(52, 130, 220);
    border-radius: 19px;
}

.ranked__rules {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: var(--space-1);
}

.ranked__play {
    margin-top: var(--space-2);
    min-width: 60%;
}

.ranked__banner {
    display: none;
    background-color: var(--surface-raised);
    color: var(--ink-ivory);
    border-radius: var(--radius);
    padding: var(--space-2);
    margin-bottom: var(--space-2);
    white-space: normal;
}

.ranked__banner--on {
    display: flex;
}

.ranked__step {
    flex-direction: row;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
}

.ranked__step--me {
    background-color: var(--surface-raised);
}

.ranked__step-name {
    flex-shrink: 0;
    color: var(--ink-ivory);
    -unity-font-style: bold;
}

.ranked__step-detail {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--ink-muted);
    white-space: normal;
}
