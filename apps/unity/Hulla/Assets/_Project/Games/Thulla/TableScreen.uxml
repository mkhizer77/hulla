<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="table" class="screen table">
        <ui:VisualElement class="table__top">
            <ui:VisualElement class="table__top-actions">
                <ui:Button name="rules" class="button button--quiet button--small" />
                <ui:Button name="settings" class="button button--quiet button--small" />
                <ui:Button name="leave" class="button button--quiet button--small" />
            </ui:VisualElement>
            <ui:Label name="info" class="table__info" />
        </ui:VisualElement>
        <ui:VisualElement name="opponents" class="opponents" />
        <ui:VisualElement name="felt" class="felt">
            <ui:VisualElement name="pile" class="pile" />
            <ui:Label name="pile-note" class="pile__note" />
            <ui:Label name="toast" class="toast" />
        </ui:VisualElement>
        <ui:VisualElement name="player-sheet" class="coach player-sheet">
            <ui:Label name="sheet-title" class="coach__text" />
            <ui:VisualElement name="sheet-actions" class="chips" />
            <ui:Label name="sheet-status" class="caption" />
        </ui:VisualElement>
        <ui:VisualElement name="coach" class="coach">
            <ui:Label name="coach-text" class="coach__text" />
            <ui:Button name="coach-next" class="button button--primary button--small" />
        </ui:VisualElement>
        <ui:Label name="my-say" class="bubble bubble--mine" />
        <ui:Label name="hint" class="hint" />
        <ui:VisualElement class="table__bar">
            <ui:VisualElement class="table__turn">
                <ui:VisualElement name="timer" class="timer" />
                <ui:Label name="turn" class="turn" />
            </ui:VisualElement>
            <ui:VisualElement class="table__bar-actions">
                <ui:Button name="take-hand" class="button button--primary button--small" />
                <ui:Button name="chat" class="button button--small" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hand" class="hand" />
        <ui:VisualElement name="recap" class="recap">
            <ui:VisualElement class="panel">
                <ui:Label name="recap-title" class="turn" />
                <ui:Label name="recap-text" class="recap__text" />
                <ui:Button name="recap-hide" class="button button--quiet button--small" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="chat-panel" class="chat-panel">
            <ui:VisualElement class="chat-panel__compose">
                <ui:TextField name="chat-input" class="field chat-panel__input" />
                <ui:Button name="chat-send" class="button button--primary button--small" />
            </ui:VisualElement>
            <ui:Label name="chat-status" class="caption" />
            <ui:ScrollView class="chat-panel__scroll">
                <ui:VisualElement name="chat-log" class="chat-log" />
                <ui:VisualElement name="chat-emotes" class="chips" />
                <ui:VisualElement name="chat-phrases" class="chips" />
            </ui:ScrollView>
            <ui:Button name="chat-close" class="button button--quiet" />
        </ui:VisualElement>
        <ui:VisualElement name="results" class="results">
            <ui:VisualElement class="panel results__panel">
                <ui:Label name="result-title" class="title title--small" />
                <ui:Label name="result-reward" class="turn result-reward" />
                <ui:VisualElement name="result-order" class="results__order" />
                <ui:Button name="play-again" class="button button--primary" />
                <ui:Label name="result-status" class="status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
