# LiveKit on the phase 0 box (ADR-0024). setup.sh fills the ${...} values into /opt/hulla/livekit.yaml.
# Signalling (7880) is reached through Caddy as wss://VOICE_HOST; media goes straight to the box.
port: 7880
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: true
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
# TURN for networks that block the media port: UDP 3478, and TLS on 5349 for the strictest ones. The certificate
# is Caddy's for TURN_HOST, read from its data volume; restart LiveKit after Caddy renews it (setup.sh adds a weekly restart).
turn:
  enabled: true
  domain: ${TURN_HOST}
  udp_port: 3478
  tls_port: 5349
  cert_file: /caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/${TURN_HOST}/${TURN_HOST}.crt
  key_file: /caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/${TURN_HOST}/${TURN_HOST}.key
room:
  empty_timeout: 60
  departure_timeout: 20
  max_participants: 12
logging:
  level: info
