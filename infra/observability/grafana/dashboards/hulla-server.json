{
  "title": "Hulla server",
  "uid": "hulla-server",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 15,
      "type": "stat",
      "title": "Availability, 30 days (SLO 99.5%)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "hulla:availability:ratio_30d",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Rounds with a server error, 24 h (SLO under 1%)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(nakama_custom_hulla_messages_dropped[1d])) / clamp_min(sum(increase(nakama_custom_hulla_rounds_started[1d])), 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Move inside the server, p95 (budget 200 ms)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "max(nakama_custom_hulla_move_latency{quantile=\"0.95\"})",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Alerts firing",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Move inside the server (s)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "max by (game) (nakama_custom_hulla_move_latency{quantile=\"0.5\"})",
          "legendFormat": "p50 {{game}}",
          "refId": "A"
        },
        {
          "expr": "max by (game) (nakama_custom_hulla_move_latency{quantile=\"0.95\"})",
          "legendFormat": "p95 {{game}}",
          "refId": "B"
        },
        {
          "expr": "max by (game) (nakama_custom_hulla_move_latency{quantile=\"0.99\"})",
          "legendFormat": "p99 {{game}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Live tables, sessions and healthcheck",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(nakama_authoritative_matches)",
          "legendFormat": "tables",
          "refId": "A"
        },
        {
          "expr": "sum(nakama_sessions)",
          "legendFormat": "sessions",
          "refId": "B"
        },
        {
          "expr": "min(probe_success{job=\"nakama_health\"})",
          "legendFormat": "healthcheck up",
          "refId": "C"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Database connections in use",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "waiting (s per s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "max(nakama_db_in_use_conns / (nakama_db_max_open_conns > 0))",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nakama_db_total_wait_time_nanos[5m])) / 1e9",
          "legendFormat": "waiting (s per s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rounds started per minute",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (game, mode) (rate(nakama_custom_hulla_rounds_started[5m])) * 60",
          "legendFormat": "{{game}} {{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Moves per minute (human and auto)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (auto) (rate(nakama_custom_hulla_moves[5m])) * 60",
          "legendFormat": "auto={{auto}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Timeouts per minute",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(nakama_custom_hulla_timeouts[5m])) * 60",
          "legendFormat": "{{game}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Thullas per minute",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(nakama_custom_hulla_thullas[5m])) * 60",
          "legendFormat": "{{game}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disconnects and reconnects per minute",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (__name__) (rate({__name__=~\"nakama_custom_hulla_disconnects|nakama_custom_hulla_reconnects\"}[5m])) * 60",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Round duration p95 (s)",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max by (game) (nakama_custom_hulla_round_duration{quantile=\"0.95\"})",
          "legendFormat": "{{game}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Messages dropped (errors) per hour",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(nakama_custom_hulla_messages_dropped[1h]))",
          "legendFormat": "{{game}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tables created per hour",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(nakama_custom_hulla_tables_created[1h]))",
          "legendFormat": "{{game}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RPC latency p95 (ms)",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "max(nakama_Rpc_latency_ms{quantile=\"0.95\"})",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Sessions",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(nakama_sessions)",
          "legendFormat": "sessions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Phone codes sent per hour, by country and channel",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (country, channel) (increase(nakama_custom_hulla_otp_sent[1h]))",
          "legendFormat": "{{country}} {{channel}}",
          "refId": "A"
        },
        {
          "expr": "sum by (channel, reason) (increase(nakama_custom_hulla_otp_send_failed[1h]))",
          "legendFormat": "failed {{channel}} {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Phone code spend, estimated US$ per day",
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(nakama_custom_hulla_otp_cost_microusd[1d])) / 1e6",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "expr": "sum by (country) (increase(nakama_custom_hulla_otp_cost_microusd[1d])) / 1e6",
          "legendFormat": "{{country}}",
          "refId": "B"
        },
        {
          "expr": "sum by (channel) (increase(nakama_custom_hulla_otp_cost_microusd[1d])) / 1e6",
          "legendFormat": "{{channel}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Phone codes refused per hour, by reason",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(nakama_custom_hulla_otp_refused[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Phone sign-ins and links per hour",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(nakama_custom_hulla_otp_verified[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    }
  ]
}
